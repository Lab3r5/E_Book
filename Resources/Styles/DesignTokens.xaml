<?xml version="1.0" encoding="UTF-8" ?>
<?xaml-comp compile="true" ?>
<ResourceDictionary
    xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
    xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml">

    <!-- Radius -->
    <x:Double x:Key="RadiusXs">10</x:Double>
    <x:Double x:Key="RadiusSm">14</x:Double>
    <x:Double x:Key="RadiusMd">16</x:Double>
    <x:Double x:Key="RadiusLg">22</x:Double>
    <x:Double x:Key="RadiusXl">28</x:Double>

    <!-- Common spacing -->
    <x:Double x:Key="Space2">2</x:Double>
    <x:Double x:Key="Space4">4</x:Double>
    <x:Double x:Key="Space6">6</x:Double>
    <x:Double x:Key="Space8">8</x:Double>
    <x:Double x:Key="Space10">10</x:Double>
    <x:Double x:Key="Space12">12</x:Double>
    <x:Double x:Key="Space16">16</x:Double>
    <x:Double x:Key="Space18">18</x:Double>
    <x:Double x:Key="Space24">24</x:Double>
    <x:Double x:Key="Space28">28</x:Double>

    <!-- Shadows -->
    <x:Double x:Key="ShadowRadiusSm">12</x:Double>
    <x:Double x:Key="ShadowRadiusMd">16</x:Double>
    <x:Double x:Key="ShadowRadiusLg">20</x:Double>
</ResourceDictionary>