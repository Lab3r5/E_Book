<?xml version="1.0" encoding="utf-8" ?>
<ContentPage
    xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
    xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
    xmlns:shell="http://schemas.microsoft.com/dotnet/2021/maui"
    x:Class="E_Book.Pages.ImageReaderPage"
    shell:Shell.NavBarIsVisible="False"
    shell:Shell.TabBarIsVisible="False"
    BackgroundColor="#E8E1CF"
    Padding="0">

    <Grid x:Name="RootGrid"
          RowDefinitions="Auto,*"
          BackgroundColor="#E8E1CF">

        <!-- Top bar -->
        <Grid x:Name="TopBar"
              Grid.Row="0"
              Padding="14,18,14,10"
              ColumnDefinitions="Auto,*,Auto"
              BackgroundColor="#E8E1CF">

            <Button x:Name="BackButton"
                    Grid.Column="0"
                    Text="←"
                    FontSize="24"
                    WidthRequest="44"
                    HeightRequest="44"
                    BackgroundColor="Transparent"
                    TextColor="#2E241A"
                    Padding="0"
                    Clicked="OnBackClicked"
                    Pressed="OnButtonPressed"
                    Released="OnButtonReleased" />

            <Label x:Name="TitleLabel"
                   Grid.Column="1"
                   Text="Image"
                   FontSize="16"
                   FontAttributes="Bold"
                   VerticalTextAlignment="Center"
                   LineBreakMode="TailTruncation"
                   MaxLines="1"
                   TextColor="#2E241A" />

            <Button x:Name="MoreButton"
                    Grid.Column="2"
                    Text="⋯"
                    FontSize="24"
                    WidthRequest="44"
                    HeightRequest="44"
                    BackgroundColor="Transparent"
                    TextColor="#2E241A"
                    Padding="0"
                    Clicked="OnMoreClicked"
                    Pressed="OnButtonPressed"
                    Released="OnButtonReleased" />
        </Grid>

        <!-- Image content -->
        <Grid x:Name="ImageHost"
              Grid.Row="1"
              BackgroundColor="#E8E1CF"
              Padding="10">

            <Grid x:Name="Viewport"
                  BackgroundColor="Transparent">

                <Grid.GestureRecognizers>
                    <TapGestureRecognizer Tapped="OnViewportTapped" />
                </Grid.GestureRecognizers>

                <Grid x:Name="ImageTransformHost"
                      BackgroundColor="Transparent"
                      HorizontalOptions="Fill"
                      VerticalOptions="Fill">

                    <Grid.GestureRecognizers>
                        <TapGestureRecognizer NumberOfTapsRequired="2"
                                              Tapped="OnImageDoubleTapped" />
                        <PanGestureRecognizer PanUpdated="OnImagePanUpdated" />
                        <PinchGestureRecognizer PinchUpdated="OnImagePinchUpdated" />
                    </Grid.GestureRecognizers>

                    <Image x:Name="ReaderImage"
                           Aspect="AspectFit"
                           HorizontalOptions="Fill"
                           VerticalOptions="Fill"
                           BackgroundColor="Transparent" />
                </Grid>
            </Grid>

            <!-- Loading -->
            <Grid x:Name="LoadingOverlay"
                  IsVisible="False"
                  BackgroundColor="#66000000"
                  InputTransparent="False">
                <ActivityIndicator IsRunning="True"
                                   Color="#7B68EE"
                                   WidthRequest="40"
                                   HeightRequest="40"
                                   HorizontalOptions="Center"
                                   VerticalOptions="Center" />
            </Grid>

            <!-- Error -->
            <Grid x:Name="ErrorState"
                  IsVisible="False"
                  Padding="24"
                  BackgroundColor="Transparent">
                <VerticalStackLayout HorizontalOptions="Center"
                                     VerticalOptions="Center"
                                     Spacing="12">
                    <Label Text="🖼"
                           FontSize="42"
                           HorizontalTextAlignment="Center" />
                    <Label x:Name="ErrorTitleLabel"
                           Text="Unable to open image"
                           FontSize="18"
                           FontAttributes="Bold"
                           TextColor="#2E241A"
                           HorizontalTextAlignment="Center" />
                    <Label x:Name="ErrorMessageLabel"
                           Text="The selected image could not be loaded."
                           FontSize="14"
                           TextColor="#5B5146"
                           HorizontalTextAlignment="Center" />
                </VerticalStackLayout>
            </Grid>
        </Grid>

        <!-- Theme overlay -->
        <Grid x:Name="ThemeOverlay"
              Grid.RowSpan="2"
              IsVisible="False"
              Opacity="0"
              BackgroundColor="#66000000"
              InputTransparent="True"
              ZIndex="50">

            <Grid.GestureRecognizers>
                <TapGestureRecognizer Tapped="OnThemeOverlayTapped" />
            </Grid.GestureRecognizers>

            <Border x:Name="ThemeSheet"
                    StrokeThickness="0"
                    BackgroundColor="White"
                    StrokeShape="RoundRectangle 24,24,0,0"
                    Padding="0,8,0,16"
                    TranslationY="240"
                    InputTransparent="False"
                    VerticalOptions="End"
                    Margin="0"
                    ZIndex="60">

                <VerticalStackLayout Spacing="12">

                    <Border x:Name="ThemeHandle"
                            HorizontalOptions="Center"
                            WidthRequest="40"
                            HeightRequest="5"
                            StrokeThickness="0"
                            BackgroundColor="#DDD6EA"
                            StrokeShape="RoundRectangle 999" />

                    <Label x:Name="ThemeSheetTitle"
                           Text="Image Settings"
                           HorizontalOptions="Center"
                           FontSize="14"
                           FontAttributes="Bold"
                           TextColor="#2E241A" />

                    <Grid x:Name="ThemeRow"
                          Padding="18,0,18,0"
                          ColumnDefinitions="Auto,*"
                          ColumnSpacing="12">

                        <Label x:Name="ThemeLabel"
                               Text="Theme"
                               VerticalOptions="Center"
                               FontSize="13"
                               TextColor="#2E241A" />

                        <HorizontalStackLayout x:Name="ThemeOptionsRow"
                                               Grid.Column="1"
                                               Spacing="8"
                                               HorizontalOptions="Fill">

                            <Border x:Name="ThemeLightBorder"
                                    WidthRequest="52"
                                    HeightRequest="52"
                                    StrokeThickness="3"
                                    Stroke="#3A332B"
                                    BackgroundColor="#F3F0FA"
                                    StrokeShape="RoundRectangle 14">
                                <Border.GestureRecognizers>
                                    <TapGestureRecognizer Tapped="OnThemeLightTapped" />
                                </Border.GestureRecognizers>
                            </Border>

                            <Border x:Name="ThemeBeigeBorder"
                                    WidthRequest="52"
                                    HeightRequest="52"
                                    StrokeThickness="0"
                                    BackgroundColor="#E8E1CF"
                                    StrokeShape="RoundRectangle 14">
                                <Border.GestureRecognizers>
                                    <TapGestureRecognizer Tapped="OnThemeBeigeTapped" />
                                </Border.GestureRecognizers>
                            </Border>

                            <Border x:Name="ThemeGreenBorder"
                                    WidthRequest="52"
                                    HeightRequest="52"
                                    StrokeThickness="0"
                                    BackgroundColor="#C8D4B3"
                                    StrokeShape="RoundRectangle 14">
                                <Border.GestureRecognizers>
                                    <TapGestureRecognizer Tapped="OnThemeGreenTapped" />
                                </Border.GestureRecognizers>
                            </Border>

                            <Border x:Name="ThemeBlueBorder"
                                    WidthRequest="52"
                                    HeightRequest="52"
                                    StrokeThickness="0"
                                    BackgroundColor="#C8D5E8"
                                    StrokeShape="RoundRectangle 14">
                                <Border.GestureRecognizers>
                                    <TapGestureRecognizer Tapped="OnThemeBlueTapped" />
                                </Border.GestureRecognizers>
                            </Border>

                            <Grid WidthRequest="52"
                                  HeightRequest="52">
                                <Border x:Name="ThemeDarkBorder"
                                        WidthRequest="52"
                                        HeightRequest="52"
                                        StrokeThickness="0"
                                        BackgroundColor="#050714"
                                        StrokeShape="RoundRectangle 14">
                                    <Border.GestureRecognizers>
                                        <TapGestureRecognizer Tapped="OnThemeDarkTapped" />
                                    </Border.GestureRecognizers>
                                </Border>

                                <Label x:Name="ThemeDarkIcon"
                                       Text="☾"
                                       HorizontalOptions="Center"
                                       VerticalOptions="Center"
                                       FontSize="16"
                                       TextColor="White"
                                       InputTransparent="True" />
                            </Grid>

                        </HorizontalStackLayout>
                    </Grid>
                </VerticalStackLayout>
            </Border>
        </Grid>
    </Grid>
</ContentPage>