<?xml version="1.0" encoding="utf-8" ?>
<ContentPage
    xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
    xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
    xmlns:shell="http://schemas.microsoft.com/dotnet/2021/maui"
    x:Class="E_Book.Pages.ForgotPasswordPage"
    shell:Shell.NavBarIsVisible="False"
    BackgroundColor="{AppThemeBinding Light=#F7F6FB, Dark=#121212}">

    <ScrollView x:Name="PageScrollView"
        VerticalScrollBarVisibility="Never">
        <Grid Padding="20,36,20,20"
          RowDefinitions="Auto,*">

            <Grid Grid.Row="0"
              ColumnDefinitions="56,*,56"
              Margin="0,0,0,8">

                <Border WidthRequest="46"
                    HeightRequest="46"
                    BackgroundColor="{AppThemeBinding Light=#FCFAFF, Dark=#1E1E1E}"
                    Stroke="{AppThemeBinding Light=#E8E0F8, Dark=#2D2D35}"
                    StrokeThickness="1"
                    HorizontalOptions="Start"
                    VerticalOptions="Center"
                    StrokeShape="RoundRectangle 23">

                    <Border.GestureRecognizers>
                        <TapGestureRecognizer Tapped="OnBackTapped" />
                    </Border.GestureRecognizers>

                    <Label Text="←"
                       FontSize="20"
                       FontAttributes="Bold"
                       TextColor="{AppThemeBinding Light=#3D36B3, Dark=White}"
                       HorizontalTextAlignment="Center"
                       VerticalTextAlignment="Center" />
                </Border>

                <Border x:Name="ThemeToggleBorder"
                    Grid.Column="2"
                    WidthRequest="46"
                    HeightRequest="46"
                    BackgroundColor="{AppThemeBinding Light=#FCFAFF, Dark=#1E1E1E}"
                    Stroke="{AppThemeBinding Light=#E8E0F8, Dark=#2D2D35}"
                    StrokeThickness="1"
                    HorizontalOptions="End"
                    VerticalOptions="Center"
                    StrokeShape="RoundRectangle 23">

                    <Border.GestureRecognizers>
                        <TapGestureRecognizer Tapped="OnThemeToggleTapped" />
                    </Border.GestureRecognizers>

                    <Label x:Name="ThemeIconLabel"
                       Text="🌙"
                       FontSize="18"
                       TextColor="{AppThemeBinding Light=#3D36B3, Dark=White}"
                       HorizontalTextAlignment="Center"
                       VerticalTextAlignment="Center" />
                </Border>
            </Grid>

            <Grid Grid.Row="1"
              VerticalOptions="Start"
              HorizontalOptions="Center"
              WidthRequest="360"
              Margin="0,24,0,140">

                <Border x:Name="ForgotCard" Padding="24,62,24,24" StrokeThickness="0" StrokeShape="RoundRectangle 28" BackgroundColor="{AppThemeBinding Light=#FCFAFF, Dark=#1A1A1E}" Opacity="0" TranslationY="40">

                    <Border.Shadow>
                        <Shadow Brush="#22000000"
                            Offset="0,10"
                            Radius="24"
                            Opacity="0.16" />
                    </Border.Shadow>

                    <VerticalStackLayout Spacing="16">

                        <VerticalStackLayout Spacing="6">
                            <Label Text="Forgot Password"
                               HorizontalTextAlignment="Center"
                               FontSize="32"
                               FontAttributes="Bold"
                               TextColor="{AppThemeBinding Light=#3D36B3, Dark=White}" />

                            <Label Text="Verify your identity to reset your password."
                               HorizontalTextAlignment="Center"
                               FontSize="16"
                               TextColor="{AppThemeBinding Light=#2F2B85, Dark=#C9C6D8}" />
                        </VerticalStackLayout>

                        <Border x:Name="EmailBorder"
                            Stroke="{AppThemeBinding Light=#E8E0F8, Dark=#2D2D35}"
                            StrokeThickness="1"
                            StrokeShape="RoundRectangle 18"
                            BackgroundColor="{AppThemeBinding Light=#FCFAFF, Dark=#23232A}"
                            HeightRequest="58"
                            Padding="18,0">

                            <Entry x:Name="EmailEntry"
                               Placeholder="Email"
                               Keyboard="Email"
                               ReturnType="Go"
                               Completed="OnEmailCompleted"
                               Focused="OnInputFocused"
                               FontSize="16"
                               BackgroundColor="Transparent"
                               TextColor="{AppThemeBinding Light=#2E2A3B, Dark=White}"
                               PlaceholderColor="{AppThemeBinding Light=#A09AB2, Dark=#8F8AA0}"
                               VerticalOptions="Center" />
                        </Border>

                        <Grid HeightRequest="58">
                            <Button x:Name="FindAccountButton"
                                Text="Find Account"
                                HeightRequest="58"
                                CornerRadius="22"
                                FontSize="17"
                                FontAttributes="Bold"
                                TextColor="White"
                                Clicked="OnFindAccountClicked">

                                <Button.Background>
                                    <LinearGradientBrush StartPoint="0,0" EndPoint="1,0">
                                        <GradientStop Color="#D9C5FF" Offset="0" />
                                        <GradientStop Color="#B496F4" Offset="1" />
                                    </LinearGradientBrush>
                                </Button.Background>
                            </Button>

                            <ActivityIndicator x:Name="FindLoading"
                                IsVisible="False"
                                IsRunning="False"
                                Color="White"
                                HorizontalOptions="Center"
                                VerticalOptions="Center" />
                        </Grid>

                        <Border x:Name="QuestionPanel"
                            IsVisible="False"
                            Stroke="{AppThemeBinding Light=#E8E0F8, Dark=#2D2D35}"
                            StrokeThickness="1"
                            StrokeShape="RoundRectangle 20"
                            BackgroundColor="{AppThemeBinding Light=#F8F4FF, Dark=#202028}"
                            Padding="16">

                            <VerticalStackLayout Spacing="12">
                                <Label Text="Security Question"
                                   FontSize="14"
                                   FontAttributes="Bold"
                                   TextColor="{AppThemeBinding Light=#6B63C8, Dark=#B9A8FF}" />

                                <Label x:Name="QuestionLabel"
                                   FontSize="16"
                                   LineBreakMode="WordWrap"
                                   TextColor="{AppThemeBinding Light=#2E2A3B, Dark=White}" />
                            </VerticalStackLayout>
                        </Border>

                        <Border x:Name="AnswerBorder"
                            IsVisible="False"
                            Stroke="{AppThemeBinding Light=#E8E0F8, Dark=#2D2D35}"
                            StrokeThickness="1"
                            StrokeShape="RoundRectangle 18"
                            BackgroundColor="{AppThemeBinding Light=#FCFAFF, Dark=#23232A}"
                            HeightRequest="58"
                            Padding="18,0">

                            <Entry x:Name="AnswerEntry"
                               Placeholder="Security Answer"
                               ReturnType="Go"
                               Completed="OnAnswerCompleted"
                               Focused="OnInputFocused"
                               FontSize="16"
                               BackgroundColor="Transparent"
                               TextColor="{AppThemeBinding Light=#2E2A3B, Dark=White}"
                               PlaceholderColor="{AppThemeBinding Light=#A09AB2, Dark=#8F8AA0}"
                               VerticalOptions="Center" />
                        </Border>

                        <Grid x:Name="VerifyGrid"
                              IsVisible="False"
                              HeightRequest="58">
                            <Button x:Name="VerifyButton"
                                Text="Verify Answer"
                                HeightRequest="58"
                                CornerRadius="22"
                                FontSize="17"
                                FontAttributes="Bold"
                                TextColor="White"
                                Clicked="OnVerifyClicked">

                                <Button.Background>
                                    <LinearGradientBrush StartPoint="0,0" EndPoint="1,0">
                                        <GradientStop Color="#D9C5FF" Offset="0" />
                                        <GradientStop Color="#B496F4" Offset="1" />
                                    </LinearGradientBrush>
                                </Button.Background>
                            </Button>

                            <ActivityIndicator x:Name="VerifyLoading"
                                IsVisible="False"
                                IsRunning="False"
                                Color="White"
                                HorizontalOptions="Center"
                                VerticalOptions="Center" />
                        </Grid>

                    </VerticalStackLayout>
                </Border>

                <Grid x:Name="LogoFrame"
                  HorizontalOptions="Center"
                  VerticalOptions="Start"
                  TranslationY="-22"
                  Opacity="0"
                  WidthRequest="96"
                  HeightRequest="96">

                    <Border Stroke="{AppThemeBinding Light=#D8CCF6, Dark=#2F2A46}"
                        StrokeThickness="2"
                        StrokeShape="RoundRectangle 48"
                        BackgroundColor="{AppThemeBinding Light=#FCFAFF, Dark=#1A1A1E}">

                        <Border.Shadow>
                            <Shadow Brush="#22000000"
                                Offset="0,7"
                                Radius="16"
                                Opacity="0.10" />
                        </Border.Shadow>
                    </Border>

                    <Image Source="app_logo.png"
                       WidthRequest="380"
                       HeightRequest="350"
                       HorizontalOptions="Center"
                       VerticalOptions="Center" />
                </Grid>

            </Grid>
        </Grid>
    </ScrollView>
</ContentPage>