<?xml version="1.0" encoding="utf-8" ?>
<ContentPage
    xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
    xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
    xmlns:shell="http://schemas.microsoft.com/dotnet/2021/maui"
    x:Class="E_Book.Pages.EditProfilePage"
    shell:Shell.TabBarIsVisible="False"
    shell:Shell.NavBarIsVisible="False"
    shell:Shell.PresentationMode="ModalAnimated"
    NavigationPage.HasNavigationBar="False"
    BackgroundColor="{AppThemeBinding Light=#F6F5FB, Dark=#121212}">

    <Grid RowDefinitions="10,56,*">

        <!-- Top gradient strip -->
        <Grid Grid.Row="0">
            <Grid.Background>
                <LinearGradientBrush StartPoint="0,0" EndPoint="1,0">
                    <GradientStop Color="#7A63FF" Offset="0" />
                    <GradientStop Color="#221551" Offset="1" />
                </LinearGradientBrush>
            </Grid.Background>
        </Grid>

        <!-- Header -->
        <Grid Grid.Row="1"
              ColumnDefinitions="80,*,80"
              Padding="18,8,18,0">

            <Label Text="Cancel"
                   FontSize="16"
                   TextColor="#7A63FF"
                   VerticalOptions="Center"
                   HorizontalOptions="Start">
                <Label.GestureRecognizers>
                    <TapGestureRecognizer Tapped="OnCancelTapped" />
                </Label.GestureRecognizers>
            </Label>

            <Label Grid.Column="1"
                   Text="Edit Profile"
                   FontSize="20"
                   FontAttributes="Bold"
                   HorizontalTextAlignment="Center"
                   VerticalOptions="Center"
                   TextColor="{AppThemeBinding Light=#221551, Dark=White}" />

            <Label x:Name="SaveLabel"
                   Grid.Column="2"
                   Text="Save"
                   FontSize="16"
                   FontAttributes="Bold"
                   TextColor="#C9BEF7"
                   VerticalOptions="Center"
                   HorizontalOptions="End">
                <Label.GestureRecognizers>
                    <TapGestureRecognizer Tapped="OnSaveTapped" />
                </Label.GestureRecognizers>
            </Label>
        </Grid>

        <!-- Content -->
        <ScrollView Grid.Row="2"
                    VerticalScrollBarVisibility="Never">
            <VerticalStackLayout Padding="18,10,18,24"
                                 Spacing="20">

                <!-- Avatar -->
                <VerticalStackLayout Spacing="8"
                                     HorizontalOptions="Center">
                    <Border WidthRequest="104"
                            HeightRequest="104"
                            BackgroundColor="{AppThemeBinding Light=#EEE8FB, Dark=#241F36}"
                            StrokeThickness="0"
                            StrokeShape="RoundRectangle 52">
                        <Label x:Name="AvatarLetter"
                               FontSize="40"
                               FontAttributes="Bold"
                               HorizontalTextAlignment="Center"
                               VerticalTextAlignment="Center"
                               TextColor="{AppThemeBinding Light=#221551, Dark=White}" />
                    </Border>

                    <Label x:Name="AccountTypeLabel"
                           FontSize="13"
                           HorizontalTextAlignment="Center"
                           TextColor="{AppThemeBinding Light=#8A869E, Dark=#B7B3C6}" />
                </VerticalStackLayout>

                <!-- Profile -->
                <VerticalStackLayout Spacing="10">
                    <Label Text="Profile"
                           FontSize="13"
                           FontAttributes="Bold"
                           Margin="2,0,0,0"
                           TextColor="{AppThemeBinding Light=#8A869E, Dark=#A9A4BB}" />

                    <Border StrokeThickness="0"
                            StrokeShape="RoundRectangle 22"
                            Padding="16"
                            BackgroundColor="{AppThemeBinding Light=White, Dark=#1A1A1E}">

                        <VerticalStackLayout Spacing="0">

                            <!-- Full Name -->
                            <Grid ColumnDefinitions="Auto,*"
                                  Padding="0,8">
                                <Label Text="Full Name"
                                       FontSize="16"
                                       TextColor="{AppThemeBinding Light=#8A869E, Dark=#B7B3C6}"
                                       VerticalOptions="Center" />

                                <Entry x:Name="NameEntry"
                                       Grid.Column="1"
                                       FontSize="16"
                                       HorizontalTextAlignment="End"
                                       BackgroundColor="Transparent"
                                       TextColor="{AppThemeBinding Light=#221551, Dark=White}"
                                       Placeholder="Enter your name"
                                       PlaceholderColor="{AppThemeBinding Light=#B9B4C8, Dark=#8F8AA0}"
                                       TextChanged="OnNameChanged"
                                       VerticalOptions="Center" />
                            </Grid>

                            <BoxView HeightRequest="1"
                                     Margin="0,8,0,8"
                                     BackgroundColor="{AppThemeBinding Light=#EEEAF7, Dark=#2A2A31}" />

                            <!-- Email -->
                            <Grid ColumnDefinitions="Auto,*"
                                  Padding="0,8">
                                <Label Text="Email"
                                       FontSize="16"
                                       TextColor="{AppThemeBinding Light=#8A869E, Dark=#B7B3C6}"
                                       VerticalOptions="Center" />

                                <Label x:Name="EmailLabel"
                                       Grid.Column="1"
                                       FontSize="16"
                                       HorizontalTextAlignment="End"
                                       VerticalTextAlignment="Center"
                                       TextColor="{AppThemeBinding Light=#221551, Dark=White}" />
                            </Grid>

                            <BoxView HeightRequest="1"
                                     Margin="0,8,0,8"
                                     BackgroundColor="{AppThemeBinding Light=#EEEAF7, Dark=#2A2A31}" />

                            <!-- Password -->
                            <Grid ColumnDefinitions="Auto,*,Auto"
                                  Padding="0,8">
                                <Label Text="Password"
                                       FontSize="16"
                                       TextColor="{AppThemeBinding Light=#8A869E, Dark=#B7B3C6}"
                                       VerticalOptions="Center" />

                                <Label x:Name="ChangePasswordLabel"
                                       Grid.Column="2"
                                       Text="Change ›"
                                       FontSize="16"
                                       FontAttributes="Bold"
                                       TextColor="#7A63FF"
                                       VerticalTextAlignment="Center">
                                    <Label.GestureRecognizers>
                                        <TapGestureRecognizer Tapped="OnChangePasswordTapped" />
                                    </Label.GestureRecognizers>
                                </Label>
                            </Grid>

                            <BoxView HeightRequest="1"
                                     Margin="0,8,0,8"
                                     BackgroundColor="{AppThemeBinding Light=#EEEAF7, Dark=#2A2A31}" />

                            <!-- Quick Login -->
                            <Grid ColumnDefinitions="*,Auto"
                                  Padding="0,8">
                                <VerticalStackLayout Spacing="2">
                                    <Label Text="Quick Login"
                                           FontSize="16"
                                           FontAttributes="Bold"
                                           TextColor="{AppThemeBinding Light=#221551, Dark=White}" />
                                    <Label Text="Skip login for the next 1 to 5 app launches."
                                           FontSize="12"
                                           LineBreakMode="WordWrap"
                                           TextColor="{AppThemeBinding Light=#8A869E, Dark=#B7B3C6}" />
                                </VerticalStackLayout>

                                <Label x:Name="QuickLoginValueLabel"
                                       Grid.Column="1"
                                       Text="Off"
                                       FontSize="16"
                                       FontAttributes="Bold"
                                       TextColor="#7A63FF"
                                       VerticalTextAlignment="Center"
                                       HorizontalTextAlignment="End">
                                    <Label.GestureRecognizers>
                                        <TapGestureRecognizer Tapped="OnQuickLoginTapped" />
                                    </Label.GestureRecognizers>
                                </Label>
                            </Grid>

                        </VerticalStackLayout>
                    </Border>
                </VerticalStackLayout>

                <!-- Guest Notice -->
                <Border x:Name="GuestNotice"
                        IsVisible="False"
                        StrokeThickness="0"
                        StrokeShape="RoundRectangle 18"
                        Padding="14,12"
                        BackgroundColor="{AppThemeBinding Light=#F7F4FF, Dark=#24242A}">
                    <Label Text="Guest mode does not support editing profile details or password."
                           FontSize="12"
                           LineBreakMode="WordWrap"
                           TextColor="{AppThemeBinding Light=#8A869E, Dark=#B7B3C6}" />
                </Border>

                <!-- Account -->
                <VerticalStackLayout Spacing="10">
                    <Label Text="Account"
                           FontSize="13"
                           FontAttributes="Bold"
                           Margin="2,0,0,0"
                           TextColor="{AppThemeBinding Light=#8A869E, Dark=#A9A4BB}" />

                    <Border StrokeThickness="0"
                            StrokeShape="RoundRectangle 22"
                            Padding="0"
                            BackgroundColor="{AppThemeBinding Light=#FFF2F2, Dark=#2B1D1D}">
                        <Grid HeightRequest="58">
                            <Label Text="Log Out"
                                   FontSize="16"
                                   FontAttributes="Bold"
                                   TextColor="#E25757"
                                   HorizontalTextAlignment="Center"
                                   VerticalTextAlignment="Center">
                                <Label.GestureRecognizers>
                                    <TapGestureRecognizer Tapped="OnLogoutTapped" />
                                </Label.GestureRecognizers>
                            </Label>
                        </Grid>
                    </Border>
                </VerticalStackLayout>

            </VerticalStackLayout>
        </ScrollView>

    </Grid>
</ContentPage>