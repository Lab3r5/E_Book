<?xml version="1.0" encoding="utf-8" ?>
<ContentPage
    xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
    xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
    xmlns:shell="http://schemas.microsoft.com/dotnet/2021/maui"
    x:Class="E_Book.Pages.EditProfilePage"
    shell:Shell.TabBarIsVisible="False"
    shell:Shell.NavBarIsVisible="False"
    NavigationPage.HasNavigationBar="False"
    Padding="0"
    BackgroundColor="{AppThemeBinding Light=#F6F5FB, Dark=#121212}">

    <Grid RowDefinitions="10,56,*">

        <!-- Brand strip -->
        <Grid Grid.Row="0">
            <Grid.Background>
                <LinearGradientBrush StartPoint="0,0" EndPoint="1,0">
                    <GradientStop Color="#7A63FF" Offset="0" />
                    <GradientStop Color="#221551" Offset="1" />
                </LinearGradientBrush>
            </Grid.Background>
        </Grid>

        <!-- Header -->
        <Grid Grid.Row="1"
              ColumnDefinitions="80,*,80"
              Padding="18,10">

            <Grid Grid.Column="0"
                  HeightRequest="40"
                  VerticalOptions="Center">
                <Label x:Name="CancelLabel"
                       Text="Cancel"
                       FontSize="16"
                       VerticalTextAlignment="Center"
                       TextColor="{AppThemeBinding Light=#7A63FF, Dark=#B7B3C6}">
                    <Label.GestureRecognizers>
                        <TapGestureRecognizer Tapped="OnCancelTapped" />
                    </Label.GestureRecognizers>
                </Label>
            </Grid>

            <Label Grid.Column="1"
                   Text="Edit Profile"
                   FontSize="18"
                   FontAttributes="Bold"
                   HorizontalTextAlignment="Center"
                   VerticalTextAlignment="Center"
                   TextColor="{AppThemeBinding Light=#221551, Dark=White}" />

            <Grid Grid.Column="2"
                  HeightRequest="40"
                  VerticalOptions="Center">
                <Label x:Name="SaveLabel"
                       Text="Save"
                       FontSize="16"
                       FontAttributes="Bold"
                       HorizontalTextAlignment="End"
                       VerticalTextAlignment="Center"
                       TextColor="{AppThemeBinding Light=#7A63FF, Dark=White}">
                    <Label.GestureRecognizers>
                        <TapGestureRecognizer Tapped="OnSaveTapped" />
                    </Label.GestureRecognizers>
                </Label>
            </Grid>

        </Grid>

        <!-- Content -->
        <ScrollView Grid.Row="2"
                    VerticalScrollBarVisibility="Never">
            <VerticalStackLayout Padding="20,14,20,24"
                                 Spacing="18">

                <!-- Avatar -->
                <VerticalStackLayout HorizontalOptions="Center"
                                     Spacing="8"
                                     Margin="0,2,0,0">

                    <Border WidthRequest="76"
                            HeightRequest="76"
                            StrokeThickness="0"
                            StrokeShape="RoundRectangle 38"
                            BackgroundColor="{AppThemeBinding Light=#EDE7FF, Dark=#2A214F}">
                        <Label x:Name="AvatarLetter"
                               FontSize="28"
                               FontAttributes="Bold"
                               HorizontalTextAlignment="Center"
                               VerticalTextAlignment="Center"
                               TextColor="{AppThemeBinding Light=#221551, Dark=White}" />
                    </Border>

                    <Label x:Name="AccountTypeLabel"
                           FontSize="12"
                           TextColor="{AppThemeBinding Light=#8A869E, Dark=#B7B3C6}"
                           HorizontalTextAlignment="Center" />
                </VerticalStackLayout>

                <!-- Guest Notice -->
                <Border x:Name="GuestNotice"
                        IsVisible="False"
                        StrokeThickness="0"
                        Padding="14"
                        StrokeShape="RoundRectangle 16"
                        BackgroundColor="{AppThemeBinding Light=#F3EEFF, Dark=#2A214F}">
                    <Label Text="Guest accounts can view profile information only."
                           FontSize="13"
                           LineBreakMode="WordWrap"
                           TextColor="{AppThemeBinding Light=#221551, Dark=White}" />
                </Border>

                <!-- Profile Section -->
                <VerticalStackLayout Spacing="10">
                    <Label Text="Profile"
                           FontSize="13"
                           FontAttributes="Bold"
                           Margin="2,0,0,0"
                           TextColor="{AppThemeBinding Light=#8A869E, Dark=#A9A4BB}" />

                    <Border StrokeThickness="0"
                            StrokeShape="RoundRectangle 22"
                            Padding="16"
                            BackgroundColor="{AppThemeBinding Light=White, Dark=#1A1A1E}">

                        <VerticalStackLayout Spacing="0">

                            <!-- Full Name -->
                            <Grid ColumnDefinitions="*,*"
                                  MinimumHeightRequest="54">
                                <Label Text="Full Name"
                                       FontSize="14"
                                       VerticalTextAlignment="Center"
                                       TextColor="{AppThemeBinding Light=#8A869E, Dark=#B7B3C6}" />

                                <Entry x:Name="NameEntry"
                                       Grid.Column="1"
                                       Placeholder="Enter name"
                                       BackgroundColor="Transparent"
                                       ClearButtonVisibility="Never"
                                       HorizontalTextAlignment="End"
                                       VerticalTextAlignment="Center"
                                       TextColor="{AppThemeBinding Light=#221551, Dark=White}"
                                       PlaceholderColor="{AppThemeBinding Light=#C0BCD2, Dark=#6F6A80}"
                                       TextChanged="OnNameChanged" />
                            </Grid>

                            <BoxView HeightRequest="1"
                                     Margin="0,0,0,0"
                                     Color="{AppThemeBinding Light=#F0ECF8, Dark=#26262B}" />

                            <!-- Email -->
                            <Grid ColumnDefinitions="*,*"
                                  MinimumHeightRequest="54">
                                <Label Text="Email"
                                       FontSize="14"
                                       VerticalTextAlignment="Center"
                                       TextColor="{AppThemeBinding Light=#8A869E, Dark=#B7B3C6}" />

                                <Label x:Name="EmailLabel"
                                       Grid.Column="1"
                                       FontSize="14"
                                       HorizontalTextAlignment="End"
                                       VerticalTextAlignment="Center"
                                       LineBreakMode="TailTruncation"
                                       TextColor="{AppThemeBinding Light=#221551, Dark=White}" />
                            </Grid>

                            <BoxView HeightRequest="1"
                                     Margin="0,0,0,0"
                                     Color="{AppThemeBinding Light=#F0ECF8, Dark=#26262B}" />

                            <!-- Password -->
                            <Grid ColumnDefinitions="*,Auto"
                                  MinimumHeightRequest="54">
                                <Label Text="Password"
                                       FontSize="14"
                                       VerticalTextAlignment="Center"
                                       TextColor="{AppThemeBinding Light=#8A869E, Dark=#B7B3C6}" />

                                <Label x:Name="ChangePasswordLabel"
                                       Grid.Column="1"
                                       Text="Change ›"
                                       FontSize="14"
                                       FontAttributes="Bold"
                                       HorizontalTextAlignment="End"
                                       VerticalTextAlignment="Center"
                                       TextColor="{AppThemeBinding Light=#7A63FF, Dark=#B7B3C6}">
                                    <Label.GestureRecognizers>
                                        <TapGestureRecognizer Tapped="OnChangePasswordTapped" />
                                    </Label.GestureRecognizers>
                                </Label>
                            </Grid>

                        </VerticalStackLayout>

                    </Border>
                </VerticalStackLayout>

                <!-- Account Section -->
                <VerticalStackLayout Spacing="10"
                                     Margin="0,2,0,0">
                    <Label Text="Account"
                           FontSize="13"
                           FontAttributes="Bold"
                           Margin="2,0,0,0"
                           TextColor="{AppThemeBinding Light=#8A869E, Dark=#A9A4BB}" />

                    <Border x:Name="LogoutCard"
                            StrokeThickness="0"
                            StrokeShape="RoundRectangle 22"
                            Padding="16"
                            BackgroundColor="{AppThemeBinding Light=#FFF5F6, Dark=#2A1A1A}">
                        <Label Text="Log Out"
                               HorizontalTextAlignment="Center"
                               FontAttributes="Bold"
                               TextColor="#E5484D">
                            <Label.GestureRecognizers>
                                <TapGestureRecognizer Tapped="OnLogoutTapped" />
                            </Label.GestureRecognizers>
                        </Label>
                    </Border>
                </VerticalStackLayout>

            </VerticalStackLayout>
        </ScrollView>

    </Grid>
</ContentPage>