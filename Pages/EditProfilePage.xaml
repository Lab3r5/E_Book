<?xml version="1.0" encoding="utf-8" ?>
<ContentPage
    xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
    xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
    xmlns:shell="http://schemas.microsoft.com/dotnet/2021/maui"
    x:Class="E_Book.Pages.EditProfilePage"
    shell:Shell.TabBarIsVisible="False"
    shell:Shell.NavBarIsVisible="False"
    NavigationPage.HasNavigationBar="False"
    BackgroundColor="{AppThemeBinding Light=#F6F5FB, Dark=#121212}">

    <Grid RowDefinitions="Auto,*">

        <Grid Grid.Row="0"
              ColumnDefinitions="80,*,80"
              Padding="18,10,18,6"
              BackgroundColor="{AppThemeBinding Light=#F6F5FB, Dark=#121212}">

            <Label Text="Cancel"
                   FontSize="16"
                   VerticalOptions="Center"
                   HorizontalOptions="Start"
                   TextColor="#7A63FF">
                <Label.GestureRecognizers>
                    <TapGestureRecognizer Tapped="OnCancelTapped" />
                </Label.GestureRecognizers>
            </Label>

            <Label Grid.Column="1"
                   Text="Edit Profile"
                   FontSize="22"
                   FontAttributes="Bold"
                   HorizontalTextAlignment="Center"
                   VerticalOptions="Center"
                   TextColor="{AppThemeBinding Light=#221551, Dark=White}" />

            <Label x:Name="SaveLabel"
                   Grid.Column="2"
                   Text="Save"
                   FontSize="16"
                   FontAttributes="Bold"
                   VerticalOptions="Center"
                   HorizontalOptions="End"
                   TextColor="#C9BEF7"
                   Opacity="0.35">
                <Label.GestureRecognizers>
                    <TapGestureRecognizer Tapped="OnSaveTapped" />
                </Label.GestureRecognizers>
            </Label>
        </Grid>

        <ScrollView Grid.Row="1"
                    VerticalScrollBarVisibility="Never">
            <VerticalStackLayout Padding="18,8,18,28"
                                 Spacing="16">

                <Border StrokeThickness="1"
                        Stroke="{AppThemeBinding Light=#ECE7FA, Dark=#2C2C34}"
                        StrokeShape="RoundRectangle 26"
                        BackgroundColor="{AppThemeBinding Light=#FBFAFF, Dark=#18181C}"
                        Padding="20,16">
                    <VerticalStackLayout Spacing="10"
                                         HorizontalOptions="Center">

                        <Border WidthRequest="104"
                                HeightRequest="104"
                                BackgroundColor="{AppThemeBinding Light=#EEE8FB, Dark=#241F36}"
                                StrokeThickness="0"
                                StrokeShape="RoundRectangle 52">
                            <Label x:Name="AvatarLetter"
                                   FontSize="40"
                                   FontAttributes="Bold"
                                   HorizontalTextAlignment="Center"
                                   VerticalTextAlignment="Center"
                                   TextColor="{AppThemeBinding Light=#221551, Dark=White}" />
                        </Border>

                        <VerticalStackLayout Spacing="2"
                                             HorizontalOptions="Center">
                            <Label Text="Profile Overview"
                                   FontSize="13"
                                   HorizontalTextAlignment="Center"
                                   TextColor="{AppThemeBinding Light=#9A94AE, Dark=#AAA5BA}" />

                            <Label x:Name="AccountTypeLabel"
                                   FontSize="15"
                                   FontAttributes="Bold"
                                   HorizontalTextAlignment="Center"
                                   TextColor="{AppThemeBinding Light=#6F6B82, Dark=#D0CBDD}" />
                        </VerticalStackLayout>
                    </VerticalStackLayout>
                </Border>

                <Border StrokeThickness="1"
                        Stroke="{AppThemeBinding Light=#EEEAF7, Dark=#2A2A31}"
                        StrokeShape="RoundRectangle 24"
                        Padding="16"
                        BackgroundColor="{AppThemeBinding Light=White, Dark=#1A1A1E}">

                    <VerticalStackLayout Spacing="0">

                        <Label Text="Profile"
                               FontSize="14"
                               FontAttributes="None"
                               Margin="0,0,0,8"
                               TextColor="{AppThemeBinding Light=#8A869E, Dark=#AAA5BA}" />

                        <BoxView HeightRequest="1"
                                 Margin="0,8,0,8"
                                 BackgroundColor="{AppThemeBinding Light=#EEEAF7, Dark=#2A2A31}" />

                        <Grid ColumnDefinitions="*,*"
                              Padding="0,10">
                            <VerticalStackLayout Spacing="3">
                                <Label Text="Full Name"
                                       FontSize="12"
                                       FontAttributes="Bold"
                                       TextColor="{AppThemeBinding Light=#9C97AE, Dark=#AAA5BA}" />
                                <Label Text="Display name used in your profile"
                                       FontSize="11"
                                       LineBreakMode="WordWrap"
                                       TextColor="{AppThemeBinding Light=#B0ABBF, Dark=#878397}" />
                            </VerticalStackLayout>

                            <Entry x:Name="NameEntry"
                                   Grid.Column="1"
                                   FontSize="16"
                                   HorizontalTextAlignment="End"
                                   VerticalOptions="Start"
                                   Margin="0,2,0,0"
                                   BackgroundColor="Transparent"
                                   TextColor="{AppThemeBinding Light=#221551, Dark=White}"
                                   Placeholder="Enter your name"
                                   PlaceholderColor="{AppThemeBinding Light=#B9B4C8, Dark=#8F8AA0}"
                                   TextChanged="OnNameChanged" />
                        </Grid>

                        <BoxView HeightRequest="1"
                                 Margin="0,10,0,10"
                                 BackgroundColor="{AppThemeBinding Light=#EEEAF7, Dark=#2A2A31}" />

                        <Grid ColumnDefinitions="*,Auto"
                              Padding="0,10">
                            <VerticalStackLayout Spacing="3">
                                <Label Text="Email"
                                       FontSize="12"
                                       FontAttributes="Bold"
                                       TextColor="{AppThemeBinding Light=#9C97AE, Dark=#AAA5BA}" />
                                <Label Text="Account sign-in email"
                                       FontSize="11"
                                       TextColor="{AppThemeBinding Light=#B0ABBF, Dark=#878397}" />
                            </VerticalStackLayout>

                            <Label x:Name="EmailLabel"
                                   Grid.Column="1"
                                   FontSize="16"
                                   FontAttributes="Bold"
                                   LineBreakMode="TailTruncation"
                                   MaxLines="1"
                                   HorizontalTextAlignment="End"
                                   VerticalTextAlignment="Center"
                                   TextColor="{AppThemeBinding Light=#221551, Dark=White}" />
                        </Grid>

                        <BoxView HeightRequest="1"
                                 Margin="0,10,0,10"
                                 BackgroundColor="{AppThemeBinding Light=#EEEAF7, Dark=#2A2A31}" />

                        <Grid ColumnDefinitions="*,Auto"
                              Padding="0,10">
                            <VerticalStackLayout Spacing="3">
                                <Label Text="Password"
                                       FontSize="12"
                                       FontAttributes="Bold"
                                       TextColor="{AppThemeBinding Light=#9C97AE, Dark=#AAA5BA}" />
                                <Label Text="Update your sign-in password"
                                       FontSize="11"
                                       TextColor="{AppThemeBinding Light=#B0ABBF, Dark=#878397}" />
                            </VerticalStackLayout>

                            <Border Grid.Column="1"
                                    Padding="12,7"
                                    BackgroundColor="{AppThemeBinding Light=#F3EEFF, Dark=#2A214F}"
                                    StrokeThickness="0"
                                    StrokeShape="RoundRectangle 16"
                                    VerticalOptions="Center">
                                <Label x:Name="ChangePasswordLabel"
                                       Text="Change"
                                       FontSize="14"
                                       FontAttributes="Bold"
                                       TextColor="#7A63FF"
                                       VerticalTextAlignment="Center">
                                    <Label.GestureRecognizers>
                                        <TapGestureRecognizer Tapped="OnChangePasswordTapped" />
                                    </Label.GestureRecognizers>
                                </Label>
                            </Border>
                        </Grid>

                        <BoxView HeightRequest="1"
                                 Margin="0,10,0,10"
                                 BackgroundColor="{AppThemeBinding Light=#EEEAF7, Dark=#2A2A31}" />

                        <Grid ColumnDefinitions="*,Auto"
                              Padding="0,10">
                            <VerticalStackLayout Spacing="3"
                                                 VerticalOptions="Center">
                                <Label Text="Quick Login"
                                       FontSize="12"
                                       FontAttributes="Bold"
                                       TextColor="{AppThemeBinding Light=#221551, Dark=White}" />
                                <Label Text="Skip login for the next 1 to 5 app launches."
                                       FontSize="12"
                                       LineBreakMode="WordWrap"
                                       TextColor="{AppThemeBinding Light=#8A869E, Dark=#B7B3C6}" />
                            </VerticalStackLayout>

                            <Border Grid.Column="1"
                                    Padding="12,7"
                                    Margin="12,0,0,0"
                                    BackgroundColor="{AppThemeBinding Light=#F3EEFF, Dark=#2A214F}"
                                    StrokeThickness="0"
                                    StrokeShape="RoundRectangle 16"
                                    VerticalOptions="Center">
                                <Label x:Name="QuickLoginValueLabel"
                                       Text="Off"
                                       FontSize="14"
                                       FontAttributes="Bold"
                                       TextColor="#7A63FF"
                                       VerticalTextAlignment="Center"
                                       HorizontalTextAlignment="Center">
                                    <Label.GestureRecognizers>
                                        <TapGestureRecognizer Tapped="OnQuickLoginTapped" />
                                    </Label.GestureRecognizers>
                                </Label>
                            </Border>
                        </Grid>

                    </VerticalStackLayout>
                </Border>

                <Border x:Name="GuestNotice"
                        IsVisible="False"
                        StrokeThickness="0"
                        StrokeShape="RoundRectangle 18"
                        Padding="14,12"
                        BackgroundColor="{AppThemeBinding Light=#F7F4FF, Dark=#24242A}">

                    <Grid ColumnDefinitions="Auto,*"
                          ColumnSpacing="12"
                          VerticalOptions="Center">

                        <Border WidthRequest="20"
                                HeightRequest="20"
                                StrokeThickness="0"
                                BackgroundColor="{AppThemeBinding Light=#E9E3FA, Dark=#34303D}"
                                StrokeShape="RoundRectangle 10"
                                VerticalOptions="Start"
                                Margin="0,2,0,0">

                            <Label Text="i"
                                   FontSize="12"
                                   FontAttributes="Bold"
                                   HorizontalTextAlignment="Center"
                                   VerticalTextAlignment="Center"
                                   TextColor="{AppThemeBinding Light=#8A869E, Dark=#B7B3C6}" />
                        </Border>

                        <Label Grid.Column="1"
                               Text="Guest mode cannot edit profile or password."
                               FontSize="12"
                               LineBreakMode="WordWrap"
                               VerticalOptions="Start"
                               TextColor="{AppThemeBinding Light=#8A869E, Dark=#B7B3C6}" />

                    </Grid>

                </Border>

                <Border StrokeThickness="0"
                        StrokeShape="RoundRectangle 22"
                        Padding="0"
                        Margin="0,8,0,0"
                        BackgroundColor="{AppThemeBinding Light=#FFF2F2, Dark=#2B1D1D}">
                    <Grid HeightRequest="64">
                        <Label Text="Log Out"
                               FontSize="17"
                               FontAttributes="Bold"
                               TextColor="#E25757"
                               HorizontalTextAlignment="Center"
                               VerticalTextAlignment="Center">
                            <Label.GestureRecognizers>
                                <TapGestureRecognizer Tapped="OnLogoutTapped" />
                            </Label.GestureRecognizers>
                        </Label>
                    </Grid>
                </Border>

            </VerticalStackLayout>
        </ScrollView>
    </Grid>
</ContentPage>