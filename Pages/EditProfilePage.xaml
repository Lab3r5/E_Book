<?xml version="1.0" encoding="utf-8" ?>
<ContentPage
    xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
    xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
    x:Class="E_Book.Pages.EditProfilePage"
    NavigationPage.HasNavigationBar="False"
    Padding="0"
    BackgroundColor="{AppThemeBinding Light=#F6F5FB, Dark=#121212}">

    <Grid RowDefinitions="56,*">

        <!-- Top Bar -->
        <Grid Grid.Row="0"
              ColumnDefinitions="Auto,*"
              Padding="16,10">

            <Button Text="‹ Back"
                    FontSize="16"
                    BackgroundColor="Transparent"
                    Padding="0"
                    Clicked="OnBackClicked"
                    VerticalOptions="Center" />

            <Label Grid.Column="1"
                   Text="Edit Profile"
                   FontSize="22"
                   FontAttributes="Bold"
                   VerticalOptions="Center"
                   TextColor="{AppThemeBinding Light=#201A2B, Dark=#EDEDED}" />
        </Grid>

        <!-- Content -->
        <ScrollView Grid.Row="1">
            <VerticalStackLayout Padding="16" Spacing="14">

                <!-- Name -->
                <Label Text="Name"
                       FontAttributes="Bold"
                       TextColor="{AppThemeBinding Light=#201A2B, Dark=#EDEDED}" />
                <Entry x:Name="NameEntry"
                       Placeholder="Enter your name" />

                <!-- Email -->
                <Label Text="Email"
                       FontAttributes="Bold"
                       TextColor="{AppThemeBinding Light=#201A2B, Dark=#EDEDED}" />
                <Entry x:Name="EmailEntry"
                       Placeholder="Email"
                       Keyboard="Email"
                       IsEnabled="False" />

                <!-- Change Password -->
                <Button x:Name="ChangePasswordButton"
                        Text="Change Password"
                        Clicked="OnChangePasswordClicked" />

                <!-- Save -->
                <Button x:Name="SaveButton"
                        Text="Save"
                        Clicked="OnSaveClicked" />

            </VerticalStackLayout>
        </ScrollView>

    </Grid>
</ContentPage>