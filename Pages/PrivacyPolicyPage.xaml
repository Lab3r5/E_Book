<?xml version="1.0" encoding="utf-8" ?>
<ContentPage
    xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
    xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
    xmlns:shell="http://schemas.microsoft.com/dotnet/2021/maui"
    xmlns:controls="clr-namespace:E_Book.Controls"
    x:Class="E_Book.Pages.PrivacyPolicyPage"
    shell:Shell.TabBarIsVisible="False"
    shell:Shell.NavBarIsVisible="False"
    NavigationPage.HasNavigationBar="False"
    Padding="0"
    BackgroundColor="{AppThemeBinding Light=#F6F5FB, Dark=#121212}">

    <Grid RowDefinitions="Auto,*">

        <controls:AppHeader Title="Privacy Policy"
                            BackCommand="{Binding BackCommand}" />

        <ScrollView Grid.Row="1" VerticalScrollBarVisibility="Never">
            <VerticalStackLayout Padding="18,10,18,28" Spacing="16">

                <!-- Hero Card -->
                <Border StrokeThickness="1"
                        Stroke="{AppThemeBinding Light=#E7DFFF, Dark=#3B3168}"
                        BackgroundColor="{AppThemeBinding Light=#F1EAFF, Dark=#241C45}"
                        StrokeShape="RoundRectangle 24"
                        Padding="18">
                    <VerticalStackLayout Spacing="12">

                        <Grid ColumnDefinitions="Auto,*"
                              ColumnSpacing="12">

                            <Border WidthRequest="44"
                                    HeightRequest="44"
                                    BackgroundColor="{AppThemeBinding Light=#FFFFFF, Dark=#33285E}"
                                    StrokeThickness="0"
                                    StrokeShape="RoundRectangle 22"
                                    VerticalOptions="Start">
                                <Label Text="🔒"
                                       FontSize="20"
                                       HorizontalTextAlignment="Center"
                                       VerticalTextAlignment="Center" />
                            </Border>

                            <VerticalStackLayout Grid.Column="1"
                                                 Spacing="3">
                                <Label Text="Your privacy matters"
                                       FontSize="18"
                                       FontAttributes="Bold"
                                       TextColor="{AppThemeBinding Light=#221551, Dark=White}" />

                                <Label Text="Overview of how E_Book stores reading preferences, account data, and usage information locally in Version 1.10."
                                       FontSize="13"
                                       LineBreakMode="WordWrap"
                                       TextColor="{AppThemeBinding Light=#5A4B8A, Dark=#D7D0F1}" />
                            </VerticalStackLayout>
                        </Grid>

                        <BoxView HeightRequest="1"
                                 Opacity="0.35"
                                 Color="{AppThemeBinding Light=#CFC2F6, Dark=#5A4C92}" />

                        <Label Text="E_Book is designed as a lightweight academic reading application. Most data is stored locally on your device to support features such as reading progress, per-book preferences, and a personalized reading experience."
                               FontSize="13"
                               LineBreakMode="WordWrap"
                               TextColor="{AppThemeBinding Light=#2A1A62, Dark=#F2EEFF}" />
                    </VerticalStackLayout>
                </Border>

                <!-- Section: Storage -->
                <Border StrokeThickness="1"
                        Stroke="{AppThemeBinding Light=#EEEAF7, Dark=#26262C}"
                        BackgroundColor="{AppThemeBinding Light=White, Dark=#1A1A1E}"
                        StrokeShape="RoundRectangle 22"
                        Padding="16">
                    <Grid ColumnDefinitions="Auto,*"
                          ColumnSpacing="14">

                        <Border WidthRequest="40"
                                HeightRequest="40"
                                BackgroundColor="{AppThemeBinding Light=#EEE8FF, Dark=#2A214F}"
                                StrokeThickness="0"
                                StrokeShape="RoundRectangle 20"
                                VerticalOptions="Start">
                            <Label Text="📁"
                                   FontSize="18"
                                   HorizontalTextAlignment="Center"
                                   VerticalTextAlignment="Center" />
                        </Border>

                        <VerticalStackLayout Grid.Column="1" Spacing="6">
                            <Label Text="Local Storage"
                                   FontSize="17"
                                   FontAttributes="Bold"
                                   TextColor="{AppThemeBinding Light=#221551, Dark=White}" />

                            <Label Text="The application stores data locally on your device to support core features. This may include imported books, per-book reading preferences such as font size, theme, and line spacing, reading progress, reading time, notification preferences, interface settings, and account-related preferences."
                                   FontSize="13"
                                   LineBreakMode="WordWrap"
                                   TextColor="{AppThemeBinding Light=#6F6B82, Dark=#C7C3D6}" />
                        </VerticalStackLayout>
                    </Grid>
                </Border>

                <!-- Section: Account -->
                <Border StrokeThickness="1"
                        Stroke="{AppThemeBinding Light=#EEEAF7, Dark=#26262C}"
                        BackgroundColor="{AppThemeBinding Light=White, Dark=#1A1A1E}"
                        StrokeShape="RoundRectangle 22"
                        Padding="16">
                    <Grid ColumnDefinitions="Auto,*"
                          ColumnSpacing="14">

                        <Border WidthRequest="40"
                                HeightRequest="40"
                                BackgroundColor="{AppThemeBinding Light=#EEE8FF, Dark=#2A214F}"
                                StrokeThickness="0"
                                StrokeShape="RoundRectangle 20"
                                VerticalOptions="Start">
                            <Label Text="👤"
                                   FontSize="18"
                                   HorizontalTextAlignment="Center"
                                   VerticalTextAlignment="Center" />
                        </Border>

                        <VerticalStackLayout Grid.Column="1" Spacing="6">
                            <Label Text="Account Information"
                                   FontSize="17"
                                   FontAttributes="Bold"
                                   TextColor="{AppThemeBinding Light=#221551, Dark=White}" />

                            <Label Text="If you create an account, your display name, email address, password, selected security question, and security answer may be stored locally on your device. This information is used only within the academic prototype to support authentication and password recovery."
                                   FontSize="13"
                                   LineBreakMode="WordWrap"
                                   TextColor="{AppThemeBinding Light=#6F6B82, Dark=#C7C3D6}" />
                        </VerticalStackLayout>
                    </Grid>
                </Border>

                <!-- Section: Password Recovery -->
                <Border StrokeThickness="1"
                        Stroke="{AppThemeBinding Light=#EEEAF7, Dark=#26262C}"
                        BackgroundColor="{AppThemeBinding Light=White, Dark=#1A1A1E}"
                        StrokeShape="RoundRectangle 22"
                        Padding="16">
                    <Grid ColumnDefinitions="Auto,*"
                          ColumnSpacing="14">

                        <Border WidthRequest="40"
                                HeightRequest="40"
                                BackgroundColor="{AppThemeBinding Light=#EEE8FF, Dark=#2A214F}"
                                StrokeThickness="0"
                                StrokeShape="RoundRectangle 20"
                                VerticalOptions="Start">
                            <Label Text="🛡️"
                                   FontSize="18"
                                   HorizontalTextAlignment="Center"
                                   VerticalTextAlignment="Center" />
                        </Border>

                        <VerticalStackLayout Grid.Column="1" Spacing="6">
                            <Label Text="Password Recovery"
                                   FontSize="17"
                                   FontAttributes="Bold"
                                   TextColor="{AppThemeBinding Light=#221551, Dark=White}" />

                            <Label Text="The Forgot Password feature uses a locally stored security question and answer to verify your identity before allowing a password reset. No email service, cloud server, or external verification provider is used in this prototype."
                                   FontSize="13"
                                   LineBreakMode="WordWrap"
                                   TextColor="{AppThemeBinding Light=#6F6B82, Dark=#C7C3D6}" />
                        </VerticalStackLayout>
                    </Grid>
                </Border>

                <!-- Section: Reading Data -->
                <Border StrokeThickness="1"
                        Stroke="{AppThemeBinding Light=#EEEAF7, Dark=#26262C}"
                        BackgroundColor="{AppThemeBinding Light=White, Dark=#1A1A1E}"
                        StrokeShape="RoundRectangle 22"
                        Padding="16">
                    <Grid ColumnDefinitions="Auto,*"
                          ColumnSpacing="14">

                        <Border WidthRequest="40"
                                HeightRequest="40"
                                BackgroundColor="{AppThemeBinding Light=#EEE8FF, Dark=#2A214F}"
                                StrokeThickness="0"
                                StrokeShape="RoundRectangle 20"
                                VerticalOptions="Start">
                            <Label Text="📖"
                                   FontSize="18"
                                   HorizontalTextAlignment="Center"
                                   VerticalTextAlignment="Center" />
                        </Border>

                        <VerticalStackLayout Grid.Column="1" Spacing="6">
                            <Label Text="Reading Data"
                                   FontSize="17"
                                   FontAttributes="Bold"
                                   TextColor="{AppThemeBinding Light=#221551, Dark=White}" />

                            <Label Text="E_Book stores reading-related information locally, including last opened page, total pages, reading progress percentage, reading duration, and table-of-contents navigation position. This allows the app to restore reading state and provide resume functionality across sessions."
                                   FontSize="13"
                                   LineBreakMode="WordWrap"
                                   TextColor="{AppThemeBinding Light=#6F6B82, Dark=#C7C3D6}" />
                        </VerticalStackLayout>
                    </Grid>
                </Border>

                <!-- Section: Notifications -->
                <Border StrokeThickness="1"
                        Stroke="{AppThemeBinding Light=#EEEAF7, Dark=#26262C}"
                        BackgroundColor="{AppThemeBinding Light=White, Dark=#1A1A1E}"
                        StrokeShape="RoundRectangle 22"
                        Padding="16">
                    <Grid ColumnDefinitions="Auto,*"
                          ColumnSpacing="14">

                        <Border WidthRequest="40"
                                HeightRequest="40"
                                BackgroundColor="{AppThemeBinding Light=#EEE8FF, Dark=#2A214F}"
                                StrokeThickness="0"
                                StrokeShape="RoundRectangle 20"
                                VerticalOptions="Start">
                            <Label Text="🔔"
                                   FontSize="18"
                                   HorizontalTextAlignment="Center"
                                   VerticalTextAlignment="Center" />
                        </Border>

                        <VerticalStackLayout Grid.Column="1" Spacing="6">
                            <Label Text="Notifications &amp; Reminder Preferences"
                                   FontSize="17"
                                   FontAttributes="Bold"
                                   TextColor="{AppThemeBinding Light=#221551, Dark=White}" />

                            <Label Text="If notifications are enabled, E_Book stores reminder preferences locally, including reading reminder settings, continue-reading prompts, and recent reading activity used to generate notification messages."
                                   FontSize="13"
                                   LineBreakMode="WordWrap"
                                   TextColor="{AppThemeBinding Light=#6F6B82, Dark=#C7C3D6}" />
                        </VerticalStackLayout>
                    </Grid>
                </Border>

                <!-- Section: Quick Login -->
                <Border StrokeThickness="1"
                        Stroke="{AppThemeBinding Light=#EEEAF7, Dark=#26262C}"
                        BackgroundColor="{AppThemeBinding Light=White, Dark=#1A1A1E}"
                        StrokeShape="RoundRectangle 22"
                        Padding="16">
                    <Grid ColumnDefinitions="Auto,*"
                          ColumnSpacing="14">

                        <Border WidthRequest="40"
                                HeightRequest="40"
                                BackgroundColor="{AppThemeBinding Light=#EEE8FF, Dark=#2A214F}"
                                StrokeThickness="0"
                                StrokeShape="RoundRectangle 20"
                                VerticalOptions="Start">
                            <Label Text="⚡"
                                   FontSize="18"
                                   HorizontalTextAlignment="Center"
                                   VerticalTextAlignment="Center" />
                        </Border>

                        <VerticalStackLayout Grid.Column="1" Spacing="6">
                            <Label Text="Quick Login Feature"
                                   FontSize="17"
                                   FontAttributes="Bold"
                                   TextColor="{AppThemeBinding Light=#221551, Dark=White}" />

                            <Label Text="The Quick Login feature allows registered users to skip login verification for a limited number of app launches between 1 and 5. This preference is stored locally and can be adjusted or cleared from account-related settings."
                                   FontSize="13"
                                   LineBreakMode="WordWrap"
                                   TextColor="{AppThemeBinding Light=#6F6B82, Dark=#C7C3D6}" />
                        </VerticalStackLayout>
                    </Grid>
                </Border>

                <!-- Section: External Sharing -->
                <Border StrokeThickness="1"
                        Stroke="{AppThemeBinding Light=#EEEAF7, Dark=#26262C}"
                        BackgroundColor="{AppThemeBinding Light=White, Dark=#1A1A1E}"
                        StrokeShape="RoundRectangle 22"
                        Padding="16">
                    <Grid ColumnDefinitions="Auto,*"
                          ColumnSpacing="14">

                        <Border WidthRequest="40"
                                HeightRequest="40"
                                BackgroundColor="{AppThemeBinding Light=#EEE8FF, Dark=#2A214F}"
                                StrokeThickness="0"
                                StrokeShape="RoundRectangle 20"
                                VerticalOptions="Start">
                            <Label Text="🌐"
                                   FontSize="18"
                                   HorizontalTextAlignment="Center"
                                   VerticalTextAlignment="Center" />
                        </Border>

                        <VerticalStackLayout Grid.Column="1" Spacing="6">
                            <Label Text="External Sharing"
                                   FontSize="17"
                                   FontAttributes="Bold"
                                   TextColor="{AppThemeBinding Light=#221551, Dark=White}" />

                            <Label Text="This academic prototype does not transmit personal reading data or account information to external analytics, advertising, or third-party tracking services. Core user data is processed and stored locally on your device."
                                   FontSize="13"
                                   LineBreakMode="WordWrap"
                                   TextColor="{AppThemeBinding Light=#6F6B82, Dark=#C7C3D6}" />
                        </VerticalStackLayout>
                    </Grid>
                </Border>

                <!-- Section: Data Removal -->
                <Border StrokeThickness="1"
                        Stroke="{AppThemeBinding Light=#EEEAF7, Dark=#26262C}"
                        BackgroundColor="{AppThemeBinding Light=White, Dark=#1A1A1E}"
                        StrokeShape="RoundRectangle 22"
                        Padding="16">
                    <Grid ColumnDefinitions="Auto,*"
                          ColumnSpacing="14">

                        <Border WidthRequest="40"
                                HeightRequest="40"
                                BackgroundColor="{AppThemeBinding Light=#EEE8FF, Dark=#2A214F}"
                                StrokeThickness="0"
                                StrokeShape="RoundRectangle 20"
                                VerticalOptions="Start">
                            <Label Text="🗑️"
                                   FontSize="18"
                                   HorizontalTextAlignment="Center"
                                   VerticalTextAlignment="Center" />
                        </Border>

                        <VerticalStackLayout Grid.Column="1" Spacing="6">
                            <Label Text="Data Removal"
                                   FontSize="17"
                                   FontAttributes="Bold"
                                   TextColor="{AppThemeBinding Light=#221551, Dark=White}" />

                            <Label Text="All stored information remains on your device. You may remove locally stored data by deleting imported books, clearing reading and reminder data, resetting account-related data, clearing application storage, or uninstalling the application, depending on your device settings."
                                   FontSize="13"
                                   LineBreakMode="WordWrap"
                                   TextColor="{AppThemeBinding Light=#6F6B82, Dark=#C7C3D6}" />
                        </VerticalStackLayout>
                    </Grid>
                </Border>

                <!-- Bottom Note -->
                <Border StrokeThickness="0"
                        BackgroundColor="{AppThemeBinding Light=#F0EDF7, Dark=#17171B}"
                        StrokeShape="RoundRectangle 18"
                        Padding="14,12">
                    <VerticalStackLayout Spacing="4">
                        <Label Text="Policy Note"
                               FontSize="13"
                               FontAttributes="Bold"
                               TextColor="{AppThemeBinding Light=#5D5872, Dark=#D2CDE0}" />

                        <Label Text="This privacy policy applies to Version 1.10 of the academic prototype and may be updated as features such as enhanced reading analytics, synchronization options, or personalization improvements are introduced."
                               FontSize="12"
                               LineBreakMode="WordWrap"
                               TextColor="{AppThemeBinding Light=#8F8AA3, Dark=#AAA5BA}" />
                    </VerticalStackLayout>
                </Border>

                <!-- Version -->
                <Label Text="Last updated · Version 1.10"
                       FontSize="12"
                       HorizontalOptions="Center"
                       Margin="0,2,0,0"
                       TextColor="{AppThemeBinding Light=#9A96AB, Dark=#9F9AAF}" />

            </VerticalStackLayout>
        </ScrollView>
    </Grid>
</ContentPage>