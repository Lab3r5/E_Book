<?xml version="1.0" encoding="utf-8" ?>
<ContentPage
    xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
    xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
    xmlns:shell="http://schemas.microsoft.com/dotnet/2021/maui"
    xmlns:controls="clr-namespace:E_Book.Controls"
    x:Class="E_Book.Pages.PrivacyPolicyPage"
    shell:Shell.TabBarIsVisible="False"
    shell:Shell.NavBarIsVisible="False"
    NavigationPage.HasNavigationBar="False"
    Padding="0"
    BackgroundColor="{AppThemeBinding Light=#F6F5FB, Dark=#121212}">

    <Grid RowDefinitions="Auto,*">

        <controls:AppHeader Title="Privacy Policy"
                            BackCommand="{Binding BackCommand}" />

        <ScrollView Grid.Row="1" VerticalScrollBarVisibility="Never">
            <VerticalStackLayout Padding="18,10,18,24" Spacing="14">

                <Border StrokeThickness="0"
                        BackgroundColor="{AppThemeBinding Light=#F3EEFF, Dark=#2A214F}"
                        StrokeShape="RoundRectangle 20"
                        Padding="16">
                    <VerticalStackLayout Spacing="4">
                        <Label Text="Overview"
                               FontSize="14"
                               FontAttributes="Bold"
                               TextColor="{AppThemeBinding Light=#221551, Dark=White}" />
                        <Label Text="Your privacy is important. This page explains what basic data may be stored in the app."
                               FontSize="13"
                               LineBreakMode="WordWrap"
                               TextColor="{AppThemeBinding Light=#221551, Dark=White}" />
                    </VerticalStackLayout>
                </Border>

                <Border StrokeThickness="0"
                        BackgroundColor="{AppThemeBinding Light=White, Dark=#1A1A1E}"
                        StrokeShape="RoundRectangle 20"
                        Padding="16">
                    <VerticalStackLayout Spacing="6">
                        <Label Text="Local Storage"
                               FontSize="17"
                               FontAttributes="Bold"
                               TextColor="{AppThemeBinding Light=#221551, Dark=White}" />
                        <Label Text="The app may store imported books, reading progress, and interface preferences locally on your device to support core reading features."
                               FontSize="13"
                               LineBreakMode="WordWrap"
                               TextColor="{AppThemeBinding Light=#6F6B82, Dark=#C7C3D6}" />
                    </VerticalStackLayout>
                </Border>

                <Border StrokeThickness="0"
                        BackgroundColor="{AppThemeBinding Light=White, Dark=#1A1A1E}"
                        StrokeShape="RoundRectangle 20"
                        Padding="16">
                    <VerticalStackLayout Spacing="6">
                        <Label Text="Personal Data"
                               FontSize="17"
                               FontAttributes="Bold"
                               TextColor="{AppThemeBinding Light=#221551, Dark=White}" />
                        <Label Text="For this academic prototype, personal data collection is limited. The app does not sell your personal information."
                               FontSize="13"
                               LineBreakMode="WordWrap"
                               TextColor="{AppThemeBinding Light=#6F6B82, Dark=#C7C3D6}" />
                    </VerticalStackLayout>
                </Border>

                <Border StrokeThickness="0"
                        BackgroundColor="{AppThemeBinding Light=White, Dark=#1A1A1E}"
                        StrokeShape="RoundRectangle 20"
                        Padding="16">
                    <VerticalStackLayout Spacing="6">
                        <Label Text="Future Updates"
                               FontSize="17"
                               FontAttributes="Bold"
                               TextColor="{AppThemeBinding Light=#221551, Dark=White}" />
                        <Label Text="If cloud sync, accounts, or other online services are added in future versions, this privacy policy may be updated accordingly."
                               FontSize="13"
                               LineBreakMode="WordWrap"
                               TextColor="{AppThemeBinding Light=#6F6B82, Dark=#C7C3D6}" />
                    </VerticalStackLayout>
                </Border>

                <Border StrokeThickness="0"
                        BackgroundColor="{AppThemeBinding Light=White, Dark=#1A1A1E}"
                        StrokeShape="RoundRectangle 20"
                        Padding="16">
                    <VerticalStackLayout Spacing="6">
                        <Label Text="Data Removal"
                               FontSize="17"
                               FontAttributes="Bold"
                               TextColor="{AppThemeBinding Light=#221551, Dark=White}" />
                        <Label Text="You can remove locally stored content by clearing app data or uninstalling the application, depending on your device settings."
                               FontSize="13"
                               LineBreakMode="WordWrap"
                               TextColor="{AppThemeBinding Light=#6F6B82, Dark=#C7C3D6}" />
                    </VerticalStackLayout>
                </Border>

                <Label Text="Last updated: Version 1.05"
                       FontSize="12"
                       HorizontalOptions="Center"
                       Margin="0,4,0,0"
                       TextColor="{AppThemeBinding Light=#9A96AB, Dark=#9F9AAF}" />

            </VerticalStackLayout>
        </ScrollView>
    </Grid>
</ContentPage>