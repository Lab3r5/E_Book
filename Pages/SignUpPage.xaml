<?xml version="1.0" encoding="utf-8" ?>
<ContentPage
    xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
    xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
    xmlns:shell="http://schemas.microsoft.com/dotnet/2021/maui"
    x:Class="E_Book.Pages.SignUpPage"
    shell:Shell.NavBarIsVisible="False"
    BackgroundColor="#F7F6FB">

    <Grid Padding="20,36,20,20">

        <Grid VerticalOptions="Center"
              HorizontalOptions="Center"
              WidthRequest="360">

            <!-- Main Card -->
            <Frame x:Name="SignUpCard"
                   Padding="24,62,24,24"
                   CornerRadius="28"
                   HasShadow="True"
                   BackgroundColor="#FCFAFF"
                   Opacity="0"
                   TranslationY="40">

                <Frame.Shadow>
                    <Shadow Brush="#22000000"
                            Offset="0,10"
                            Radius="24"
                            Opacity="0.16" />
                </Frame.Shadow>

                <VerticalStackLayout Spacing="16">

                    <!-- Title -->
                    <VerticalStackLayout Spacing="6">
                        <Label Text="Sign Up"
                               HorizontalTextAlignment="Center"
                               FontSize="34"
                               FontAttributes="Bold"
                               TextColor="#3D36B3"/>

                        <Label Text="Create an account to get started."
                               HorizontalTextAlignment="Center"
                               FontSize="16"
                               TextColor="#2F2B85"/>
                    </VerticalStackLayout>

                    <!-- Name -->
                    <Border x:Name="NameBorder"
                            Stroke="#E8E0F8"
                            StrokeThickness="1"
                            StrokeShape="RoundRectangle 18"
                            BackgroundColor="#FCFAFF"
                            HeightRequest="58"
                            Padding="18,0">

                        <Entry x:Name="NameEntry"
                               Placeholder="Name"
                               ReturnType="Next"
                               Completed="OnNameCompleted"
                               FontSize="16"
                               BackgroundColor="Transparent"
                               TextColor="#2E2A3B"
                               PlaceholderColor="#A09AB2"
                               VerticalOptions="Center"/>
                    </Border>

                    <!-- Email -->
                    <Border x:Name="EmailBorder"
                            Stroke="#E8E0F8"
                            StrokeThickness="1"
                            StrokeShape="RoundRectangle 18"
                            BackgroundColor="#FCFAFF"
                            HeightRequest="58"
                            Padding="18,0">

                        <Entry x:Name="EmailEntry"
                               Placeholder="Email"
                               Keyboard="Email"
                               ReturnType="Next"
                               Completed="OnEmailCompleted"
                               FontSize="16"
                               BackgroundColor="Transparent"
                               TextColor="#2E2A3B"
                               PlaceholderColor="#A09AB2"
                               VerticalOptions="Center"/>
                    </Border>

                    <!-- Password -->
                    <Border x:Name="PasswordBorder"
                            Stroke="#E8E0F8"
                            StrokeThickness="1"
                            StrokeShape="RoundRectangle 18"
                            BackgroundColor="#FCFAFF"
                            HeightRequest="58"
                            Padding="0">

                        <Grid ColumnDefinitions="*,Auto"
                              ColumnSpacing="8"
                              Padding="18,0">

                            <Entry x:Name="PasswordEntry"
                                   Placeholder="Password"
                                   IsPassword="True"
                                   ReturnType="Go"
                                   Completed="OnPasswordCompleted"
                                   FontSize="16"
                                   BackgroundColor="Transparent"
                                   TextColor="#2E2A3B"
                                   PlaceholderColor="#A09AB2"
                                   VerticalOptions="Center"/>

                            <Button x:Name="TogglePasswordButton"
                                    Grid.Column="1"
                                    Text="👁"
                                    BackgroundColor="Transparent"
                                    TextColor="#B496F4"
                                    FontSize="16"
                                    WidthRequest="24"
                                    HeightRequest="24"
                                    CornerRadius="0"
                                    BorderWidth="0"
                                    Padding="0"
                                    Margin="4,0,0,0"
                                    Clicked="OnTogglePasswordClicked"
                                    VerticalOptions="Center"/>
                        </Grid>
                    </Border>

                    <!-- Sign Up Button -->
                    <Grid HeightRequest="60">

                        <Button x:Name="SignUpButton"
                                Text="Sign Up"
                                HeightRequest="60"
                                CornerRadius="24"
                                FontSize="18"
                                FontAttributes="Bold"
                                TextColor="White"
                                Clicked="OnSignUpClicked">

                            <Button.Background>
                                <LinearGradientBrush StartPoint="0,0" EndPoint="1,0">
                                    <GradientStop Color="#D9C5FF" Offset="0"/>
                                    <GradientStop Color="#B496F4" Offset="1"/>
                                </LinearGradientBrush>
                            </Button.Background>

                        </Button>

                        <ActivityIndicator x:Name="SignUpLoading"
                                           IsVisible="False"
                                           IsRunning="False"
                                           Color="White"
                                           HorizontalOptions="Center"
                                           VerticalOptions="Center"/>
                    </Grid>

                    <!-- Login -->
                    <HorizontalStackLayout HorizontalOptions="Center"
                                           Spacing="4"
                                           Padding="4">

                        <Label Text="Already have an account?"
                               FontSize="16"
                               TextColor="#2F2B85"
                               VerticalOptions="Center"/>

                        <Button Text="Log In"
                                Clicked="OnBackClicked"
                                BackgroundColor="Transparent"
                                TextColor="#3D36B3"
                                FontAttributes="Bold"
                                FontSize="16"
                                Padding="0"
                                WidthRequest="70"
                                HeightRequest="26"
                                BorderWidth="0"
                                CornerRadius="0"
                                VerticalOptions="Center"/>
                    </HorizontalStackLayout>

                </VerticalStackLayout>
            </Frame>

            <!-- Floating Logo -->
            <Grid x:Name="LogoFrame"
                  HorizontalOptions="Center"
                  VerticalOptions="Start"
                  TranslationY="-22"
                  Opacity="0"
                  WidthRequest="96"
                  HeightRequest="96">

                <Border Stroke="#D8CCF6"
                        StrokeThickness="2"
                        StrokeShape="RoundRectangle 48"
                        BackgroundColor="#FCFAFF">

                    <Border.Shadow>
                        <Shadow Brush="#22000000"
                                Offset="0,7"
                                Radius="16"
                                Opacity="0.10"/>
                    </Border.Shadow>
                </Border>

                <Image Source="app_logo.png"
                       WidthRequest="380"
                       HeightRequest="350"
                       HorizontalOptions="Center"
                       VerticalOptions="Center"/>
            </Grid>

        </Grid>

    </Grid>
</ContentPage>