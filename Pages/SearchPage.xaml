<?xml version="1.0" encoding="utf-8" ?>
<ContentPage
    xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
    xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
    x:Class="E_Book.Pages.SearchPage"
    Title="Search"
    Padding="16">

    <VerticalStackLayout Spacing="12">

        <SearchBar x:Name="SearchBarBox"
                   Placeholder="Search books..."
                   SearchButtonPressed="OnSearchPressed"
                   TextChanged="OnSearchTextChanged" />

        <!-- History（无记录时隐藏） -->
        <VerticalStackLayout x:Name="HistorySection"
                             IsVisible="False"
                             Spacing="8">
            <Label Text="History" FontAttributes="Bold" />

            <!-- 可滑动，不撑页面 -->
            <ScrollView Orientation="Horizontal">
                <HorizontalStackLayout x:Name="HistoryContainer"
                                       Spacing="8" />
            </ScrollView>
        </VerticalStackLayout>

        <Label Text="Popular Searches" FontAttributes="Bold" />

        <HorizontalStackLayout Spacing="8">
            <Button Text="Moby Dick" Clicked="OnPopularClicked" />
            <Button Text="Pride and Prejudice" Clicked="OnPopularClicked" />
            <Button Text="To Kill a Mockingbird" Clicked="OnPopularClicked" />
        </HorizontalStackLayout>

        <Label x:Name="StatusLabel" Text="" Opacity="0.7" />

        <!-- 搜索结果列表（演示/书库搜索都可用） -->
        <CollectionView x:Name="ResultList" SelectionMode="None">
            <CollectionView.ItemTemplate>
                <DataTemplate>
                    <Border StrokeThickness="1" Padding="12" Margin="0,6">
                        <Grid ColumnDefinitions="*,Auto" RowDefinitions="Auto,Auto">
                            <Label Text="{Binding FileName}" FontAttributes="Bold" />
                            <Label Grid.Row="1" Text="{Binding Format}" Opacity="0.7"/>

                            <Button Grid.Column="1" Grid.RowSpan="2"
                                    Text="Read"
                                    Clicked="OnReadClicked"
                                    CommandParameter="{Binding .}" />
                        </Grid>
                    </Border>
                </DataTemplate>
            </CollectionView.ItemTemplate>
        </CollectionView>

    </VerticalStackLayout>
</ContentPage>