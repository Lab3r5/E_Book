<?xml version="1.0" encoding="utf-8" ?>
<ContentPage
    xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
    xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
    x:Class="E_Book.Pages.AppearancePage"
    NavigationPage.HasNavigationBar="False"
    Padding="0"
    BackgroundColor="{AppThemeBinding Light=#F6F5FB, Dark=#121212}">

    <Grid RowDefinitions="56,*">

        <!-- Top Bar -->
        <Grid Grid.Row="0"
              ColumnDefinitions="Auto,*"
              Padding="16,10">

            <Button Text="‹ Back"
                    FontSize="16"
                    BackgroundColor="Transparent"
                    Padding="0"
                    Clicked="OnBackClicked"
                    VerticalOptions="Center" />

            <Label Grid.Column="1"
                   Text="Appearance"
                   FontSize="22"
                   FontAttributes="Bold"
                   VerticalOptions="Center"
                   TextColor="{AppThemeBinding Light=#201A2B, Dark=#EDEDED}" />
        </Grid>

        <!-- Content -->
        <ScrollView Grid.Row="1">
            <VerticalStackLayout Padding="16" Spacing="18">

                <!-- Theme section -->
                <Label Text="Theme"
                       FontAttributes="Bold"
                       FontSize="16"
                       TextColor="{AppThemeBinding Light=#201A2B, Dark=#EDEDED}" />

                <HorizontalStackLayout Spacing="12">
                    <Button Text="Light"
                            CornerRadius="24"
                            HeightRequest="56"
                            Clicked="OnLightClicked" />

                    <Button Text="Dark"
                            CornerRadius="24"
                            HeightRequest="56"
                            Clicked="OnDarkClicked" />
                </HorizontalStackLayout>

                <!-- Keep screen on section -->
                <Grid ColumnDefinitions="*,Auto" VerticalOptions="Center">
                    <Label Text="Keep Screen On"
                           FontSize="16"
                           TextColor="{AppThemeBinding Light=#201A2B, Dark=#EDEDED}"
                           VerticalOptions="Center" />

                    <Switch x:Name="KeepScreenOnSwitch"
                            Grid.Column="1"
                            Toggled="OnKeepScreenOnToggled"
                            VerticalOptions="Center" />
                </Grid>

            </VerticalStackLayout>
        </ScrollView>

    </Grid>
</ContentPage>