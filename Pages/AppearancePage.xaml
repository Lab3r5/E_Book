<?xml version="1.0" encoding="utf-8" ?>
<ContentPage
    xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
    xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
    xmlns:shell="http://schemas.microsoft.com/dotnet/2021/maui"
    xmlns:controls="clr-namespace:E_Book.Controls"
    x:Class="E_Book.Pages.AppearancePage"
    shell:Shell.TabBarIsVisible="False"
    shell:Shell.NavBarIsVisible="False"
    shell:Shell.PresentationMode="ModalAnimated"
    NavigationPage.HasNavigationBar="False"
    Padding="0"
    BackgroundColor="{AppThemeBinding Light=#F6F5FB, Dark=#121212}">

    <Grid RowDefinitions="Auto,*">

        <controls:AppHeader Title="Appearance"
                            BackCommand="{Binding BackCommand}" />

        <ScrollView Grid.Row="1" VerticalScrollBarVisibility="Never">
            <VerticalStackLayout Padding="18,10,18,24"
                                 Spacing="20">

                <!-- Intro -->
                <VerticalStackLayout Spacing="4" Padding="2,0,2,0">
                    <Label Text="Customize app appearance"
                           FontSize="18"
                           FontAttributes="Bold"
                           TextColor="{AppThemeBinding Light=#221551, Dark=White}" />
                    <Label Text="Manage theme behavior and display preferences."
                           FontSize="13"
                           LineBreakMode="WordWrap"
                           TextColor="{AppThemeBinding Light=#8A869E, Dark=#B7B3C6}" />
                </VerticalStackLayout>

                <!-- Theme Section -->
                <VerticalStackLayout Spacing="10">
                    <Label Text="Theme"
                           FontSize="13"
                           FontAttributes="Bold"
                           Margin="2,0,0,0"
                           TextColor="{AppThemeBinding Light=#8A869E, Dark=#A9A4BB}" />

                    <Border StrokeThickness="0"
                            StrokeShape="RoundRectangle 22"
                            Padding="16"
                            BackgroundColor="{AppThemeBinding Light=White, Dark=#1A1A1E}">
                        <VerticalStackLayout Spacing="14">

                            <!-- Segmented Control -->
                            <Border StrokeThickness="0"
                                    StrokeShape="RoundRectangle 28"
                                    Padding="4"
                                    BackgroundColor="{AppThemeBinding Light=#E9E1FB, Dark=#2A214F}">

                                <AbsoluteLayout x:Name="SegmentHost"
                                                HeightRequest="52">

                                    <Border x:Name="SegmentHighlight"
                                            AbsoluteLayout.LayoutBounds="0,0,0.3333,1"
                                            AbsoluteLayout.LayoutFlags="All"
                                            BackgroundColor="#7A63FF"
                                            StrokeShape="RoundRectangle 24" />

                                    <Grid x:Name="SegmentGrid"
                                          AbsoluteLayout.LayoutBounds="0,0,1,1"
                                          AbsoluteLayout.LayoutFlags="All"
                                          ColumnDefinitions="*,*,*"
                                          ColumnSpacing="0">

                                        <Label x:Name="AutoLabel"
                                               Text="Auto"
                                               Grid.Column="0"
                                               FontSize="15"
                                               FontAttributes="Bold"
                                               HorizontalTextAlignment="Center"
                                               VerticalTextAlignment="Center">
                                            <Label.GestureRecognizers>
                                                <TapGestureRecognizer Tapped="OnAutoTapped"/>
                                            </Label.GestureRecognizers>
                                        </Label>

                                        <Label x:Name="LightLabel"
                                               Text="Light"
                                               Grid.Column="1"
                                               FontSize="15"
                                               FontAttributes="Bold"
                                               HorizontalTextAlignment="Center"
                                               VerticalTextAlignment="Center">
                                            <Label.GestureRecognizers>
                                                <TapGestureRecognizer Tapped="OnLightTapped"/>
                                            </Label.GestureRecognizers>
                                        </Label>

                                        <Label x:Name="DarkLabel"
                                               Text="Dark"
                                               Grid.Column="2"
                                               FontSize="15"
                                               FontAttributes="Bold"
                                               HorizontalTextAlignment="Center"
                                               VerticalTextAlignment="Center">
                                            <Label.GestureRecognizers>
                                                <TapGestureRecognizer Tapped="OnDarkTapped"/>
                                            </Label.GestureRecognizers>
                                        </Label>

                                    </Grid>
                                </AbsoluteLayout>
                            </Border>

                            <Label Text="Automatically switch theme based on your schedule."
                                   FontSize="12"
                                   LineBreakMode="WordWrap"
                                   TextColor="{AppThemeBinding Light=#8A869E, Dark=#B7B3C6}" />

                            <!-- Current Mode -->
                            <Border StrokeThickness="0"
                                    StrokeShape="RoundRectangle 16"
                                    Padding="12,10"
                                    BackgroundColor="{AppThemeBinding Light=#F7F4FF, Dark=#24242A}">
                                <Grid ColumnDefinitions="Auto,*"
                                      ColumnSpacing="8">
                                    <Label Text="Current mode:"
                                           FontSize="12"
                                           FontAttributes="Bold"
                                           TextColor="{AppThemeBinding Light=#8A869E, Dark=#B7B3C6}" />
                                    <Label x:Name="CurrentModeLabel"
                                           Grid.Column="1"
                                           FontSize="12"
                                           FontAttributes="Bold"
                                           TextColor="{AppThemeBinding Light=#221551, Dark=White}" />
                                </Grid>
                            </Border>

                            <!-- Auto time settings -->
                            <VerticalStackLayout x:Name="AutoThemeSettings"
                                                 IsVisible="False"
                                                 Spacing="10">

                                <Label Text="Schedule"
                                       FontSize="12"
                                       FontAttributes="Bold"
                                       Margin="2,0,0,0"
                                       TextColor="{AppThemeBinding Light=#8A869E, Dark=#A9A4BB}" />

                                <Border StrokeThickness="0"
                                        StrokeShape="RoundRectangle 18"
                                        Padding="14"
                                        BackgroundColor="{AppThemeBinding Light=#F7F4FF, Dark=#24242A}">
                                    <Grid ColumnDefinitions="*,Auto"
                                          ColumnSpacing="12">
                                        <VerticalStackLayout Spacing="2"
                                                             VerticalOptions="Center">
                                            <Label Text="Light Start"
                                                   FontSize="15"
                                                   FontAttributes="Bold"
                                                   TextColor="{AppThemeBinding Light=#221551, Dark=White}" />
                                            <Label Text="Start light mode at this time."
                                                   FontSize="12"
                                                   TextColor="{AppThemeBinding Light=#8A869E, Dark=#B7B3C6}" />
                                        </VerticalStackLayout>

                                        <TimePicker x:Name="LightStartPicker"
                                                    Grid.Column="1"
                                                    VerticalOptions="Center"
                                                    TimeSelected="OnAutoThemeTimeChanged"/>
                                    </Grid>
                                </Border>

                                <Border StrokeThickness="0"
                                        StrokeShape="RoundRectangle 18"
                                        Padding="14"
                                        BackgroundColor="{AppThemeBinding Light=#F7F4FF, Dark=#24242A}">
                                    <Grid ColumnDefinitions="*,Auto"
                                          ColumnSpacing="12">
                                        <VerticalStackLayout Spacing="2"
                                                             VerticalOptions="Center">
                                            <Label Text="Dark Start"
                                                   FontSize="15"
                                                   FontAttributes="Bold"
                                                   TextColor="{AppThemeBinding Light=#221551, Dark=White}" />
                                            <Label Text="Start dark mode at this time."
                                                   FontSize="12"
                                                   TextColor="{AppThemeBinding Light=#8A869E, Dark=#B7B3C6}" />
                                        </VerticalStackLayout>

                                        <TimePicker x:Name="DarkStartPicker"
                                                    Grid.Column="1"
                                                    VerticalOptions="Center"
                                                    TimeSelected="OnAutoThemeTimeChanged"/>
                                    </Grid>
                                </Border>

                            </VerticalStackLayout>

                        </VerticalStackLayout>
                    </Border>
                </VerticalStackLayout>

                <!-- Reading Section -->
                <VerticalStackLayout Spacing="10">
                    <Label Text="Reading"
                           FontSize="13"
                           FontAttributes="Bold"
                           Margin="2,0,0,0"
                           TextColor="{AppThemeBinding Light=#8A869E, Dark=#A9A4BB}" />

                    <Border StrokeThickness="0"
                            StrokeShape="RoundRectangle 22"
                            Padding="16"
                            BackgroundColor="{AppThemeBinding Light=White, Dark=#1A1A1E}">
                        <Grid ColumnDefinitions="*,Auto"
                              ColumnSpacing="12"
                              MinimumHeightRequest="64">

                            <VerticalStackLayout Spacing="3"
                                                 VerticalOptions="Center">
                                <Label Text="Keep Screen On"
                                       FontSize="16"
                                       FontAttributes="Bold"
                                       TextColor="{AppThemeBinding Light=#221551, Dark=White}" />
                                <Label Text="Prevent the screen from sleeping while reading."
                                       FontSize="12"
                                       LineBreakMode="WordWrap"
                                       TextColor="{AppThemeBinding Light=#8A869E, Dark=#B7B3C6}" />
                            </VerticalStackLayout>

                            <Switch x:Name="KeepScreenOnSwitch"
                                    Grid.Column="1"
                                    Margin="0,0,4,0"
                                    Toggled="OnKeepScreenOnToggled"
                                    VerticalOptions="Center" />
                        </Grid>
                    </Border>
                </VerticalStackLayout>

                <!-- Reset Section -->
                <VerticalStackLayout Spacing="10">
                    <Label Text="Reset"
                           FontSize="13"
                           FontAttributes="Bold"
                           Margin="2,0,0,0"
                           TextColor="{AppThemeBinding Light=#8A869E, Dark=#A9A4BB}" />

                    <Border x:Name="ResetCard"
                            StrokeThickness="0"
                            StrokeShape="RoundRectangle 22"
                            Padding="16"
                            BackgroundColor="{AppThemeBinding Light=#FCFBFE, Dark=#17171A}">
                        <Grid ColumnDefinitions="*,Auto"
                              ColumnSpacing="12">

                            <VerticalStackLayout Spacing="3"
                                                 VerticalOptions="Center">
                                <Label Text="Reset Appearance"
                                       FontSize="15"
                                       FontAttributes="Bold"
                                       TextColor="{AppThemeBinding Light=#4A4365, Dark=#D8D4E5}" />
                                <Label Text="Restore default theme settings."
                                       FontSize="12"
                                       LineBreakMode="WordWrap"
                                       TextColor="{AppThemeBinding Light=#9A96AB, Dark=#8F8AA0}" />
                            </VerticalStackLayout>

                            <Label Grid.Column="1"
                                   Text="›"
                                   FontSize="20"
                                   TextColor="{AppThemeBinding Light=#9A96AB, Dark=#8F8AA0}"
                                   VerticalOptions="Center"
                                   VerticalTextAlignment="Center" />
                        </Grid>

                        <Border.GestureRecognizers>
                            <TapGestureRecognizer Tapped="OnResetTapped" />
                        </Border.GestureRecognizers>
                    </Border>
                </VerticalStackLayout>

            </VerticalStackLayout>
        </ScrollView>

    </Grid>
</ContentPage>