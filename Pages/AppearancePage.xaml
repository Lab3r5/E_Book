<?xml version="1.0" encoding="utf-8" ?>
<ContentPage
    xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
    xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
    x:Class="E_Book.Pages.AppearancePage"
    Title="Appearance"
    Padding="16">

    <VerticalStackLayout Spacing="14">
        <Label Text="Theme" FontAttributes="Bold" />
        <HorizontalStackLayout Spacing="10">
            <Button Text="Light" Clicked="OnLightClicked"/>
            <Button Text="Dark" Clicked="OnDarkClicked"/>
        </HorizontalStackLayout>

        <HorizontalStackLayout Spacing="10">
            <Label Text="Keep Screen On" VerticalOptions="Center"/>
            <Switch x:Name="KeepScreenOnSwitch" Toggled="OnKeepScreenOnToggled"/>
        </HorizontalStackLayout>
    </VerticalStackLayout>
</ContentPage>