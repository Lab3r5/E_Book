<?xml version="1.0" encoding="utf-8" ?>
<ContentPage
    xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
    xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
    x:Class="E_Book.Pages.LoginPage"
    Title="Login"
    Padding="24">

    <VerticalStackLayout Spacing="14" VerticalOptions="Center">
        <Label Text="Welcome Back" FontSize="28" FontAttributes="Bold" />

        <Entry x:Name="EmailEntry" Placeholder="Email" Keyboard="Email" />
        <Entry x:Name="PasswordEntry" Placeholder="Password" IsPassword="True" />

        <Button Text="Log In" Clicked="OnLoginClicked" />
        <Button Text="Continue as Guest" Clicked="OnGuestClicked" />

        <Button Text="Sign Up" Clicked="OnSignUpClicked" />
    </VerticalStackLayout>
</ContentPage>