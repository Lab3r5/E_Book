<?xml version="1.0" encoding="utf-8" ?>
<ContentPage
    xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
    xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
    xmlns:shell="clr-namespace:Microsoft.Maui.Controls;assembly=Microsoft.Maui.Controls"
    x:Class="E_Book.Pages.ReadingPage"
    x:Name="ReadingPageRoot"
    shell:Shell.NavBarIsVisible="False"
    shell:Shell.TabBarIsVisible="False"
    Padding="0"
    BackgroundColor="#F7F6FB">

    <Grid x:Name="RootGrid"
          RowDefinitions="Auto,*,Auto">

        <!-- Top Bar -->
        <Grid x:Name="TopBar"
              Grid.Row="0"
              ColumnDefinitions="Auto,*,Auto"
              Padding="16,10"
              Opacity="1"
              TranslationY="0"
              BackgroundColor="#CCF7F6FB"
              ZIndex="10">

            <Button x:Name="BackButton"
                    Text="←"
                    FontSize="22"
                    WidthRequest="44"
                    HeightRequest="44"
                    BackgroundColor="Transparent"
                    Padding="0"
                    Clicked="OnBackButtonClicked"
                    Pressed="OnButtonPressed"
                    Released="OnButtonReleased"
                    VerticalOptions="Center"
                    HorizontalOptions="Start"
                    TextColor="#4A4361"/>

            <Label x:Name="TitleLabel"
                   Grid.Column="1"
                   Text="Document"
                   FontSize="16"
                   FontAttributes="Bold"
                   HorizontalTextAlignment="Center"
                   VerticalOptions="Center"
                   LineBreakMode="TailTruncation"
                   TextColor="#4A4361"/>

            <Button x:Name="MenuButton"
                    Grid.Column="2"
                    Text="⋯"
                    FontSize="24"
                    WidthRequest="44"
                    HeightRequest="44"
                    BackgroundColor="Transparent"
                    Padding="0"
                    Clicked="OnMenuClicked"
                    Pressed="OnButtonPressed"
                    Released="OnButtonReleased"
                    VerticalOptions="Center"
                    HorizontalOptions="End"
                    TextColor="#4A4361"/>
        </Grid>

        <!-- Top separator -->
        <Border Grid.Row="0"
                HeightRequest="0.5"
                VerticalOptions="End"
                BackgroundColor="#DDD9EB"
                ZIndex="11"/>

        <!-- Reading Area -->
        <AbsoluteLayout Grid.Row="1"
                        x:Name="ReadingArea"
                        Padding="26,14"
                        BackgroundColor="#F7F6FB">

            <!-- Reader content host -->
            <Grid AbsoluteLayout.LayoutBounds="0,0,1,1"
                  AbsoluteLayout.LayoutFlags="All">

                <!-- TXT fallback -->
                <Label x:Name="fileContentLabel"
                       IsVisible="False"
                       Text="Loading..."
                       FontSize="22"
                       LineBreakMode="WordWrap"
                       VerticalOptions="FillAndExpand"
                       HorizontalOptions="FillAndExpand"
                       BackgroundColor="Transparent"
                       TextColor="#3E3A4A"/>

                <!-- Main reader view -->
                <WebView x:Name="ContentWebView"
                         IsVisible="True"
                         InputTransparent="True"
                         BackgroundColor="Transparent"
                         HeightRequest="-1"/>

                <!-- Transparent gesture layer -->
                <Grid x:Name="GestureLayer"
                      BackgroundColor="Transparent">
                    <Grid.GestureRecognizers>
                        <TapGestureRecognizer Tapped="OnReadingAreaTapped"/>
                        <SwipeGestureRecognizer Direction="Left" Swiped="OnSwipeLeft"/>
                        <SwipeGestureRecognizer Direction="Right" Swiped="OnSwipeRight"/>
                    </Grid.GestureRecognizers>
                </Grid>

            </Grid>

            <!-- Overlay -->
            <BoxView x:Name="Overlay"
                     IsVisible="False"
                     Opacity="0"
                     BackgroundColor="#55000000"
                     AbsoluteLayout.LayoutBounds="0,0,1,1"
                     AbsoluteLayout.LayoutFlags="All">
                <BoxView.GestureRecognizers>
                    <TapGestureRecognizer Tapped="OnDismissTapped"/>
                </BoxView.GestureRecognizers>
            </BoxView>

            <!-- Bottom floating menu -->
            <Border x:Name="MenuPopup"
                    IsVisible="False"
                    Opacity="0"
                    Scale="0.98"
                    WidthRequest="340"
                    HeightRequest="430"
                    Padding="16"
                    StrokeThickness="1"
                    Stroke="#E5E1F2"
                    BackgroundColor="#FFFFFF"
                    AbsoluteLayout.LayoutBounds="0.5,1,340,430"
                    AbsoluteLayout.LayoutFlags="PositionProportional"
                    TranslationY="-68">

                <Border.StrokeShape>
                    <RoundRectangle CornerRadius="22"/>
                </Border.StrokeShape>

                <ScrollView>
                    <VerticalStackLayout Spacing="14">

                        <Label Text="Reading Settings"
                               FontSize="17"
                               FontAttributes="Bold"
                               HorizontalTextAlignment="Center"
                               TextColor="#3E3A4A"/>

                        <!-- Font Size -->
                        <Label Text="Font Size"
                               FontSize="15"
                               HorizontalTextAlignment="Center"
                               TextColor="#3E3A4A"/>

                        <Label x:Name="FontSizeLabel"
                               Text="Medium"
                               FontSize="12"
                               HorizontalTextAlignment="Center"
                               TextColor="#6A6577"/>

                        <Grid ColumnDefinitions="*,*,*" ColumnSpacing="10">
                            <Button x:Name="SmallBtn"
                                    Text="Small"
                                    Clicked="OnFontPresetClicked"
                                    CommandParameter="0"
                                    Pressed="OnButtonPressed"
                                    Released="OnButtonReleased"
                                    CornerRadius="14"/>

                            <Button x:Name="MediumBtn"
                                    Grid.Column="1"
                                    Text="Medium"
                                    Clicked="OnFontPresetClicked"
                                    CommandParameter="1"
                                    Pressed="OnButtonPressed"
                                    Released="OnButtonReleased"
                                    CornerRadius="14"/>

                            <Button x:Name="LargeBtn"
                                    Grid.Column="2"
                                    Text="Large"
                                    Clicked="OnFontPresetClicked"
                                    CommandParameter="2"
                                    Pressed="OnButtonPressed"
                                    Released="OnButtonReleased"
                                    CornerRadius="14"/>
                        </Grid>

                        <Slider x:Name="FontSlider"
                                Minimum="0"
                                Maximum="2"
                                ValueChanged="OnFontSliderChanged"/>

                        <Grid ColumnDefinitions="Auto,*">
                            <Label Text="Small"
                                   TextColor="#6A6577"/>
                            <Label Grid.Column="1"
                                   Text="Large"
                                   HorizontalOptions="End"
                                   TextColor="#6A6577"/>
                        </Grid>

                        <!-- Line Spacing -->
                        <Label Text="Line Spacing"
                               FontSize="15"
                               HorizontalTextAlignment="Center"
                               Margin="0,8,0,0"
                               TextColor="#3E3A4A"/>

                        <Label x:Name="LineSpacingLabel"
                               Text="Normal"
                               FontSize="12"
                               HorizontalTextAlignment="Center"
                               TextColor="#6A6577"/>

                        <Grid ColumnDefinitions="*,*,*" ColumnSpacing="10">
                            <Button x:Name="CompactBtn"
                                    Text="Compact"
                                    Clicked="OnLineSpacingClicked"
                                    CommandParameter="0"
                                    Pressed="OnButtonPressed"
                                    Released="OnButtonReleased"
                                    CornerRadius="14"/>

                            <Button x:Name="NormalBtn"
                                    Grid.Column="1"
                                    Text="Normal"
                                    Clicked="OnLineSpacingClicked"
                                    CommandParameter="1"
                                    Pressed="OnButtonPressed"
                                    Released="OnButtonReleased"
                                    CornerRadius="14"/>

                            <Button x:Name="RelaxedBtn"
                                    Grid.Column="2"
                                    Text="Relaxed"
                                    Clicked="OnLineSpacingClicked"
                                    CommandParameter="2"
                                    Pressed="OnButtonPressed"
                                    Released="OnButtonReleased"
                                    CornerRadius="14"/>
                        </Grid>

                        <!-- Theme -->
                        <Label Text="Theme"
                               FontSize="15"
                               HorizontalTextAlignment="Center"
                               Margin="0,8,0,0"
                               TextColor="#3E3A4A"/>

                        <Grid ColumnDefinitions="*,*" ColumnSpacing="12">
                            <Button x:Name="LightBtn"
                                    Text="☀ Light"
                                    Clicked="OnThemeClicked"
                                    CommandParameter="Light"
                                    Pressed="OnButtonPressed"
                                    Released="OnButtonReleased"
                                    CornerRadius="14"/>

                            <Button x:Name="DarkBtn"
                                    Grid.Column="1"
                                    Text="☾ Dark"
                                    Clicked="OnThemeClicked"
                                    CommandParameter="Dark"
                                    Pressed="OnButtonPressed"
                                    Released="OnButtonReleased"
                                    CornerRadius="14"/>
                        </Grid>

                    </VerticalStackLayout>
                </ScrollView>
            </Border>

            <!-- Bottom gradient fade -->
            <BoxView HeightRequest="30"
                     VerticalOptions="End"
                     AbsoluteLayout.LayoutBounds="0,1,1,30"
                     AbsoluteLayout.LayoutFlags="WidthProportional"
                     InputTransparent="True">
                <BoxView.Background>
                    <LinearGradientBrush StartPoint="0,0" EndPoint="0,1">
                        <GradientStop Color="#00F7F6FB" Offset="0"/>
                        <GradientStop Color="#F7F6FB" Offset="1"/>
                    </LinearGradientBrush>
                </BoxView.Background>
            </BoxView>

        </AbsoluteLayout>

        <!-- Bottom progress -->
        <Grid x:Name="BottomBar"
              Grid.Row="2"
              Padding="18,8,18,10"
              ColumnDefinitions="*,Auto"
              VerticalOptions="Center"
              BackgroundColor="#CCF7F6FB"
              ZIndex="10">

            <ProgressBar x:Name="ReadingProgressBar"
                         Progress="0"
                         HeightRequest="3"
                         VerticalOptions="Center"/>

            <Label x:Name="ProgressText"
                   Grid.Column="1"
                   Text="1 of 1"
                   FontSize="12"
                   VerticalOptions="Center"
                   Margin="12,0,0,0"
                   TextColor="#6A6577"/>
        </Grid>

        <!-- Floating TOC button -->
        <Border x:Name="TocButtonContainer"
                Grid.Row="1"
                Grid.RowSpan="2"
                HorizontalOptions="End"
                VerticalOptions="End"
                WidthRequest="54"
                HeightRequest="54"
                Margin="0,0,18,54"
                Stroke="#E5E1F2"
                StrokeThickness="1"
                ZIndex="999"
                BackgroundColor="#FFFFFF">

            <Border.Shadow>
                <Shadow Brush="#33000000"
                        Offset="0,8"
                        Radius="16"
                        Opacity="0.4"/>
            </Border.Shadow>

            <Border.StrokeShape>
                <RoundRectangle CornerRadius="27"/>
            </Border.StrokeShape>

            <Button x:Name="TocButton"
                    Text="≣"
                    FontSize="18"
                    Padding="0"
                    BackgroundColor="Transparent"
                    Clicked="OnTocClicked"
                    Pressed="OnButtonPressed"
                    Released="OnButtonReleased"
                    TextColor="#4A4361"/>
        </Border>

    </Grid>
</ContentPage>