<?xml version="1.0" encoding="utf-8" ?>
<ContentPage
    xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
    xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
    xmlns:shell="clr-namespace:Microsoft.Maui.Controls;assembly=Microsoft.Maui.Controls"
    x:Class="E_Book.Pages.ReadingPage"
    shell:Shell.NavBarIsVisible="False"
    Padding="0"
    BackgroundColor="{AppThemeBinding Light=#F7F6FB, Dark=#0F0F12}">
    
    <Grid RowDefinitions="56,*,34">

        <!-- Top Bar -->
        <Grid x:Name="TopBar"
              Grid.Row="0"
              ColumnDefinitions="Auto,*,Auto"
              Padding="16,10"
              Opacity="1"
              TranslationY="0"
              BackgroundColor="Transparent">

            <Button x:Name="BackButton"
                    Text="‹ Back"
                    FontSize="16"
                    BackgroundColor="Transparent"
                    Padding="0"
                    Clicked="OnBackButtonClicked"
                    Pressed="OnButtonPressed"
                    Released="OnButtonReleased"
                    VerticalOptions="Center"
                    TextColor="{AppThemeBinding Light=#4A4361, Dark=#E7E5F0}"/>

            <Label x:Name="TitleLabel"
                   Grid.Column="1"
                   Text="Document"
                   FontSize="16"
                   HorizontalTextAlignment="Center"
                   VerticalOptions="Center"
                   LineBreakMode="TailTruncation"
                   TextColor="{AppThemeBinding Light=#4A4361, Dark=#E7E5F0}"/>

            <Button x:Name="MenuButton"
                    Grid.Column="2"
                    Text="☰"
                    FontSize="20"
                    BackgroundColor="Transparent"
                    Padding="0"
                    Clicked="OnMenuClicked"
                    Pressed="OnButtonPressed"
                    Released="OnButtonReleased"
                    VerticalOptions="Center"
                    TextColor="{AppThemeBinding Light=#4A4361, Dark=#E7E5F0}"/>
        </Grid>

        <!-- Content + overlay + popup -->
        <AbsoluteLayout Grid.Row="1"
                        x:Name="ReadingArea"
                        Padding="18,12"
                        BackgroundColor="{AppThemeBinding Light=#F7F6FB, Dark=#0F0F12}">

            <AbsoluteLayout.GestureRecognizers>
                <TapGestureRecognizer Tapped="OnReadingAreaTapped"/>
            </AbsoluteLayout.GestureRecognizers>

            <!-- TXT reading text (paged) -->
            <Label x:Name="fileContentLabel"
                   IsVisible="True"
                   Text="Loading..."
                   FontSize="22"
                   LineBreakMode="WordWrap"
                   VerticalOptions="FillAndExpand"
                   HorizontalOptions="FillAndExpand"
                   BackgroundColor="Transparent"
                   TextColor="{AppThemeBinding Light=#3E3A4A, Dark=#EDEAF6}"
                   AbsoluteLayout.LayoutBounds="0,0,1,1"
                   AbsoluteLayout.LayoutFlags="All"/>

            <!-- HTML/EPUB/DOCX/RTF reading (WebView) -->
            <WebView x:Name="ContentWebView"
                     IsVisible="False"
                     BackgroundColor="Transparent"
                     AbsoluteLayout.LayoutBounds="0,0,1,1"
                     AbsoluteLayout.LayoutFlags="All"/>

            <!-- Overlay -->
            <BoxView x:Name="Overlay"
                     IsVisible="False"
                     Opacity="0"
                     BackgroundColor="#55000000"
                     AbsoluteLayout.LayoutBounds="0,0,1,1"
                     AbsoluteLayout.LayoutFlags="All">
                <BoxView.GestureRecognizers>
                    <TapGestureRecognizer Tapped="OnDismissTapped"/>
                </BoxView.GestureRecognizers>
            </BoxView>

            <!-- Bottom floating menu -->
            <Border x:Name="MenuPopup"
                    IsVisible="False"
                    Opacity="0"
                    Scale="0.98"
                    WidthRequest="340"
                    HeightRequest="360"
                    Padding="16"
                    StrokeThickness="1"
                    Stroke="{AppThemeBinding Light=#E5E1F2, Dark=#2A2A32}"
                    BackgroundColor="{AppThemeBinding Light=#FFFFFF, Dark=#17171C}"
                    AbsoluteLayout.LayoutBounds="0.5,1,340,360"
                    AbsoluteLayout.LayoutFlags="PositionProportional"
                    TranslationY="-68">

                <Border.StrokeShape>
                    <RoundRectangle CornerRadius="22"/>
                </Border.StrokeShape>

                <ScrollView>
                    <VerticalStackLayout Spacing="12">

                        <Label Text="Font Size"
                               FontSize="16"
                               HorizontalTextAlignment="Center"
                               TextColor="{AppThemeBinding Light=#3E3A4A, Dark=#EDEAF6}"/>

                        <Label x:Name="FontSizeLabel"
                               Text="Medium"
                               FontSize="12"
                               HorizontalTextAlignment="Center"
                               TextColor="{AppThemeBinding Light=#6A6577, Dark=#BDB8C8}"/>

                        <Grid ColumnDefinitions="*,*,*" ColumnSpacing="10">
                            <Button x:Name="SmallBtn"
                                    Text="Small"
                                    Clicked="OnFontPresetClicked"
                                    CommandParameter="0"
                                    Pressed="OnButtonPressed"
                                    Released="OnButtonReleased"
                                    CornerRadius="14"/>

                            <Button x:Name="MediumBtn"
                                    Grid.Column="1"
                                    Text="Medium"
                                    Clicked="OnFontPresetClicked"
                                    CommandParameter="1"
                                    Pressed="OnButtonPressed"
                                    Released="OnButtonReleased"
                                    CornerRadius="14"/>

                            <Button x:Name="LargeBtn"
                                    Grid.Column="2"
                                    Text="Large"
                                    Clicked="OnFontPresetClicked"
                                    CommandParameter="2"
                                    Pressed="OnButtonPressed"
                                    Released="OnButtonReleased"
                                    CornerRadius="14"/>
                        </Grid>

                        <Slider x:Name="FontSlider"
                                Minimum="0"
                                Maximum="2"
                                ValueChanged="OnFontSliderChanged"/>

                        <Grid ColumnDefinitions="Auto,*">
                            <Label Text="Small"
                                   TextColor="{AppThemeBinding Light=#6A6577, Dark=#BDB8C8}"/>
                            <Label Grid.Column="1"
                                   Text="Large"
                                   HorizontalOptions="End"
                                   TextColor="{AppThemeBinding Light=#6A6577, Dark=#BDB8C8}"/>
                        </Grid>

                        <Label Text="Theme"
                               FontSize="14"
                               HorizontalTextAlignment="Center"
                               Margin="0,6,0,0"
                               TextColor="{AppThemeBinding Light=#3E3A4A, Dark=#EDEAF6}"/>

                        <Grid ColumnDefinitions="*,*" ColumnSpacing="12">
                            <Button x:Name="LightBtn"
                                    Text="☀ Light"
                                    Clicked="OnThemeClicked"
                                    CommandParameter="Light"
                                    Pressed="OnButtonPressed"
                                    Released="OnButtonReleased"
                                    CornerRadius="14"/>

                            <Button x:Name="DarkBtn"
                                    Grid.Column="1"
                                    Text="☾ Dark"
                                    Clicked="OnThemeClicked"
                                    CommandParameter="Dark"
                                    Pressed="OnButtonPressed"
                                    Released="OnButtonReleased"
                                    CornerRadius="14"/>
                        </Grid>

                    </VerticalStackLayout>
                </ScrollView>

            </Border>

        </AbsoluteLayout>

        <!-- Bottom progress -->
        <Grid x:Name="BottomBar"
              Grid.Row="2"
              Padding="18,0"
              ColumnDefinitions="*,Auto"
              VerticalOptions="Center"
              BackgroundColor="{AppThemeBinding Light=#F7F6FB, Dark=#0F0F12}">

            <ProgressBar x:Name="ReadingProgressBar"
                         Progress="0"
                         HeightRequest="2"
                         VerticalOptions="Center"/>

            <Label x:Name="ProgressText"
                   Grid.Column="1"
                   Text="1 of 1"
                   FontSize="12"
                   VerticalOptions="Center"
                   Margin="12,0,0,0"
                   TextColor="{AppThemeBinding Light=#6A6577, Dark=#BDB8C8}"/>
        </Grid>

        <!-- Floating TOC button -->
        <Border x:Name="TocButtonContainer"
                Grid.Row="1"
                Grid.RowSpan="2"
                HorizontalOptions="End"
                VerticalOptions="End"
                WidthRequest="52"
                HeightRequest="52"
                Margin="0,0,18,52"
                StrokeThickness="0"
                ZIndex="999"
                BackgroundColor="{AppThemeBinding Light=#F1EEFF, Dark=#20202A}">

            <Border.Shadow>
                <Shadow Brush="#66000000"
                        Offset="0,6"
                        Radius="14"
                        Opacity="0.35"/>
            </Border.Shadow>

            <Border.StrokeShape>
                <RoundRectangle CornerRadius="26"/>
            </Border.StrokeShape>

            <Button x:Name="TocButton"
                    Text="≡"
                    FontSize="18"
                    Padding="0"
                    BackgroundColor="Transparent"
                    Clicked="OnTocClicked"
                    Pressed="OnButtonPressed"
                    Released="OnButtonReleased"
                    TextColor="{AppThemeBinding Light=#4A4361, Dark=#E7E5F0}"/>
        </Border>

    </Grid>
</ContentPage>