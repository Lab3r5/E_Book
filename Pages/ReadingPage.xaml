<?xml version="1.0" encoding="utf-8" ?>
<ContentPage xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             x:Class="E_Book.Pages.ReadingPage"
             NavigationPage.HasNavigationBar="False">

    <Grid RowDefinitions="56,*,34">

        <!-- Top Bar -->
        <Grid Grid.Row="0"
              ColumnDefinitions="Auto,*,Auto"
              Padding="16,10">

            <Button x:Name="BackButton"
                    Text="‹ Back"
                    FontSize="16"
                    BackgroundColor="Transparent"
                    Padding="0"
                    Clicked="OnBackButtonClicked"
                    Pressed="OnButtonPressed"
                    Released="OnButtonReleased"
                    VerticalOptions="Center"/>

            <Label x:Name="TitleLabel"
                   Grid.Column="1"
                   Text="Document"
                   FontSize="16"
                   HorizontalTextAlignment="Center"
                   VerticalOptions="Center"
                   LineBreakMode="TailTruncation"/>

            <Button x:Name="MenuButton"
                    Grid.Column="2"
                    Text="☰"
                    FontSize="20"
                    BackgroundColor="Transparent"
                    Padding="0"
                    Clicked="OnMenuClicked"
                    Pressed="OnButtonPressed"
                    Released="OnButtonReleased"
                    VerticalOptions="Center"/>
        </Grid>

        <!-- Content + overlay + popup -->
        <AbsoluteLayout Grid.Row="1"
                        x:Name="ReadingArea"
                        Padding="18,12">

            <!-- TXT reading text (paged) -->
            <Label x:Name="fileContentLabel"
                   IsVisible="True"
                   Text="Loading..."
                   FontSize="22"
                   LineBreakMode="WordWrap"
                   VerticalOptions="FillAndExpand"
                   HorizontalOptions="FillAndExpand"
                   BackgroundColor="Transparent"
                   AbsoluteLayout.LayoutBounds="0,0,1,1"
                   AbsoluteLayout.LayoutFlags="All"/>

            <!-- HTML/EPUB/DOCX/RTF reading (WebView) -->
            <WebView x:Name="ContentWebView"
                     IsVisible="False"
                     BackgroundColor="Transparent"
                     AbsoluteLayout.LayoutBounds="0,0,1,1"
                     AbsoluteLayout.LayoutFlags="All"/>

            <!-- Overlay (fade in/out) -->
            <BoxView x:Name="Overlay"
                     IsVisible="False"
                     Opacity="0"
                     BackgroundColor="#55000000"
                     AbsoluteLayout.LayoutBounds="0,0,1,1"
                     AbsoluteLayout.LayoutFlags="All">
                <BoxView.GestureRecognizers>
                    <TapGestureRecognizer Tapped="OnDismissTapped"/>
                </BoxView.GestureRecognizers>
            </BoxView>

            <!-- Bottom floating menu (animated) -->
            <Border x:Name="MenuPopup"
                    IsVisible="False"
                    Opacity="0"
                    Scale="0.98"
                    WidthRequest="340"
                    HeightRequest="360"
                    Padding="16"
                    StrokeThickness="1"
                    AbsoluteLayout.LayoutBounds="0.5,1,340,360"
                    AbsoluteLayout.LayoutFlags="PositionProportional"
                    TranslationY="-68">

                <Border.StrokeShape>
                    <RoundRectangle CornerRadius="22"/>
                </Border.StrokeShape>

                <ScrollView>
                    <VerticalStackLayout Spacing="12">

                        <Label x:Name="PopupTitle1"
                               Text="Font Size"
                               FontSize="16"
                               HorizontalTextAlignment="Center"/>

                        <Label x:Name="FontSizeLabel"
                               Text="Medium"
                               FontSize="12"
                               HorizontalTextAlignment="Center"/>

                        <Grid ColumnDefinitions="*,*,*" ColumnSpacing="10">
                            <Button x:Name="SmallBtn"
                                    Text="Small"
                                    Clicked="OnFontPresetClicked"
                                    CommandParameter="0"
                                    Pressed="OnButtonPressed"
                                    Released="OnButtonReleased"
                                    CornerRadius="14"/>

                            <Button x:Name="MediumBtn"
                                    Grid.Column="1"
                                    Text="Medium"
                                    Clicked="OnFontPresetClicked"
                                    CommandParameter="1"
                                    Pressed="OnButtonPressed"
                                    Released="OnButtonReleased"
                                    CornerRadius="14"/>

                            <Button x:Name="LargeBtn"
                                    Grid.Column="2"
                                    Text="Large"
                                    Clicked="OnFontPresetClicked"
                                    CommandParameter="2"
                                    Pressed="OnButtonPressed"
                                    Released="OnButtonReleased"
                                    CornerRadius="14"/>
                        </Grid>

                        <!-- Font size slider -->
                        <Slider x:Name="FontSlider"
                                Minimum="0"
                                Maximum="2"
                                ValueChanged="OnFontSliderChanged"/>

                        <Grid ColumnDefinitions="Auto,*">
                            <Label x:Name="SmallLabel" Text="Small"/>
                            <Label x:Name="LargeLabel" Grid.Column="1" Text="Large" HorizontalOptions="End"/>
                        </Grid>

                        <Label x:Name="PopupTitle2"
                               Text="Theme"
                               FontSize="14"
                               HorizontalTextAlignment="Center"
                               Margin="0,6,0,0"/>

                        <Grid ColumnDefinitions="*,*" ColumnSpacing="12">
                            <Button x:Name="LightBtn"
                                    Text="☀ Light"
                                    Clicked="OnThemeClicked"
                                    CommandParameter="Light"
                                    Pressed="OnButtonPressed"
                                    Released="OnButtonReleased"
                                    CornerRadius="14"/>

                            <Button x:Name="DarkBtn"
                                    Grid.Column="1"
                                    Text="☾ Dark"
                                    Clicked="OnThemeClicked"
                                    CommandParameter="Dark"
                                    Pressed="OnButtonPressed"
                                    Released="OnButtonReleased"
                                    CornerRadius="14"/>
                        </Grid>

                    </VerticalStackLayout>
                </ScrollView>

            </Border>

        </AbsoluteLayout>

        <!-- Bottom progress -->
        <Grid Grid.Row="2"
              Padding="18,0"
              ColumnDefinitions="*,Auto"
              VerticalOptions="Center">

            <ProgressBar x:Name="ReadingProgressBar"
                         Progress="0"
                         HeightRequest="2"
                         VerticalOptions="Center"/>

            <Label x:Name="ProgressText"
                   Grid.Column="1"
                   Text="1 of 1"
                   FontSize="12"
                   VerticalOptions="Center"
                   Margin="12,0,0,0"/>
        </Grid>

    </Grid>
</ContentPage>