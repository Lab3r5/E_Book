<?xml version="1.0" encoding="utf-8" ?>
<ContentPage
    xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
    xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
    xmlns:shell="http://schemas.microsoft.com/dotnet/2021/maui"
    xmlns:controls="clr-namespace:E_Book.Controls"
    x:Class="E_Book.Pages.PasswordPage"
    shell:Shell.TabBarIsVisible="False"
    shell:Shell.NavBarIsVisible="False"
    shell:Shell.PresentationMode="ModalAnimated"
    NavigationPage.HasNavigationBar="False"
    Padding="0"
    BackgroundColor="{AppThemeBinding Light=#F6F5FB, Dark=#121212}">

    <Grid RowDefinitions="Auto,*">

        <controls:AppHeader Title="Set Password"
                            BackCommand="{Binding BackCommand}" />

        <ScrollView Grid.Row="1"
                    VerticalScrollBarVisibility="Never">
            <VerticalStackLayout Padding="18,8,18,28"
                                 Spacing="16">

                <!-- Intro -->
                <VerticalStackLayout Spacing="3"
                                     Padding="2,0,2,0">
                    <Label Text="Security"
                           FontSize="13"
                           FontAttributes="Bold"
                           TextColor="{AppThemeBinding Light=#8A869E, Dark=#A9A4BB}" />

                    <Label Text="Update your account password"
                           FontSize="17"
                           FontAttributes="Bold"
                           TextColor="{AppThemeBinding Light=#221551, Dark=White}" />

                    <Label Text="Choose a new password to protect your account."
                           FontSize="12"
                           LineBreakMode="WordWrap"
                           TextColor="{AppThemeBinding Light=#8A869E, Dark=#B7B3C6}" />
                </VerticalStackLayout>

                <!-- Password Card -->
                <Border StrokeThickness="1"
                        Stroke="{AppThemeBinding Light=#EEEAF7, Dark=#2A2A31}"
                        StrokeShape="RoundRectangle 24"
                        Padding="16"
                        BackgroundColor="{AppThemeBinding Light=White, Dark=#1A1A1E}">

                    <VerticalStackLayout Spacing="0">

                        <Label Text="Password"
                               FontSize="14"
                               Margin="0,0,0,8"
                               TextColor="{AppThemeBinding Light=#8A869E, Dark=#AAA5BA}" />

                        <BoxView HeightRequest="1"
                                 Margin="0,8,0,8"
                                 BackgroundColor="{AppThemeBinding Light=#EEEAF7, Dark=#2A2A31}" />

                        <!-- New Password -->
                        <Grid Padding="0,10"
                              RowDefinitions="Auto,Auto"
                              ColumnDefinitions="*,Auto"
                              RowSpacing="8">

                            <VerticalStackLayout Grid.Row="0"
                                                 Grid.ColumnSpan="2"
                                                 Spacing="3">
                                <Label Text="New Password"
                                       FontSize="12"
                                       FontAttributes="Bold"
                                       TextColor="{AppThemeBinding Light=#9C97AE, Dark=#AAA5BA}" />
                                <Label Text="Enter your new account password"
                                       FontSize="11"
                                       LineBreakMode="WordWrap"
                                       TextColor="{AppThemeBinding Light=#B0ABBF, Dark=#878397}" />
                            </VerticalStackLayout>

                            <Border x:Name="PasswordInputBorder"
                                    Grid.Row="1"
                                    Grid.ColumnSpan="2"
                                    StrokeThickness="1"
                                    Stroke="{AppThemeBinding Light=#F1ECFB, Dark=#2D2D35}"
                                    StrokeShape="RoundRectangle 16"
                                    Padding="14,0"
                                    HeightRequest="48"
                                    BackgroundColor="{AppThemeBinding Light=#F7F4FF, Dark=#24242A}">

                                <Grid ColumnDefinitions="*,Auto"
                                      ColumnSpacing="8">

                                    <Entry x:Name="entryPassword"
                                           Placeholder="Please enter your password"
                                           PlaceholderColor="{AppThemeBinding Light=#B9B4C8, Dark=#8F8AA0}"
                                           TextColor="{AppThemeBinding Light=#221551, Dark=White}"
                                           FontSize="14"
                                           BackgroundColor="Transparent"
                                           IsPassword="True"
                                           TextChanged="OnPasswordFieldsChanged"
                                           VerticalOptions="Center" />

                                    <Label x:Name="TogglePasswordButton"
                                           Grid.Column="1"
                                           Text="Show"
                                           FontSize="13"
                                           FontAttributes="Bold"
                                           TextColor="#7A63FF"
                                           VerticalOptions="Center"
                                           VerticalTextAlignment="Center">
                                        <Label.GestureRecognizers>
                                            <TapGestureRecognizer Tapped="OnTogglePasswordTapped" />
                                        </Label.GestureRecognizers>
                                    </Label>
                                </Grid>
                            </Border>
                        </Grid>

                        <BoxView HeightRequest="1"
                                 Margin="0,10,0,10"
                                 BackgroundColor="{AppThemeBinding Light=#EEEAF7, Dark=#2A2A31}" />

                        <!-- Confirm Password -->
                        <Grid Padding="0,10"
                              RowDefinitions="Auto,Auto"
                              ColumnDefinitions="*,Auto"
                              RowSpacing="8">

                            <VerticalStackLayout Grid.Row="0"
                                                 Grid.ColumnSpan="2"
                                                 Spacing="3">
                                <Label Text="Confirm Password"
                                       FontSize="12"
                                       FontAttributes="Bold"
                                       TextColor="{AppThemeBinding Light=#9C97AE, Dark=#AAA5BA}" />
                                <Label Text="Repeat the new password to confirm it"
                                       FontSize="11"
                                       LineBreakMode="WordWrap"
                                       TextColor="{AppThemeBinding Light=#B0ABBF, Dark=#878397}" />
                            </VerticalStackLayout>

                            <Border x:Name="ConfirmPasswordInputBorder"
                                    Grid.Row="1"
                                    Grid.ColumnSpan="2"
                                    StrokeThickness="1"
                                    Stroke="{AppThemeBinding Light=#F1ECFB, Dark=#2D2D35}"
                                    StrokeShape="RoundRectangle 16"
                                    Padding="14,0"
                                    HeightRequest="48"
                                    BackgroundColor="{AppThemeBinding Light=#F7F4FF, Dark=#24242A}">

                                <Grid ColumnDefinitions="*,Auto"
                                      ColumnSpacing="8">

                                    <Entry x:Name="entryConfirmPassword"
                                           Placeholder="Please repeat your password"
                                           PlaceholderColor="{AppThemeBinding Light=#B9B4C8, Dark=#8F8AA0}"
                                           TextColor="{AppThemeBinding Light=#221551, Dark=White}"
                                           FontSize="14"
                                           BackgroundColor="Transparent"
                                           IsPassword="True"
                                           TextChanged="OnPasswordFieldsChanged"
                                           VerticalOptions="Center" />

                                    <Label x:Name="ToggleConfirmPasswordButton"
                                           Grid.Column="1"
                                           Text="Show"
                                           FontSize="13"
                                           FontAttributes="Bold"
                                           TextColor="#7A63FF"
                                           VerticalOptions="Center"
                                           VerticalTextAlignment="Center">
                                        <Label.GestureRecognizers>
                                            <TapGestureRecognizer Tapped="OnToggleConfirmPasswordTapped" />
                                        </Label.GestureRecognizers>
                                    </Label>
                                </Grid>
                            </Border>
                        </Grid>

                        <!-- Validation -->
                        <Label x:Name="ValidationMessageLabel"
                               Text=""
                               IsVisible="False"
                               FontSize="11.5"
                               Margin="2,10,2,0"
                               TextColor="#D95757" />

                        <!-- Tip -->
                        <Border StrokeThickness="0"
                                StrokeShape="RoundRectangle 16"
                                Padding="12,10"
                                Margin="0,12,0,0"
                                BackgroundColor="{AppThemeBinding Light=#F7F4FF, Dark=#24242A}">
                            <Label Text="Tip: Use something memorable but hard for others to guess."
                                   FontSize="11.5"
                                   LineBreakMode="WordWrap"
                                   TextColor="{AppThemeBinding Light=#8A869E, Dark=#B7B3C6}" />
                        </Border>

                    </VerticalStackLayout>
                </Border>

                <!-- Confirm Button -->
                <Button x:Name="ConfirmButton"
                        Text="Confirm"
                        HeightRequest="52"
                        CornerRadius="26"
                        FontSize="15"
                        FontAttributes="Bold"
                        TextColor="White"
                        BackgroundColor="#221551"
                        Opacity="0.5"
                        IsEnabled="False"
                        Margin="0,4,0,0"
                        Clicked="OnConfirmClicked" />

            </VerticalStackLayout>
        </ScrollView>

    </Grid>
</ContentPage>