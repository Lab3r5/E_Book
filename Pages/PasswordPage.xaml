<?xml version="1.0" encoding="utf-8" ?>
<ContentPage
    xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
    xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
    xmlns:shell="http://schemas.microsoft.com/dotnet/2021/maui"
    xmlns:controls="clr-namespace:E_Book.Controls"
    x:Class="E_Book.Pages.PasswordPage"
    shell:Shell.TabBarIsVisible="False"
    shell:Shell.NavBarIsVisible="False"
    shell:Shell.PresentationMode="ModalAnimated"
    NavigationPage.HasNavigationBar="False"
    Padding="0"
    BackgroundColor="{AppThemeBinding Light=#F6F5FB, Dark=#121212}">

    <Grid RowDefinitions="Auto,*">

        <controls:AppHeader Title="Set Password"
                            BackCommand="{Binding BackCommand}" />

        <ScrollView Grid.Row="1"
                    VerticalScrollBarVisibility="Never">
            <VerticalStackLayout Padding="18,6,18,20"
                                 Spacing="14">

                <!-- Intro -->
                <VerticalStackLayout Spacing="3"
                                     Padding="2,0,2,0">
                    <Label Text="Security"
                           FontSize="13"
                           FontAttributes="Bold"
                           TextColor="{AppThemeBinding Light=#8A869E, Dark=#A9A4BB}" />

                    <Label Text="Update your account password"
                           FontSize="16"
                           FontAttributes="Bold"
                           TextColor="{AppThemeBinding Light=#221551, Dark=White}" />

                    <Label Text="Keep your reading data and account settings protected."
                           FontSize="12"
                           LineBreakMode="WordWrap"
                           TextColor="{AppThemeBinding Light=#8A869E, Dark=#B7B3C6}" />
                </VerticalStackLayout>

                <!-- Password Section -->
                <VerticalStackLayout Spacing="8">
                    <Label Text="Password"
                           FontSize="13"
                           FontAttributes="Bold"
                           Margin="2,0,0,0"
                           TextColor="{AppThemeBinding Light=#8A869E, Dark=#A9A4BB}" />

                    <Border StrokeThickness="0"
                            StrokeShape="RoundRectangle 22"
                            Padding="14"
                            BackgroundColor="{AppThemeBinding Light=White, Dark=#1A1A1E}">

                        <VerticalStackLayout Spacing="12">

                            <!-- New Password -->
                            <VerticalStackLayout Spacing="6">
                                <Label Text="New Password"
                                       FontSize="14"
                                       FontAttributes="Bold"
                                       TextColor="{AppThemeBinding Light=#221551, Dark=White}" />

                                <Border x:Name="PasswordInputBorder"
                                        StrokeThickness="1"
                                        Stroke="{AppThemeBinding Light=#F1ECFB, Dark=#2D2D35}"
                                        StrokeShape="RoundRectangle 15"
                                        Padding="14,0"
                                        HeightRequest="46"
                                        BackgroundColor="{AppThemeBinding Light=#F7F4FF, Dark=#24242A}">

                                    <Grid ColumnDefinitions="*,Auto"
                                          ColumnSpacing="8">

                                        <Entry x:Name="entryPassword"
                                               Placeholder="Please enter your password"
                                               PlaceholderColor="{AppThemeBinding Light=#B9B4C8, Dark=#8F8AA0}"
                                               TextColor="{AppThemeBinding Light=#221551, Dark=White}"
                                               FontSize="13"
                                               BackgroundColor="Transparent"
                                               IsPassword="True"
                                               TextChanged="OnPasswordFieldsChanged"
                                               VerticalOptions="Center" />

                                        <Label x:Name="TogglePasswordButton"
                                               Grid.Column="1"
                                               Text="Show"
                                               FontSize="13"
                                               FontAttributes="Bold"
                                               TextColor="#7A63FF"
                                               VerticalOptions="Center"
                                               VerticalTextAlignment="Center">
                                            <Label.GestureRecognizers>
                                                <TapGestureRecognizer Tapped="OnTogglePasswordTapped" />
                                            </Label.GestureRecognizers>
                                        </Label>
                                    </Grid>
                                </Border>
                            </VerticalStackLayout>

                            <!-- Confirm Password -->
                            <VerticalStackLayout Spacing="6">
                                <Label Text="Confirm Password"
                                       FontSize="14"
                                       FontAttributes="Bold"
                                       TextColor="{AppThemeBinding Light=#221551, Dark=White}" />

                                <Border x:Name="ConfirmPasswordInputBorder"
                                        StrokeThickness="1"
                                        Stroke="{AppThemeBinding Light=#F1ECFB, Dark=#2D2D35}"
                                        StrokeShape="RoundRectangle 15"
                                        Padding="14,0"
                                        HeightRequest="46"
                                        BackgroundColor="{AppThemeBinding Light=#F7F4FF, Dark=#24242A}">

                                    <Grid ColumnDefinitions="*,Auto"
                                          ColumnSpacing="8">

                                        <Entry x:Name="entryConfirmPassword"
                                               Placeholder="Please repeat your password"
                                               PlaceholderColor="{AppThemeBinding Light=#B9B4C8, Dark=#8F8AA0}"
                                               TextColor="{AppThemeBinding Light=#221551, Dark=White}"
                                               FontSize="13"
                                               BackgroundColor="Transparent"
                                               IsPassword="True"
                                               TextChanged="OnPasswordFieldsChanged"
                                               VerticalOptions="Center" />

                                        <Label x:Name="ToggleConfirmPasswordButton"
                                               Grid.Column="1"
                                               Text="Show"
                                               FontSize="13"
                                               FontAttributes="Bold"
                                               TextColor="#7A63FF"
                                               VerticalOptions="Center"
                                               VerticalTextAlignment="Center">
                                            <Label.GestureRecognizers>
                                                <TapGestureRecognizer Tapped="OnToggleConfirmPasswordTapped" />
                                            </Label.GestureRecognizers>
                                        </Label>
                                    </Grid>
                                </Border>
                            </VerticalStackLayout>

                            <!-- Validation message -->
                            <Label x:Name="ValidationMessageLabel"
                                   Text=""
                                   IsVisible="False"
                                   FontSize="11"
                                   Margin="2,0,2,0"
                                   TextColor="#D95757" />

                            <!-- Subtle tip -->
                            <Border StrokeThickness="0"
                                    StrokeShape="RoundRectangle 14"
                                    Padding="12,9"
                                    BackgroundColor="{AppThemeBinding Light=#FAF8FF, Dark=#23232A}">
                                <Label Text="Tip: Use something memorable but hard for others to guess."
                                       FontSize="11"
                                       LineBreakMode="WordWrap"
                                       TextColor="{AppThemeBinding Light=#8A869E, Dark=#B7B3C6}" />
                            </Border>

                        </VerticalStackLayout>
                    </Border>
                </VerticalStackLayout>

                <!-- Confirm Button -->
                <Button x:Name="ConfirmButton"
                        Text="Confirm"
                        HeightRequest="50"
                        CornerRadius="25"
                        FontSize="15"
                        FontAttributes="Bold"
                        TextColor="White"
                        BackgroundColor="#221551"
                        Opacity="0.45"
                        IsEnabled="False"
                        Margin="0,4,0,0"
                        Clicked="OnConfirmClicked" />

            </VerticalStackLayout>
        </ScrollView>

    </Grid>
</ContentPage>