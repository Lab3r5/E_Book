<?xml version="1.0" encoding="utf-8" ?>
<ContentPage xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             xmlns:shell="http://schemas.microsoft.com/dotnet/2021/maui"
             x:Class="E_Book.Pages.BookshelfPage"
             x:Name="BookshelfPageRoot"
             shell:Shell.NavBarIsVisible="False"
             BackgroundColor="#F7F6FB">

    <Grid RowDefinitions="Auto,*"
          Padding="24,18">

        <!-- Title -->
        <Label Grid.Row="0"
               Text="My Library"
               FontSize="26"
               FontAttributes="Bold"
               TextColor="#2B2452"
               HorizontalTextAlignment="Center"
               Margin="0,10,0,14"/>

        <!-- Main white rounded container (包含列表 + Add Book 按钮) -->
        <Frame Grid.Row="1"
               BackgroundColor="White"
               CornerRadius="28"
               Padding="18"
               HasShadow="True"
               Margin="0,0,0,18">

            <Grid RowDefinitions="*,Auto">

                <!-- File list -->
                <CollectionView Grid.Row="0"
                                ItemsSource="{Binding Books}"
                                SelectionMode="None">

                    <!-- Empty State -->
                    <CollectionView.EmptyView>
                        <Grid VerticalOptions="Center"
                              HorizontalOptions="Center">
                            <VerticalStackLayout Spacing="10"
                                                 HorizontalOptions="Center"
                                                 VerticalOptions="Center">

                                <!-- 可选：放一张空状态图标到 Resources/Images/Library-Empty.png -->
                                <!--<Image Source="Library-Empty.png"
                                       HeightRequest="70"
                                       WidthRequest="70"
                                       Opacity="0.9"/>-->

                                <Label Text="No books available"
                                       FontSize="16"
                                       TextColor="#9A97A6"
                                       HorizontalTextAlignment="Center"/>
                            </VerticalStackLayout>
                        </Grid>
                    </CollectionView.EmptyView>

                    <CollectionView.ItemTemplate>
                        <DataTemplate>
                            <Frame CornerRadius="18"
                                   Padding="14,10"
                                   Margin="0,0,0,12"
                                   HasShadow="False"
                                   BorderColor="#EFEAFB"
                                   BackgroundColor="#FFFFFF">

                                <Grid ColumnDefinitions="*,Auto,Auto"
                                      ColumnSpacing="10">

                                    <!-- File name + format -->
                                    <VerticalStackLayout Grid.Column="0"
                                                         Spacing="2"
                                                         VerticalOptions="Center">
                                        <Label Text="{Binding FileName}"
                                               FontSize="16"
                                               TextColor="#2B2452"
                                               LineBreakMode="TailTruncation" />
                                        <Label Text="{Binding Format}"
                                               FontSize="11"
                                               TextColor="#9A97A6" />
                                    </VerticalStackLayout>

                                    <!-- Read -->
                                    <Button Grid.Column="1"
                                            Text="Read"
                                            FontSize="14"
                                            Padding="18,10"
                                            CornerRadius="12"
                                            BackgroundColor="#7A63FF"
                                            TextColor="White"
                                            Clicked="OnFileClicked"
                                            CommandParameter="{Binding .}"
                                            VerticalOptions="Center" />

                                    <!-- Delete -->
                                    <Button Grid.Column="2"
                                            Text="X"
                                            FontSize="14"
                                            Padding="18,10"
                                            CornerRadius="12"
                                            BackgroundColor="#FF6B6B"
                                            TextColor="White"
                                            Clicked="OnDeleteFileClicked"
                                            CommandParameter="{Binding .}"
                                            VerticalOptions="Center" />
                                </Grid>
                            </Frame>
                        </DataTemplate>
                    </CollectionView.ItemTemplate>
                </CollectionView>

                <!-- Add Book (包在白色圆角容器里) -->
                <Button Grid.Row="1"
                        Text="Add Book"
                        FontSize="22"
                        FontAttributes="Bold"
                        HeightRequest="64"
                        CornerRadius="26"
                        BackgroundColor="#E7E2FF"
                        TextColor="#2B2452"
                        Clicked="OnAddFileClicked"
                        Margin="10,16,10,6"/>
            </Grid>
        </Frame>
    </Grid>

</ContentPage>