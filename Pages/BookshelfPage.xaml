<?xml version="1.0" encoding="utf-8" ?>
<ContentPage xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             x:Class="E_Book.Pages.BookshelfPage">

    <Grid RowDefinitions="*, Auto" Padding="10">

        <!-- Main content area -->
        <Grid Row="0" RowDefinitions="Auto, *" ColumnDefinitions="Auto, *">

            <!-- ➕ Add file -->
            <Button Grid.Row="0" Grid.Column="0"
                    Text="➕"
                    Clicked="OnAddFileClicked"
                    FontSize="20"
                    Padding="10"/>

            <!-- Reserved for search bar / future -->
            <ContentView Grid.Row="0" Grid.Column="1"/>

            <!-- File list -->
            <CollectionView Grid.Row="1" Grid.ColumnSpan="2"
                            ItemsSource="{Binding Books}">
                <CollectionView.ItemTemplate>
                    <DataTemplate>
                        <Border Stroke="Black" StrokeThickness="1"
                                Padding="10" Margin="5" Background="White">
                            <StackLayout Orientation="Horizontal"
                                         HorizontalOptions="FillAndExpand">

                                <!-- File name + format -->
                                <VerticalStackLayout HorizontalOptions="StartAndExpand" Spacing="2">
                                    <Label Text="{Binding FileName}"
                                           FontSize="16"
                                           LineBreakMode="TailTruncation" />
                                    <Label Text="{Binding Format}"
                                           FontSize="11"
                                           Opacity="0.7" />
                                </VerticalStackLayout>

                                <!-- Delete -->
                                <Button Text="🗑️"
                                        Clicked="OnDeleteFileClicked"
                                        CommandParameter="{Binding .}"
                                        VerticalOptions="Center" />

                                <!-- Read -->
                                <Button Text="📖"
                                        Clicked="OnFileClicked"
                                        CommandParameter="{Binding .}"
                                        VerticalOptions="Center" />
                            </StackLayout>
                        </Border>
                    </DataTemplate>
                </CollectionView.ItemTemplate>
            </CollectionView>
        </Grid>
        
    </Grid>
</ContentPage>