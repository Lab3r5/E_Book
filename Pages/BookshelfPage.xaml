<?xml version="1.0" encoding="utf-8" ?>
<ContentPage xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             xmlns:shell="http://schemas.microsoft.com/dotnet/2021/maui"
             x:Class="E_Book.Pages.BookshelfPage"
             x:Name="BookshelfPageRoot"
             shell:Shell.NavBarIsVisible="False"
             BackgroundColor="{AppThemeBinding Light={StaticResource PageBackground}, Dark={StaticResource OffBlack}}">

    <Grid RowDefinitions="Auto,*"
          Padding="24,18">

        <!-- Title -->
        <Label Grid.Row="0"
               Text="My Library"
               FontSize="26"
               FontAttributes="Bold"
               TextColor="{AppThemeBinding Light={StaticResource PrimaryDarkText}, Dark={StaticResource White}}"
               HorizontalTextAlignment="Center"
               Margin="0,10,0,14"/>

        <!-- Main rounded container -->
        <Frame Grid.Row="1"
               BackgroundColor="{AppThemeBinding Light={StaticResource CardBackground}, Dark={StaticResource Gray950}}"
               CornerRadius="28"
               Padding="18"
               HasShadow="True"
               Margin="0,0,0,18">

            <Grid RowDefinitions="*,Auto">

                <!-- File list -->
                <CollectionView Grid.Row="0"
                                ItemsSource="{Binding Books}"
                                SelectionMode="None">

                    <CollectionView.EmptyView>
                        <Grid VerticalOptions="Center"
                              HorizontalOptions="Center">
                            <VerticalStackLayout Spacing="10"
                                                 HorizontalOptions="Center"
                                                 VerticalOptions="Center">
                                <Label Text="No books available"
                                       FontSize="16"
                                       TextColor="{AppThemeBinding Light={StaticResource Gray500}, Dark={StaticResource Gray400}}"
                                       HorizontalTextAlignment="Center"/>
                            </VerticalStackLayout>
                        </Grid>
                    </CollectionView.EmptyView>

                    <CollectionView.ItemTemplate>
                        <DataTemplate>
                            <Frame CornerRadius="18"
                                   Padding="14,10"
                                   Margin="0,0,0,12"
                                   HasShadow="False"
                                   BorderColor="{AppThemeBinding Light={StaticResource Gray200}, Dark={StaticResource Gray700}}"
                                   BackgroundColor="{AppThemeBinding Light={StaticResource White}, Dark={StaticResource Gray900}}">

                                <Grid ColumnDefinitions="*,Auto,Auto"
                                      ColumnSpacing="10">

                                    <VerticalStackLayout Grid.Column="0"
                                                         Spacing="2"
                                                         VerticalOptions="Center">
                                        <Label Text="{Binding FileName}"
                                               FontSize="16"
                                               TextColor="{AppThemeBinding Light={StaticResource PrimaryDarkText}, Dark={StaticResource White}}"
                                               LineBreakMode="TailTruncation" />
                                        <Label Text="{Binding Format}"
                                               FontSize="11"
                                               TextColor="{AppThemeBinding Light={StaticResource Gray500}, Dark={StaticResource Gray400}}" />
                                    </VerticalStackLayout>

                                    <Button Grid.Column="1"
                                            Text="Read"
                                            FontSize="14"
                                            Padding="18,10"
                                            CornerRadius="12"
                                            BackgroundColor="#7A63FF"
                                            TextColor="White"
                                            Clicked="OnFileClicked"
                                            CommandParameter="{Binding .}"
                                            VerticalOptions="Center" />

                                    <Button Grid.Column="2"
                                            Text="DEL"
                                            FontSize="14"
                                            Padding="18,10"
                                            CornerRadius="12"
                                            BackgroundColor="#FF6B6B"
                                            TextColor="White"
                                            Clicked="OnDeleteFileClicked"
                                            CommandParameter="{Binding .}"
                                            VerticalOptions="Center" />
                                </Grid>
                            </Frame>
                        </DataTemplate>
                    </CollectionView.ItemTemplate>
                </CollectionView>

                <!-- Add Book -->
                <Button Grid.Row="1"
                        Text="Add Book"
                        FontSize="22"
                        FontAttributes="Bold"
                        HeightRequest="64"
                        CornerRadius="26"
                        BackgroundColor="{AppThemeBinding Light={StaticResource Secondary}, Dark={StaticResource Gray900}}"
                        TextColor="{AppThemeBinding Light={StaticResource PrimaryDarkText}, Dark={StaticResource White}}"
                        Clicked="OnAddFileClicked"
                        Margin="10,16,10,6"/>
            </Grid>
        </Frame>
    </Grid>

</ContentPage>