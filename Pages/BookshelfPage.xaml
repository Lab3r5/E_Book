<?xml version="1.0" encoding="utf-8" ?>
<ContentPage xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             xmlns:shell="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:toolkit="http://schemas.microsoft.com/dotnet/2022/maui/toolkit"
             x:Class="E_Book.Pages.BookshelfPage"
             x:Name="BookshelfPageRoot"
             shell:Shell.NavBarIsVisible="False"
             BackgroundColor="{AppThemeBinding Light={StaticResource PageBackground}, Dark={StaticResource OffBlack}}">

    <!-- ✅ RootHost 无 Padding，Overlay 才能真正全屏居中 -->
    <Grid x:Name="RootHost"
          HorizontalOptions="Fill"
          VerticalOptions="Fill">

        <!-- =========================
             MAIN PAGE CONTENT (with padding)
             ========================= -->
        <Grid x:Name="RootGrid"
              RowDefinitions="Auto,*"
              Padding="24,18">

            <!-- Header -->
            <Grid Grid.Row="0"
                  ColumnDefinitions="Auto,*,Auto,Auto"
                  Margin="0,10,0,14"
                  VerticalOptions="Center">

                <!-- Select All (multi-select only) -->
                <Button Grid.Column="0"
                        x:Name="SelectAllButton"
                        Text="Select All"
                        FontSize="14"
                        FontAttributes="Bold"
                        BackgroundColor="Transparent"
                        TextColor="{AppThemeBinding Light={StaticResource PrimaryDarkText}, Dark={StaticResource White}}"
                        Padding="0"
                        Clicked="OnSelectAllClicked"
                        IsVisible="{Binding Source={x:Reference BookshelfPageRoot}, Path=IsMultiSelectMode}" />

                <!-- Title -->
                <Label Grid.Column="1"
                       Text="My Library"
                       FontSize="26"
                       FontAttributes="Bold"
                       TextColor="{AppThemeBinding Light={StaticResource PrimaryDarkText}, Dark={StaticResource White}}"
                       HorizontalTextAlignment="Center"
                       VerticalTextAlignment="Center" />

                <!-- Cancel (multi-select only) -->
                <Button Grid.Column="2"
                        Text="Cancel"
                        FontSize="14"
                        FontAttributes="Bold"
                        BackgroundColor="Transparent"
                        TextColor="{AppThemeBinding Light={StaticResource PrimaryDarkText}, Dark={StaticResource White}}"
                        Padding="0"
                        Clicked="OnCancelMultiSelectClicked"
                        IsVisible="{Binding Source={x:Reference BookshelfPageRoot}, Path=IsMultiSelectMode}" />

                <!-- Right area -->
                <Grid Grid.Column="3"
                      HorizontalOptions="End"
                      VerticalOptions="Center">

                    <!-- Trash (normal mode only) -->
                    <Frame x:Name="TrashButton"
                           HeightRequest="40"
                           WidthRequest="40"
                           CornerRadius="20"
                           Padding="0"
                           HasShadow="False"
                           BackgroundColor="{AppThemeBinding Light={StaticResource DangerLightRed}, Dark={StaticResource DangerDarkRed}}">

                        <Label Text="🗑"
                               FontSize="18"
                               TextColor="White"
                               HorizontalOptions="Center"
                               VerticalOptions="Center">
                            <Label.GestureRecognizers>
                                <TapGestureRecognizer Tapped="OnTrashTapped"/>
                            </Label.GestureRecognizers>
                        </Label>

                        <Frame.Triggers>
                            <DataTrigger TargetType="Frame"
                                         Binding="{Binding Source={x:Reference BookshelfPageRoot}, Path=IsMultiSelectMode}"
                                         Value="True">
                                <Setter Property="IsVisible" Value="False" />
                            </DataTrigger>
                        </Frame.Triggers>
                    </Frame>

                    <!-- Confirm (multi-select only) -->
                    <Frame x:Name="ConfirmButton"
                           HeightRequest="40"
                           WidthRequest="40"
                           CornerRadius="20"
                           Padding="0"
                           HasShadow="False"
                           BackgroundColor="#34C759"
                           IsVisible="False"
                           Opacity="1">

                        <Label Text="✓"
                               FontSize="20"
                               FontAttributes="Bold"
                               TextColor="White"
                               HorizontalOptions="Center"
                               VerticalOptions="Center">
                            <Label.GestureRecognizers>
                                <TapGestureRecognizer Tapped="OnConfirmTapped"/>
                            </Label.GestureRecognizers>
                        </Label>

                        <Frame.Triggers>
                            <DataTrigger TargetType="Frame"
                                         Binding="{Binding Source={x:Reference BookshelfPageRoot}, Path=IsMultiSelectMode}"
                                         Value="True">
                                <Setter Property="IsVisible" Value="True" />
                            </DataTrigger>
                        </Frame.Triggers>
                    </Frame>

                </Grid>
            </Grid>

            <!-- Main container -->
            <Frame Grid.Row="1"
                   BackgroundColor="{AppThemeBinding Light={StaticResource CardBackground}, Dark={StaticResource Gray950}}"
                   CornerRadius="28"
                   Padding="18"
                   HasShadow="True"
                   Margin="0,0,0,18">

                <Grid RowDefinitions="*,Auto">

                    <CollectionView Grid.Row="0"
                                    ItemsSource="{Binding Books}"
                                    SelectionMode="None">

                        <CollectionView.EmptyView>
                            <Grid VerticalOptions="Center" HorizontalOptions="Center">
                                <VerticalStackLayout Spacing="10"
                                                     HorizontalOptions="Center"
                                                     VerticalOptions="Center">
                                    <Label Text="No books available"
                                           FontSize="16"
                                           TextColor="{AppThemeBinding Light={StaticResource Gray500}, Dark={StaticResource Gray400}}"
                                           HorizontalTextAlignment="Center"/>
                                </VerticalStackLayout>
                            </Grid>
                        </CollectionView.EmptyView>

                        <CollectionView.ItemTemplate>
                            <DataTemplate>

                                <!-- Swipe delete -->
                                <SwipeView>
                                    <SwipeView.RightItems>
                                        <SwipeItems Mode="Reveal">
                                            <SwipeItem Text="Delete"
                                                       BackgroundColor="{AppThemeBinding Light={StaticResource DangerLightRed}, Dark={StaticResource DangerDarkRed}}"
                                                       Invoked="OnSwipeDelete"
                                                       CommandParameter="{Binding .}" />
                                        </SwipeItems>
                                    </SwipeView.RightItems>

                                    <!-- Card -->
                                    <Frame CornerRadius="18"
                                           Padding="14,10"
                                           Margin="0,0,0,12"
                                           HasShadow="False"
                                           BorderColor="{AppThemeBinding Light={StaticResource Gray200}, Dark={StaticResource Gray700}}"
                                           BackgroundColor="{AppThemeBinding Light={StaticResource White}, Dark={StaticResource Gray900}}">

                                        <!-- ✅ 关键：手势只放左侧内容区域，避免 Read 点不进去 -->
                                        <Grid ColumnDefinitions="Auto,*,Auto"
                                              ColumnSpacing="10">

                                            <!-- Checkbox (multi-select only) -->
                                            <CheckBox Grid.Column="0"
                                                      IsChecked="{Binding IsSelected}"
                                                      VerticalOptions="Center"
                                                      IsVisible="False">
                                                <CheckBox.Triggers>
                                                    <DataTrigger TargetType="CheckBox"
                                                                 Binding="{Binding Source={x:Reference BookshelfPageRoot}, Path=IsMultiSelectMode}"
                                                                 Value="True">
                                                        <Setter Property="IsVisible" Value="True" />
                                                    </DataTrigger>
                                                </CheckBox.Triggers>
                                            </CheckBox>

                                            <!-- Left content area (tap + longpress) -->
                                            <Grid Grid.Column="1"
                                                  VerticalOptions="Center">
                                                <Grid.Behaviors>
                                                    <toolkit:TouchBehavior LongPressCommand="{Binding Source={x:Reference BookshelfPageRoot}, Path=LongPressCommand}"
                                                                           LongPressCommandParameter="{Binding .}"
                                                                           LongPressDuration="450" />
                                                </Grid.Behaviors>
                                                <Grid.GestureRecognizers>
                                                    <TapGestureRecognizer Tapped="OnItemTapped"
                                                                          CommandParameter="{Binding .}" />
                                                </Grid.GestureRecognizers>

                                                <VerticalStackLayout Spacing="2"
                                                                     VerticalOptions="Center">
                                                    <Label Text="{Binding FileName}"
                                                           FontSize="16"
                                                           TextColor="{AppThemeBinding Light={StaticResource PrimaryDarkText}, Dark={StaticResource White}}"
                                                           LineBreakMode="TailTruncation" />
                                                    <Label Text="{Binding Format}"
                                                           FontSize="11"
                                                           TextColor="{AppThemeBinding Light={StaticResource Gray500}, Dark={StaticResource Gray400}}" />
                                                </VerticalStackLayout>
                                            </Grid>

                                            <!-- Read (normal mode only) -->
                                            <Button Grid.Column="2"
                                                    Text="📖"
                                                    FontSize="18"
                                                    Padding="16,10"
                                                    CornerRadius="12"
                                                    TextColor="White"
                                                    BackgroundColor="{AppThemeBinding Light={StaticResource ReadLightPurple}, Dark={StaticResource ReadDarkPurple}}"
                                                    Clicked="OnFileClicked"
                                                    CommandParameter="{Binding .}"
                                                    VerticalOptions="Center"
                                                    IsVisible="True">
                                                <Button.Triggers>
                                                    <DataTrigger TargetType="Button"
                                                                 Binding="{Binding Source={x:Reference BookshelfPageRoot}, Path=IsMultiSelectMode}"
                                                                 Value="True">
                                                        <Setter Property="IsVisible" Value="False" />
                                                    </DataTrigger>
                                                </Button.Triggers>
                                            </Button>

                                        </Grid>
                                    </Frame>
                                </SwipeView>

                            </DataTemplate>
                        </CollectionView.ItemTemplate>
                    </CollectionView>

                    <!-- Add Book -->
                    <Button Grid.Row="1"
                            Text="Add Book"
                            FontSize="22"
                            FontAttributes="Bold"
                            HeightRequest="64"
                            CornerRadius="26"
                            BackgroundColor="{AppThemeBinding Light={StaticResource Secondary}, Dark={StaticResource Gray900}}"
                            TextColor="{AppThemeBinding Light={StaticResource PrimaryDarkText}, Dark={StaticResource White}}"
                            Clicked="OnAddFileClicked"
                            Margin="10,16,10,6"/>
                </Grid>
            </Frame>

        </Grid>

        <!-- =========================
             TOAST (outside padding)
             ========================= -->
        <Frame x:Name="ToastFrame"
               ZIndex="900"
               IsVisible="False"
               Opacity="0"
               CornerRadius="14"
               Padding="12,10"
               HasShadow="True"
               BackgroundColor="#1F1F1F"
               HorizontalOptions="Center"
               VerticalOptions="End"
               Margin="0,0,0,28">
            <Label x:Name="ToastLabel"
                   Text=""
                   TextColor="White"
                   FontSize="13"
                   HorizontalTextAlignment="Center" />
        </Frame>

        <!-- =========================
             DELETE OVERLAY (true full-screen center)
             ========================= -->
        <Grid x:Name="DeleteOverlay"
              ZIndex="999"
              IsVisible="False"
              HorizontalOptions="Fill"
              VerticalOptions="Fill"
              InputTransparent="False">

            <!-- Background mask (tap to close) -->
            <BoxView BackgroundColor="#80000000"
                     HorizontalOptions="Fill"
                     VerticalOptions="Fill">
                <BoxView.GestureRecognizers>
                    <TapGestureRecognizer Tapped="OnCancelDeleteDialog"/>
                </BoxView.GestureRecognizers>
            </BoxView>

            <!-- Center dialog -->
            <Frame x:Name="DeleteDialog"
                   WidthRequest="320"
                   CornerRadius="26"
                   Padding="28"
                   BackgroundColor="{AppThemeBinding Light=White, Dark=#1C1C1E}"
                   HasShadow="True"
                   Opacity="0"
                   Scale="0.85"
                   HorizontalOptions="Center"
                   VerticalOptions="Center"
                   TranslationY="18"
                   TranslationX="22"
                   InputTransparent="False">

                <VerticalStackLayout Spacing="18">

                    <Frame HeightRequest="56"
                           WidthRequest="56"
                           CornerRadius="28"
                           Padding="0"
                           HorizontalOptions="Center"
                           BackgroundColor="{AppThemeBinding Light={StaticResource DangerLightRed}, Dark={StaticResource DangerDarkRed}}"
                           HasShadow="False">
                        <Label Text="🗑"
                               FontSize="24"
                               TextColor="White"
                               HorizontalOptions="Center"
                               VerticalOptions="Center"/>
                    </Frame>

                    <Label x:Name="DeleteTitle"
                           Text="Delete?"
                           FontSize="18"
                           FontAttributes="Bold"
                           HorizontalTextAlignment="Center"
                           TextColor="{AppThemeBinding Light=Black, Dark=White}" />

                    <Label x:Name="DeleteMessage"
                           Text="This action cannot be undone."
                           FontSize="14"
                           HorizontalTextAlignment="Center"
                           TextColor="{AppThemeBinding Light=#666666, Dark=#AAAAAA}" />

                    <!-- ✅ 按你要求：Delete/Cancel 换位（Delete 左，Cancel 右） -->
                    <Grid ColumnDefinitions="*,*"
                          ColumnSpacing="14">

                        <Button Grid.Column="0"
                                Text="Cancel"
                                CornerRadius="14"
                                BackgroundColor="{AppThemeBinding Light=#F2F2F2, Dark=#2C2C2E}"
                                TextColor="{AppThemeBinding Light=Black, Dark=White}"
                                Clicked="OnCancelDeleteDialog"/>

                        <Button Grid.Column="1"
                                Text="Delete"
                                CornerRadius="14"
                                BackgroundColor="{AppThemeBinding Light={StaticResource DangerLightRed}, Dark={StaticResource DangerDarkRed}}"
                                TextColor="White"
                                Clicked="OnConfirmDeleteDialog"/>

                    </Grid>

                </VerticalStackLayout>
            </Frame>
        </Grid>

    </Grid>
</ContentPage>