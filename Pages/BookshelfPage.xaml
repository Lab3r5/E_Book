<?xml version="1.0" encoding="utf-8" ?>
<ContentPage xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             xmlns:shell="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:toolkit="http://schemas.microsoft.com/dotnet/2022/maui/toolkit"
             x:Class="E_Book.Pages.BookshelfPage"
             x:Name="BookshelfPageRoot"
             shell:Shell.NavBarIsVisible="False"
             BackgroundColor="{AppThemeBinding Light={StaticResource PageBackground}, Dark={StaticResource OffBlack}}">

    <Grid x:Name="RootHost"
          HorizontalOptions="Fill"
          VerticalOptions="Fill"
          Opacity="0">

        <Grid x:Name="RootGrid"
              RowDefinitions="Auto,*"
              Padding="24,18">

            <!-- Header -->
            <Grid x:Name="HeaderSection"
                  Grid.Row="0"
                  ColumnDefinitions="108,*,Auto,*,108"
                  Margin="0,2,0,10"
                  VerticalOptions="Center"
                  Opacity="0"
                  TranslationY="-16">

                <Border x:Name="CancelChip"
                        Grid.Column="0"
                        Padding="12,7"
                        StrokeThickness="0"
                        BackgroundColor="{AppThemeBinding Light=#F3F1FA, Dark=#24242C}"
                        HorizontalOptions="Start"
                        VerticalOptions="Center"
                        IsVisible="{Binding Source={x:Reference BookshelfPageRoot}, Path=IsMultiSelectMode}">
                    <Border.StrokeShape>
                        <RoundRectangle CornerRadius="14" />
                    </Border.StrokeShape>
                    <Border.GestureRecognizers>
                        <TapGestureRecognizer Tapped="OnCancelMultiSelectClicked"/>
                    </Border.GestureRecognizers>
                    <Label Text="Cancel"
                           FontSize="13"
                           FontAttributes="Bold"
                           TextColor="{AppThemeBinding Light={StaticResource PrimaryDarkText}, Dark={StaticResource White}}"
                           HorizontalOptions="Center"
                           VerticalOptions="Center"/>
                </Border>

                <Label x:Name="NormalTitleLabel"
                       Grid.Column="2"
                       Text="My Library"
                       FontFamily="Pacifico"
                       FontSize="34"
                       HorizontalTextAlignment="Center"
                       VerticalTextAlignment="Center"
                       HorizontalOptions="Center"
                       Margin="0"
                       TextColor="{AppThemeBinding Light={StaticResource PrimaryDarkText}, Dark={StaticResource White}}">
                    <Label.Triggers>
                        <DataTrigger TargetType="Label"
                                     Binding="{Binding Source={x:Reference BookshelfPageRoot}, Path=IsMultiSelectMode}"
                                     Value="True">
                            <Setter Property="IsVisible" Value="False"/>
                        </DataTrigger>
                    </Label.Triggers>
                </Label>

                <Border x:Name="MultiSelectTitleChip"
                        Grid.Column="2"
                        Padding="12,6"
                        StrokeThickness="0"
                        BackgroundColor="{AppThemeBinding Light=#F4F1FF, Dark=#24242C}"
                        HorizontalOptions="Center"
                        VerticalOptions="Center"
                        IsVisible="False">
                    <Border.StrokeShape>
                        <RoundRectangle CornerRadius="15" />
                    </Border.StrokeShape>

                    <Label Text="{Binding Source={x:Reference BookshelfPageRoot}, Path=SelectedCountText}"
                           FontSize="15"
                           FontAttributes="Bold"
                           HorizontalTextAlignment="Center"
                           VerticalTextAlignment="Center"
                           TextColor="{AppThemeBinding Light={StaticResource PrimaryDarkText}, Dark={StaticResource White}}" />

                    <Border.Triggers>
                        <DataTrigger TargetType="Border"
                                     Binding="{Binding Source={x:Reference BookshelfPageRoot}, Path=IsMultiSelectMode}"
                                     Value="True">
                            <Setter Property="IsVisible" Value="True"/>
                        </DataTrigger>
                        <DataTrigger TargetType="Border"
                                     Binding="{Binding Source={x:Reference BookshelfPageRoot}, Path=IsMultiSelectMode}"
                                     Value="False">
                            <Setter Property="IsVisible" Value="False"/>
                        </DataTrigger>
                    </Border.Triggers>
                </Border>

                <Border Grid.Column="4"
                        x:Name="TrashButton"
                        HeightRequest="44"
                        WidthRequest="44"
                        Padding="0"
                        StrokeThickness="0"
                        HorizontalOptions="End"
                        VerticalOptions="Center"
                        BackgroundColor="{AppThemeBinding Light={StaticResource DangerLightRed}, Dark={StaticResource DangerDarkRed}}">
                    <Border.StrokeShape>
                        <RoundRectangle CornerRadius="22" />
                    </Border.StrokeShape>

                    <Label Text="🗑"
                           FontSize="18"
                           TextColor="White"
                           HorizontalOptions="Center"
                           VerticalOptions="Center">
                        <Label.GestureRecognizers>
                            <TapGestureRecognizer Tapped="OnTrashTapped"/>
                        </Label.GestureRecognizers>
                    </Label>

                    <Border.Triggers>
                        <DataTrigger TargetType="Border"
                                     Binding="{Binding Source={x:Reference BookshelfPageRoot}, Path=IsMultiSelectMode}"
                                     Value="True">
                            <Setter Property="IsVisible" Value="False"/>
                        </DataTrigger>
                    </Border.Triggers>
                </Border>

                <Border Grid.Column="4"
                        x:Name="ConfirmButton"
                        HeightRequest="42"
                        WidthRequest="42"
                        Padding="0"
                        StrokeThickness="0"
                        HorizontalOptions="End"
                        VerticalOptions="Center"
                        BackgroundColor="#8FD8A2"
                        IsVisible="False"
                        Opacity="1">
                    <Border.StrokeShape>
                        <RoundRectangle CornerRadius="21" />
                    </Border.StrokeShape>

                    <Label Text="✓"
                           FontSize="22"
                           FontAttributes="Bold"
                           TextColor="White"
                           HorizontalOptions="Center"
                           VerticalOptions="Center">
                        <Label.GestureRecognizers>
                            <TapGestureRecognizer Tapped="OnConfirmTapped"/>
                        </Label.GestureRecognizers>
                    </Label>

                    <Border.Triggers>
                        <DataTrigger TargetType="Border"
                                     Binding="{Binding Source={x:Reference BookshelfPageRoot}, Path=IsMultiSelectMode}"
                                     Value="True">
                            <Setter Property="IsVisible" Value="True"/>
                        </DataTrigger>
                    </Border.Triggers>
                </Border>
            </Grid>

            <!-- Main container -->
            <Border x:Name="MainCard"
                    Grid.Row="1"
                    BackgroundColor="{AppThemeBinding Light={StaticResource CardBackground}, Dark={StaticResource Gray950}}"
                    Padding="16,16,16,12"
                    Margin="0,0,0,10"
                    Opacity="0"
                    TranslationY="26"
                    StrokeThickness="0">
                <Border.StrokeShape>
                    <RoundRectangle CornerRadius="28" />
                </Border.StrokeShape>

                <Grid RowDefinitions="Auto,*,Auto">

                    <!-- Bulk action row -->
                    <Grid Grid.Row="0"
                          IsVisible="{Binding Source={x:Reference BookshelfPageRoot}, Path=IsMultiSelectMode}"
                          Margin="0,0,0,8">

                        <Border x:Name="SelectAllChip"
                                Padding="11,6"
                                StrokeThickness="0"
                                BackgroundColor="{AppThemeBinding Light=#EEE8FF, Dark=#2A2340}"
                                HorizontalOptions="Start">
                            <Border.StrokeShape>
                                <RoundRectangle CornerRadius="13" />
                            </Border.StrokeShape>

                            <Border.GestureRecognizers>
                                <TapGestureRecognizer Tapped="OnSelectAllClicked"/>
                            </Border.GestureRecognizers>

                            <Label x:Name="SelectAllButton"
                                   Text="Select All"
                                   FontSize="12.5"
                                   FontAttributes="Bold"
                                   TextColor="{AppThemeBinding Light={StaticResource ReadLightPurple}, Dark={StaticResource ReadDarkPurple}}"
                                   HorizontalOptions="Center"
                                   VerticalOptions="Center" />
                        </Border>
                    </Grid>

                    <!-- Content Area -->
                    <Grid Grid.Row="1">

                        <!-- Skeleton Loading -->
                        <Grid x:Name="SkeletonContainer"
                              IsVisible="{Binding Source={x:Reference BookshelfPageRoot}, Path=IsLoadingBooks}">

                            <ScrollView VerticalScrollBarVisibility="Never">
                                <VerticalStackLayout Spacing="10"
                                                     Padding="0,2,0,4">

                                    <Border Stroke="{AppThemeBinding Light={StaticResource Gray200}, Dark={StaticResource Gray700}}"
                                            StrokeThickness="1"
                                            Padding="10"
                                            Margin="0,0,0,4"
                                            BackgroundColor="{AppThemeBinding Light={StaticResource White}, Dark={StaticResource Gray900}}">
                                        <Border.StrokeShape>
                                            <RoundRectangle CornerRadius="16" />
                                        </Border.StrokeShape>
                                        <Grid ColumnDefinitions="56,*,48"
                                              ColumnSpacing="10">
                                            <Border HeightRequest="56"
                                                    WidthRequest="56"
                                                    Padding="0"
                                                    StrokeThickness="0"
                                                    BackgroundColor="{AppThemeBinding Light=#EEEAF7, Dark=#2A2A31}">
                                                <Border.StrokeShape>
                                                    <RoundRectangle CornerRadius="12" />
                                                </Border.StrokeShape>
                                            </Border>
                                            <VerticalStackLayout Grid.Column="1"
                                                                 Spacing="6"
                                                                 VerticalOptions="Center">
                                                <BoxView HeightRequest="12" WidthRequest="170" CornerRadius="6"
                                                         Color="{AppThemeBinding Light=#ECE8F5, Dark=#2F2F36}" />
                                                <BoxView HeightRequest="9" WidthRequest="52" CornerRadius="5"
                                                         Color="{AppThemeBinding Light=#F1EDF8, Dark=#34343B}" />
                                                <BoxView HeightRequest="9" WidthRequest="118" CornerRadius="5"
                                                         Color="{AppThemeBinding Light=#F1EDF8, Dark=#34343B}" />
                                                <BoxView HeightRequest="8" WidthRequest="86" CornerRadius="5"
                                                         Color="{AppThemeBinding Light=#EEE8FF, Dark=#332B4A}" />
                                            </VerticalStackLayout>
                                            <Border Grid.Column="2"
                                                    HeightRequest="36"
                                                    WidthRequest="44"
                                                    Padding="0"
                                                    StrokeThickness="0"
                                                    BackgroundColor="{AppThemeBinding Light=#EDE7FF, Dark=#2E2850}">
                                                <Border.StrokeShape>
                                                    <RoundRectangle CornerRadius="10" />
                                                </Border.StrokeShape>
                                            </Border>
                                        </Grid>
                                    </Border>

                                    <Border Stroke="{AppThemeBinding Light={StaticResource Gray200}, Dark={StaticResource Gray700}}"
                                            StrokeThickness="1"
                                            Padding="10"
                                            Margin="0,0,0,4"
                                            BackgroundColor="{AppThemeBinding Light={StaticResource White}, Dark={StaticResource Gray900}}">
                                        <Border.StrokeShape>
                                            <RoundRectangle CornerRadius="16" />
                                        </Border.StrokeShape>
                                        <Grid ColumnDefinitions="56,*,48"
                                              ColumnSpacing="10">
                                            <Border HeightRequest="56"
                                                    WidthRequest="56"
                                                    Padding="0"
                                                    StrokeThickness="0"
                                                    BackgroundColor="{AppThemeBinding Light=#EEEAF7, Dark=#2A2A31}">
                                                <Border.StrokeShape>
                                                    <RoundRectangle CornerRadius="12" />
                                                </Border.StrokeShape>
                                            </Border>
                                            <VerticalStackLayout Grid.Column="1"
                                                                 Spacing="6"
                                                                 VerticalOptions="Center">
                                                <BoxView HeightRequest="12" WidthRequest="152" CornerRadius="6"
                                                         Color="{AppThemeBinding Light=#ECE8F5, Dark=#2F2F36}" />
                                                <BoxView HeightRequest="9" WidthRequest="48" CornerRadius="5"
                                                         Color="{AppThemeBinding Light=#F1EDF8, Dark=#34343B}" />
                                                <BoxView HeightRequest="9" WidthRequest="128" CornerRadius="5"
                                                         Color="{AppThemeBinding Light=#F1EDF8, Dark=#34343B}" />
                                            </VerticalStackLayout>
                                            <Border Grid.Column="2"
                                                    HeightRequest="36"
                                                    WidthRequest="44"
                                                    Padding="0"
                                                    StrokeThickness="0"
                                                    BackgroundColor="{AppThemeBinding Light=#EDE7FF, Dark=#2E2850}">
                                                <Border.StrokeShape>
                                                    <RoundRectangle CornerRadius="10" />
                                                </Border.StrokeShape>
                                            </Border>
                                        </Grid>
                                    </Border>

                                    <Border Stroke="{AppThemeBinding Light={StaticResource Gray200}, Dark={StaticResource Gray700}}"
                                            StrokeThickness="1"
                                            Padding="10"
                                            Margin="0,0,0,4"
                                            BackgroundColor="{AppThemeBinding Light={StaticResource White}, Dark={StaticResource Gray900}}">
                                        <Border.StrokeShape>
                                            <RoundRectangle CornerRadius="16" />
                                        </Border.StrokeShape>
                                        <Grid ColumnDefinitions="56,*,48"
                                              ColumnSpacing="10">
                                            <Border HeightRequest="56"
                                                    WidthRequest="56"
                                                    Padding="0"
                                                    StrokeThickness="0"
                                                    BackgroundColor="{AppThemeBinding Light=#EEEAF7, Dark=#2A2A31}">
                                                <Border.StrokeShape>
                                                    <RoundRectangle CornerRadius="12" />
                                                </Border.StrokeShape>
                                            </Border>
                                            <VerticalStackLayout Grid.Column="1"
                                                                 Spacing="6"
                                                                 VerticalOptions="Center">
                                                <BoxView HeightRequest="12" WidthRequest="182" CornerRadius="6"
                                                         Color="{AppThemeBinding Light=#ECE8F5, Dark=#2F2F36}" />
                                                <BoxView HeightRequest="9" WidthRequest="58" CornerRadius="5"
                                                         Color="{AppThemeBinding Light=#F1EDF8, Dark=#34343B}" />
                                                <BoxView HeightRequest="9" WidthRequest="138" CornerRadius="5"
                                                         Color="{AppThemeBinding Light=#F1EDF8, Dark=#34343B}" />
                                                <BoxView HeightRequest="8" WidthRequest="72" CornerRadius="5"
                                                         Color="{AppThemeBinding Light=#EEE8FF, Dark=#332B4A}" />
                                            </VerticalStackLayout>
                                            <Border Grid.Column="2"
                                                    HeightRequest="36"
                                                    WidthRequest="44"
                                                    Padding="0"
                                                    StrokeThickness="0"
                                                    BackgroundColor="{AppThemeBinding Light=#EDE7FF, Dark=#2E2850}">
                                                <Border.StrokeShape>
                                                    <RoundRectangle CornerRadius="10" />
                                                </Border.StrokeShape>
                                            </Border>
                                        </Grid>
                                    </Border>

                                    <Border Stroke="{AppThemeBinding Light={StaticResource Gray200}, Dark={StaticResource Gray700}}"
                                            StrokeThickness="1"
                                            Padding="10"
                                            Margin="0,0,0,4"
                                            BackgroundColor="{AppThemeBinding Light={StaticResource White}, Dark={StaticResource Gray900}}">
                                        <Border.StrokeShape>
                                            <RoundRectangle CornerRadius="16" />
                                        </Border.StrokeShape>
                                        <Grid ColumnDefinitions="56,*,48"
                                              ColumnSpacing="10">
                                            <Border HeightRequest="56"
                                                    WidthRequest="56"
                                                    Padding="0"
                                                    StrokeThickness="0"
                                                    BackgroundColor="{AppThemeBinding Light=#EEEAF7, Dark=#2A2A31}">
                                                <Border.StrokeShape>
                                                    <RoundRectangle CornerRadius="12" />
                                                </Border.StrokeShape>
                                            </Border>
                                            <VerticalStackLayout Grid.Column="1"
                                                                 Spacing="6"
                                                                 VerticalOptions="Center">
                                                <BoxView HeightRequest="12" WidthRequest="146" CornerRadius="6"
                                                         Color="{AppThemeBinding Light=#ECE8F5, Dark=#2F2F36}" />
                                                <BoxView HeightRequest="9" WidthRequest="54" CornerRadius="5"
                                                         Color="{AppThemeBinding Light=#F1EDF8, Dark=#34343B}" />
                                                <BoxView HeightRequest="9" WidthRequest="116" CornerRadius="5"
                                                         Color="{AppThemeBinding Light=#F1EDF8, Dark=#34343B}" />
                                            </VerticalStackLayout>
                                            <Border Grid.Column="2"
                                                    HeightRequest="36"
                                                    WidthRequest="44"
                                                    Padding="0"
                                                    StrokeThickness="0"
                                                    BackgroundColor="{AppThemeBinding Light=#EDE7FF, Dark=#2E2850}">
                                                <Border.StrokeShape>
                                                    <RoundRectangle CornerRadius="10" />
                                                </Border.StrokeShape>
                                            </Border>
                                        </Grid>
                                    </Border>

                                </VerticalStackLayout>
                            </ScrollView>

                            <BoxView x:Name="SkeletonShimmer"
                                     InputTransparent="True"
                                     Opacity="0.32"
                                     TranslationX="-420">
                                <BoxView.Background>
                                    <LinearGradientBrush StartPoint="0,0" EndPoint="1,0">
                                        <GradientStop Color="#00FFFFFF" Offset="0.0" />
                                        <GradientStop Color="#66FFFFFF" Offset="0.5" />
                                        <GradientStop Color="#00FFFFFF" Offset="1.0" />
                                    </LinearGradientBrush>
                                </BoxView.Background>
                            </BoxView>
                        </Grid>

                        <!-- Book list -->
                        <CollectionView x:Name="BookCollectionView"
                                        ItemsSource="{Binding Books}"
                                        SelectionMode="None"
                                        ItemSizingStrategy="MeasureFirstItem"
                                        Opacity="1">

                            <CollectionView.Triggers>
                                <DataTrigger TargetType="CollectionView"
                                             Binding="{Binding Source={x:Reference BookshelfPageRoot}, Path=IsLoadingBooks}"
                                             Value="True">
                                    <Setter Property="IsVisible" Value="False" />
                                </DataTrigger>
                                <DataTrigger TargetType="CollectionView"
                                             Binding="{Binding Source={x:Reference BookshelfPageRoot}, Path=IsLoadingBooks}"
                                             Value="False">
                                    <Setter Property="IsVisible" Value="True" />
                                </DataTrigger>
                            </CollectionView.Triggers>

                            <CollectionView.EmptyView>
                                <Grid x:Name="EmptyStateContainer"
                                      VerticalOptions="Center"
                                      HorizontalOptions="Center"
                                      Margin="20,0,20,20"
                                      Opacity="0"
                                      TranslationY="20">

                                    <VerticalStackLayout Spacing="14"
                                                         HorizontalOptions="Center"
                                                         VerticalOptions="Center">

                                        <Border HeightRequest="96"
                                                WidthRequest="96"
                                                Padding="0"
                                                StrokeThickness="0"
                                                BackgroundColor="{AppThemeBinding Light=#F3EEFF, Dark=#2A214F}"
                                                HorizontalOptions="Center">
                                            <Border.StrokeShape>
                                                <RoundRectangle CornerRadius="30" />
                                            </Border.StrokeShape>
                                            <Grid>
                                                <Label x:Name="EmptyIcon"
                                                       Text="📚"
                                                       FontSize="40"
                                                       HorizontalOptions="Center"
                                                       VerticalOptions="Center"/>
                                            </Grid>
                                        </Border>

                                        <Label Text="Your Library is Empty"
                                               FontSize="20"
                                               FontAttributes="Bold"
                                               HorizontalTextAlignment="Center"
                                               TextColor="{AppThemeBinding Light={StaticResource PrimaryDarkText}, Dark={StaticResource White}}" />

                                        <Label Text="Import your first book to start reading. On desktop you can also drag supported files into the app."
                                               FontSize="14"
                                               HorizontalTextAlignment="Center"
                                               LineBreakMode="WordWrap"
                                               WidthRequest="300"
                                               TextColor="{AppThemeBinding Light={StaticResource Gray500}, Dark={StaticResource Gray400}}" />

                                        <Label Text="Supported formats"
                                               FontSize="12"
                                               FontAttributes="Bold"
                                               HorizontalTextAlignment="Center"
                                               TextColor="{AppThemeBinding Light={StaticResource Gray500}, Dark={StaticResource Gray300}}" />

                                        <FlexLayout Direction="Row"
                                                    Wrap="Wrap"
                                                    JustifyContent="Center"
                                                    AlignItems="Center"
                                                    WidthRequest="290">

                                            <Border Padding="10,5" Margin="4,4,4,0" StrokeThickness="0"
                                                    BackgroundColor="{AppThemeBinding Light=#F3F0FF, Dark=#26213C}">
                                                <Border.StrokeShape>
                                                    <RoundRectangle CornerRadius="10" />
                                                </Border.StrokeShape>
                                                <Label Text="TXT" FontSize="11" FontAttributes="Bold"
                                                       TextColor="{AppThemeBinding Light={StaticResource ReadLightPurple}, Dark={StaticResource ReadDarkPurple}}" />
                                            </Border>
                                            <Border Padding="10,5" Margin="4,4,4,0" StrokeThickness="0"
                                                    BackgroundColor="{AppThemeBinding Light=#F3F0FF, Dark=#26213C}">
                                                <Border.StrokeShape>
                                                    <RoundRectangle CornerRadius="10" />
                                                </Border.StrokeShape>
                                                <Label Text="EPUB" FontSize="11" FontAttributes="Bold"
                                                       TextColor="{AppThemeBinding Light={StaticResource ReadLightPurple}, Dark={StaticResource ReadDarkPurple}}" />
                                            </Border>
                                            <Border Padding="10,5" Margin="4,4,4,0" StrokeThickness="0"
                                                    BackgroundColor="{AppThemeBinding Light=#F3F0FF, Dark=#26213C}">
                                                <Border.StrokeShape>
                                                    <RoundRectangle CornerRadius="10" />
                                                </Border.StrokeShape>
                                                <Label Text="PDF" FontSize="11" FontAttributes="Bold"
                                                       TextColor="{AppThemeBinding Light={StaticResource ReadLightPurple}, Dark={StaticResource ReadDarkPurple}}" />
                                            </Border>
                                            <Border Padding="10,5" Margin="4,4,4,0" StrokeThickness="0"
                                                    BackgroundColor="{AppThemeBinding Light=#F3F0FF, Dark=#26213C}">
                                                <Border.StrokeShape>
                                                    <RoundRectangle CornerRadius="10" />
                                                </Border.StrokeShape>
                                                <Label Text="HTML" FontSize="11" FontAttributes="Bold"
                                                       TextColor="{AppThemeBinding Light={StaticResource ReadLightPurple}, Dark={StaticResource ReadDarkPurple}}" />
                                            </Border>
                                            <Border Padding="10,5" Margin="4,4,4,0" StrokeThickness="0"
                                                    BackgroundColor="{AppThemeBinding Light=#F3F0FF, Dark=#26213C}">
                                                <Border.StrokeShape>
                                                    <RoundRectangle CornerRadius="10" />
                                                </Border.StrokeShape>
                                                <Label Text="DOCX" FontSize="11" FontAttributes="Bold"
                                                       TextColor="{AppThemeBinding Light={StaticResource ReadLightPurple}, Dark={StaticResource ReadDarkPurple}}" />
                                            </Border>
                                            <Border Padding="10,5" Margin="4,4,4,0" StrokeThickness="0"
                                                    BackgroundColor="{AppThemeBinding Light=#F3F0FF, Dark=#26213C}">
                                                <Border.StrokeShape>
                                                    <RoundRectangle CornerRadius="10" />
                                                </Border.StrokeShape>
                                                <Label Text="RTF" FontSize="11" FontAttributes="Bold"
                                                       TextColor="{AppThemeBinding Light={StaticResource ReadLightPurple}, Dark={StaticResource ReadDarkPurple}}" />
                                            </Border>
                                        </FlexLayout>

                                        <Button Text="{Binding Source={x:Reference BookshelfPageRoot}, Path=EmptyStatePrimaryButtonText}"
                                                FontSize="14"
                                                FontAttributes="Bold"
                                                HeightRequest="46"
                                                WidthRequest="220"
                                                CornerRadius="16"
                                                BackgroundColor="{AppThemeBinding Light={StaticResource ReadLightPurple}, Dark={StaticResource ReadDarkPurple}}"
                                                TextColor="White"
                                                Clicked="OnAddFileClicked" />

                                        <Label Text="{Binding Source={x:Reference BookshelfPageRoot}, Path=EmptyStateSecondaryHint}"
                                               FontSize="11.5"
                                               HorizontalTextAlignment="Center"
                                               WidthRequest="290"
                                               LineBreakMode="WordWrap"
                                               TextColor="{AppThemeBinding Light={StaticResource Gray500}, Dark={StaticResource Gray400}}" />
                                    </VerticalStackLayout>
                                </Grid>
                            </CollectionView.EmptyView>

                            <CollectionView.ItemTemplate>
                                <DataTemplate>
                                    <SwipeView x:Name="BookSwipe"
                                               IsEnabled="True">
                                        <SwipeView.Triggers>
                                            <DataTrigger TargetType="SwipeView"
                                                         Binding="{Binding Source={x:Reference BookshelfPageRoot}, Path=IsMultiSelectMode}"
                                                         Value="True">
                                                <Setter Property="IsEnabled" Value="False" />
                                            </DataTrigger>
                                            <DataTrigger TargetType="SwipeView"
                                                         Binding="{Binding Source={x:Reference BookshelfPageRoot}, Path=IsImporting}"
                                                         Value="True">
                                                <Setter Property="IsEnabled" Value="False" />
                                            </DataTrigger>
                                        </SwipeView.Triggers>

                                        <SwipeView.LeftItems>
                                            <SwipeItems Mode="Reveal">
                                                <SwipeItem Text="Delete"
                                                           BackgroundColor="{AppThemeBinding Light={StaticResource DangerLightRed}, Dark={StaticResource DangerDarkRed}}"
                                                           Invoked="OnSwipeDelete"
                                                           CommandParameter="{Binding .}" />
                                            </SwipeItems>
                                        </SwipeView.LeftItems>

                                        <Border Stroke="{AppThemeBinding Light={StaticResource Gray200}, Dark={StaticResource Gray700}}"
                                                StrokeThickness="1"
                                                Padding="10"
                                                Margin="0,0,0,8"
                                                BackgroundColor="{AppThemeBinding Light={StaticResource White}, Dark={StaticResource Gray900}}"
                                                Loaded="OnBookCardLoaded">
                                            <Border.StrokeShape>
                                                <RoundRectangle CornerRadius="16" />
                                            </Border.StrokeShape>
                                            <Border.Shadow>
                                                <Shadow Brush="#14000000"
                                                        Offset="0,8"
                                                        Radius="16"
                                                        Opacity="0.32" />
                                            </Border.Shadow>
                                            <Border.Triggers>
                                                <DataTrigger TargetType="Border"
                                                             Binding="{Binding IsSelected}"
                                                             Value="True">
                                                    <Setter Property="Stroke" Value="#8C79FF" />
                                                    <Setter Property="StrokeThickness" Value="1.6" />
                                                    <Setter Property="BackgroundColor" Value="#FAF8FF" />
                                                </DataTrigger>
                                            </Border.Triggers>

                                            <Grid ColumnDefinitions="Auto,56,*,48"
                                                  ColumnSpacing="8"
                                                  VerticalOptions="Center">

                                                <CheckBox Grid.Column="0"
                                                          IsChecked="{Binding IsSelected}"
                                                          VerticalOptions="Center"
                                                          Scale="0.88"
                                                          IsVisible="False">
                                                    <CheckBox.Triggers>
                                                        <DataTrigger TargetType="CheckBox"
                                                                     Binding="{Binding Source={x:Reference BookshelfPageRoot}, Path=IsMultiSelectMode}"
                                                                     Value="True">
                                                            <Setter Property="IsVisible" Value="True" />
                                                        </DataTrigger>
                                                    </CheckBox.Triggers>
                                                </CheckBox>

                                                <Border Grid.Column="1"
                                                        HeightRequest="56"
                                                        WidthRequest="56"
                                                        Padding="0"
                                                        StrokeThickness="0"
                                                        BackgroundColor="{Binding CoverColor}"
                                                        VerticalOptions="Center">
                                                    <Border.StrokeShape>
                                                        <RoundRectangle CornerRadius="12" />
                                                    </Border.StrokeShape>
                                                    <Grid>
                                                        <Label Text="{Binding CoverText}"
                                                               FontSize="12"
                                                               FontAttributes="Bold"
                                                               TextColor="White"
                                                               HorizontalOptions="Center"
                                                               VerticalOptions="Center" />
                                                    </Grid>
                                                </Border>

                                                <Grid Grid.Column="2"
                                                      VerticalOptions="Center">
                                                    <Grid.Behaviors>
                                                        <toolkit:TouchBehavior LongPressCommand="{Binding Source={x:Reference BookshelfPageRoot}, Path=LongPressCommand}"
                                                                               LongPressCommandParameter="{Binding .}"
                                                                               LongPressDuration="450" />
                                                    </Grid.Behaviors>

                                                    <Grid.GestureRecognizers>
                                                        <TapGestureRecognizer Tapped="OnItemTapped"
                                                                              CommandParameter="{Binding .}" />
                                                    </Grid.GestureRecognizers>

                                                    <VerticalStackLayout Spacing="3"
                                                                         VerticalOptions="Center">

                                                        <Label Text="{Binding DisplayFileName}"
                                                               FontSize="13"
                                                               FontAttributes="Bold"
                                                               LineBreakMode="TailTruncation"
                                                               MaxLines="1"
                                                               TextColor="{AppThemeBinding Light={StaticResource PrimaryDarkText}, Dark={StaticResource White}}" />

                                                        <HorizontalStackLayout Spacing="6">
                                                            <Border Padding="6,2"
                                                                    Stroke="{AppThemeBinding Light=#E5E1F3, Dark=#444444}"
                                                                    StrokeThickness="1"
                                                                    HorizontalOptions="Start"
                                                                    BackgroundColor="{AppThemeBinding Light=#F6F3FF, Dark=#2B2B2F}">
                                                                <Border.StrokeShape>
                                                                    <RoundRectangle CornerRadius="6" />
                                                                </Border.StrokeShape>

                                                                <Label Text="{Binding Format}"
                                                                       FontSize="8.2"
                                                                       FontAttributes="Bold"
                                                                       TextColor="{AppThemeBinding Light={StaticResource Gray500}, Dark={StaticResource Gray300}}" />
                                                            </Border>

                                                            <Border Padding="6,2"
                                                                    StrokeThickness="0"
                                                                    HorizontalOptions="Start"
                                                                    BackgroundColor="{AppThemeBinding Light=#F4F2FB, Dark=#2A2A31}"
                                                                    IsVisible="False">
                                                                <Border.StrokeShape>
                                                                    <RoundRectangle CornerRadius="6" />
                                                                </Border.StrokeShape>
                                                                <Border.Triggers>
                                                                    <DataTrigger TargetType="Border"
                                                                                 Binding="{Binding IsUnread}"
                                                                                 Value="True">
                                                                        <Setter Property="IsVisible" Value="True" />
                                                                    </DataTrigger>
                                                                </Border.Triggers>

                                                                <Label Text="Ready to read"
                                                                       FontSize="8.2"
                                                                       FontAttributes="Bold"
                                                                       TextColor="{AppThemeBinding Light={StaticResource Gray500}, Dark={StaticResource Gray300}}" />
                                                            </Border>
                                                        </HorizontalStackLayout>

                                                        <Label Text="{Binding LastOpenedText}"
                                                               FontSize="9.3"
                                                               TextColor="{AppThemeBinding Light={StaticResource Gray500}, Dark={StaticResource Gray400}}"
                                                               LineBreakMode="TailTruncation"
                                                               MaxLines="1" />

                                                        <Border Padding="5,1"
                                                                StrokeThickness="0"
                                                                HorizontalOptions="Start"
                                                                BackgroundColor="{AppThemeBinding Light=#EFE9FF, Dark=#2A2340}"
                                                                IsVisible="{Binding HasProgress}">
                                                            <Border.StrokeShape>
                                                                <RoundRectangle CornerRadius="6" />
                                                            </Border.StrokeShape>

                                                            <HorizontalStackLayout Spacing="4">
                                                                <Label Text="●"
                                                                       FontSize="7.5"
                                                                       TextColor="{AppThemeBinding Light={StaticResource ReadLightPurple}, Dark={StaticResource ReadDarkPurple}}"
                                                                       VerticalOptions="Center" />
                                                                <Label Text="Continue reading"
                                                                       FontSize="8"
                                                                       FontAttributes="Bold"
                                                                       TextColor="{AppThemeBinding Light={StaticResource ReadLightPurple}, Dark={StaticResource ReadDarkPurple}}"
                                                                       VerticalOptions="Center" />
                                                            </HorizontalStackLayout>
                                                        </Border>

                                                        <Grid ColumnDefinitions="*,Auto"
                                                              ColumnSpacing="6"
                                                              VerticalOptions="Center"
                                                              IsVisible="{Binding HasProgress}">

                                                            <ProgressBar Grid.Column="0"
                                                                         Progress="{Binding ReadingProgress}"
                                                                         HeightRequest="4"
                                                                         VerticalOptions="Center"
                                                                         BackgroundColor="{AppThemeBinding Light=#ECEAF5, Dark=#2F2F34}"
                                                                         ProgressColor="{AppThemeBinding Light={StaticResource ReadLightPurple}, Dark={StaticResource ReadDarkPurple}}" />

                                                            <Label Grid.Column="1"
                                                                   Text="{Binding ProgressPercentText}"
                                                                   FontSize="8.8"
                                                                   FontAttributes="Bold"
                                                                   VerticalOptions="Center"
                                                                   TextColor="{AppThemeBinding Light={StaticResource PrimaryDarkText}, Dark={StaticResource White}}" />
                                                        </Grid>
                                                    </VerticalStackLayout>
                                                </Grid>

                                                <Button Grid.Column="3"
                                                        Text="Read"
                                                        FontSize="11"
                                                        Padding="0"
                                                        HeightRequest="36"
                                                        WidthRequest="44"
                                                        MinimumWidthRequest="44"
                                                        CornerRadius="10"
                                                        TextColor="White"
                                                        BackgroundColor="{AppThemeBinding Light={StaticResource ReadLightPurple}, Dark={StaticResource ReadDarkPurple}}"
                                                        Clicked="OnFileClicked"
                                                        CommandParameter="{Binding .}"
                                                        VerticalOptions="Center"
                                                        HorizontalOptions="End"
                                                        IsVisible="True">
                                                    <Button.Triggers>
                                                        <DataTrigger TargetType="Button"
                                                                     Binding="{Binding Source={x:Reference BookshelfPageRoot}, Path=IsMultiSelectMode}"
                                                                     Value="True">
                                                            <Setter Property="IsVisible" Value="False" />
                                                        </DataTrigger>
                                                    </Button.Triggers>
                                                </Button>
                                            </Grid>
                                        </Border>
                                    </SwipeView>
                                </DataTemplate>
                            </CollectionView.ItemTemplate>
                        </CollectionView>
                    </Grid>

                    <!-- Add Book Area -->
                    <VerticalStackLayout Grid.Row="2"
                                         x:Name="AddBookBottomArea"
                                         Spacing="6"
                                         Margin="10,2,10,0"
                                         VerticalOptions="End"
                                         IsVisible="True">
                        <VerticalStackLayout.Triggers>
                            <DataTrigger TargetType="VerticalStackLayout"
                                         Binding="{Binding Source={x:Reference BookshelfPageRoot}, Path=IsMultiSelectMode}"
                                         Value="True">
                                <Setter Property="IsVisible" Value="False" />
                            </DataTrigger>
                        </VerticalStackLayout.Triggers>

                        <Border x:Name="AddBookCard"
                                Padding="0"
                                StrokeThickness="0"
                                BackgroundColor="Transparent">
                            <Border.StrokeShape>
                                <RoundRectangle CornerRadius="26" />
                            </Border.StrokeShape>
                            <Border.Shadow>
                                <Shadow Brush="#1A6F5DFF"
                                        Offset="0,10"
                                        Radius="18"
                                        Opacity="0.34" />
                            </Border.Shadow>

                            <Grid x:Name="AddBookTapSurface"
                                  HeightRequest="66">

                                <Grid.Background>
                                    <LinearGradientBrush StartPoint="0,0" EndPoint="1,1">
                                        <GradientStop Color="{AppThemeBinding Light=#7A63FF, Dark=#8A74FF}" Offset="0.0" />
                                        <GradientStop Color="{AppThemeBinding Light=#9B8CFF, Dark=#6E58E8}" Offset="1.0" />
                                    </LinearGradientBrush>
                                </Grid.Background>

                                <Grid.GestureRecognizers>
                                    <TapGestureRecognizer Tapped="OnAddFileClicked" />
                                </Grid.GestureRecognizers>

                                <Grid ColumnDefinitions="Auto,*,Auto"
                                      Padding="18,0">

                                    <Border Grid.Column="0"
                                            HeightRequest="34"
                                            WidthRequest="34"
                                            Padding="0"
                                            StrokeThickness="0"
                                            VerticalOptions="Center"
                                            BackgroundColor="#22FFFFFF">
                                        <Border.StrokeShape>
                                            <RoundRectangle CornerRadius="17" />
                                        </Border.StrokeShape>

                                        <Grid>
                                            <Label Text="+"
                                                   FontSize="22"
                                                   FontAttributes="Bold"
                                                   TextColor="White"
                                                   HorizontalOptions="Center"
                                                   VerticalOptions="Center"
                                                   IsVisible="{Binding Source={x:Reference BookshelfPageRoot}, Path=ShowAddBookPlus}" />

                                            <ActivityIndicator IsRunning="{Binding Source={x:Reference BookshelfPageRoot}, Path=IsImporting}"
                                                               IsVisible="{Binding Source={x:Reference BookshelfPageRoot}, Path=IsImporting}"
                                                               Color="White"
                                                               HeightRequest="18"
                                                               WidthRequest="18"
                                                               HorizontalOptions="Center"
                                                               VerticalOptions="Center" />
                                        </Grid>
                                    </Border>

                                    <VerticalStackLayout Grid.Column="1"
                                                         Spacing="1"
                                                         Padding="12,0,0,0"
                                                         VerticalOptions="Center">

                                        <Label Text="{Binding Source={x:Reference BookshelfPageRoot}, Path=AddBookButtonTitle}"
                                               FontSize="17"
                                               FontAttributes="Bold"
                                               TextColor="White"
                                               LineBreakMode="NoWrap" />

                                        <Label Text="{Binding Source={x:Reference BookshelfPageRoot}, Path=AddBookButtonSubtitle}"
                                               FontSize="10.5"
                                               TextColor="#EDE9FF"
                                               LineBreakMode="TailTruncation" />
                                    </VerticalStackLayout>

                                    <Label Grid.Column="2"
                                           Text="›"
                                           FontSize="24"
                                           FontAttributes="Bold"
                                           TextColor="White"
                                           VerticalOptions="Center"
                                           HorizontalOptions="End"
                                           Opacity="{Binding Source={x:Reference BookshelfPageRoot}, Path=AddBookArrowOpacity}" />
                                </Grid>

                                <Border IsVisible="{Binding Source={x:Reference BookshelfPageRoot}, Path=IsImporting}"
                                        StrokeThickness="0"
                                        BackgroundColor="#16000000"
                                        InputTransparent="False">
                                    <Border.StrokeShape>
                                        <RoundRectangle CornerRadius="26" />
                                    </Border.StrokeShape>
                                </Border>
                            </Grid>
                        </Border>

                        <Label HorizontalTextAlignment="Center"
                               FontSize="11.5"
                               LineBreakMode="WordWrap"
                               MaxLines="2"
                               Text="{Binding Source={x:Reference BookshelfPageRoot}, Path=AddBookHelperText}"
                               TextColor="{AppThemeBinding Light={StaticResource Gray500}, Dark={StaticResource Gray400}}"
                               Margin="8,0,8,0" />
                    </VerticalStackLayout>

                </Grid>
            </Border>
        </Grid>

        <!-- Toast -->
        <Border x:Name="ToastFrame"
                ZIndex="900"
                IsVisible="False"
                Opacity="0"
                Padding="12,10"
                StrokeThickness="0"
                BackgroundColor="#1F1F1F"
                HorizontalOptions="Center"
                VerticalOptions="End"
                Margin="0,0,0,28">
            <Border.StrokeShape>
                <RoundRectangle CornerRadius="14" />
            </Border.StrokeShape>

            <Label x:Name="ToastLabel"
                   Text=""
                   TextColor="White"
                   FontSize="13"
                   HorizontalTextAlignment="Center" />
        </Border>

        <!-- Delete Overlay -->
        <Grid x:Name="DeleteOverlay"
              ZIndex="999"
              IsVisible="False"
              HorizontalOptions="Fill"
              VerticalOptions="Fill"
              InputTransparent="False">

            <BoxView BackgroundColor="#80000000"
                     HorizontalOptions="Fill"
                     VerticalOptions="Fill">
                <BoxView.GestureRecognizers>
                    <TapGestureRecognizer Tapped="OnCancelDeleteDialog"/>
                </BoxView.GestureRecognizers>
            </BoxView>

            <Border x:Name="DeleteDialog"
                    WidthRequest="320"
                    Padding="28"
                    BackgroundColor="{AppThemeBinding Light=White, Dark=#1C1C1E}"
                    StrokeThickness="0"
                    Opacity="0"
                    Scale="0.85"
                    HorizontalOptions="Center"
                    VerticalOptions="Center"
                    TranslationY="18"
                    TranslationX="12"
                    InputTransparent="False">
                <Border.StrokeShape>
                    <RoundRectangle CornerRadius="26" />
                </Border.StrokeShape>

                <VerticalStackLayout Spacing="18">

                    <Border HeightRequest="56"
                            WidthRequest="56"
                            Padding="0"
                            HorizontalOptions="Center"
                            BackgroundColor="{AppThemeBinding Light={StaticResource DangerLightRed}, Dark={StaticResource DangerDarkRed}}"
                            StrokeThickness="0">
                        <Border.StrokeShape>
                            <RoundRectangle CornerRadius="28" />
                        </Border.StrokeShape>

                        <Label Text="🗑"
                               FontSize="24"
                               TextColor="White"
                               HorizontalOptions="Center"
                               VerticalOptions="Center"/>
                    </Border>

                    <Label x:Name="DeleteTitle"
                           Text="Delete?"
                           FontSize="18"
                           FontAttributes="Bold"
                           HorizontalTextAlignment="Center"
                           TextColor="{AppThemeBinding Light=Black, Dark=White}" />

                    <Label x:Name="DeleteMessage"
                           Text="This action cannot be undone."
                           FontSize="14"
                           HorizontalTextAlignment="Center"
                           TextColor="{AppThemeBinding Light=#666666, Dark=#AAAAAA}" />

                    <Grid ColumnDefinitions="*,*"
                          ColumnSpacing="14">

                        <Button Grid.Column="0"
                                Text="Cancel"
                                CornerRadius="14"
                                BackgroundColor="{AppThemeBinding Light=#F2F2F2, Dark=#2C2C2E}"
                                TextColor="{AppThemeBinding Light=Black, Dark=White}"
                                Clicked="OnCancelDeleteDialog"/>

                        <Button Grid.Column="1"
                                Text="Delete"
                                CornerRadius="14"
                                BackgroundColor="{AppThemeBinding Light={StaticResource DangerLightRed}, Dark={StaticResource DangerDarkRed}}"
                                TextColor="White"
                                Clicked="OnConfirmDeleteDialog"/>

                    </Grid>
                </VerticalStackLayout>
            </Border>
        </Grid>

    </Grid>
</ContentPage>