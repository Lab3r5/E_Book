<?xml version="1.0" encoding="utf-8" ?>
<ContentPage xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             xmlns:shell="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:toolkit="http://schemas.microsoft.com/dotnet/2022/maui/toolkit"
             x:Class="E_Book.Pages.BookshelfPage"
             x:Name="BookshelfPageRoot"
             shell:Shell.NavBarIsVisible="False"
             BackgroundColor="{AppThemeBinding Light={StaticResource PageBackground}, Dark={StaticResource OffBlack}}">

    <Grid x:Name="RootHost"
          HorizontalOptions="Fill"
          VerticalOptions="Fill">

        <Grid x:Name="RootGrid"
              RowDefinitions="Auto,*"
              Padding="24,18">

            <!-- Header -->
            <Grid Grid.Row="0"
                  ColumnDefinitions="Auto,*,Auto"
                  Margin="0,10,0,14"
                  VerticalOptions="Center"
                  ColumnSpacing="8">

                <!-- Left area -->
                <Grid Grid.Column="0"
                      HorizontalOptions="Start"
                      VerticalOptions="Center">

                    <!-- Select All -->
                    <Button x:Name="SelectAllButton"
                            Text="Select All"
                            FontSize="13"
                            FontAttributes="Bold"
                            BackgroundColor="Transparent"
                            TextColor="{AppThemeBinding Light={StaticResource PrimaryDarkText}, Dark={StaticResource White}}"
                            Padding="0"
                            Clicked="OnSelectAllClicked"
                            IsVisible="{Binding Source={x:Reference BookshelfPageRoot}, Path=IsMultiSelectMode}" />
                </Grid>

                <!-- Center title -->
                <Grid Grid.Column="1"
                      HorizontalOptions="Fill"
                      VerticalOptions="Center">

                    <!-- Normal title -->
                    <Label Text="My Library"
                           FontSize="26"
                           FontAttributes="Bold"
                           HorizontalTextAlignment="Center"
                           VerticalTextAlignment="Center"
                           TextColor="{AppThemeBinding Light={StaticResource PrimaryDarkText}, Dark={StaticResource White}}"
                           IsVisible="True">
                        <Label.Triggers>
                            <DataTrigger TargetType="Label"
                                         Binding="{Binding Source={x:Reference BookshelfPageRoot}, Path=IsMultiSelectMode}"
                                         Value="True">
                                <Setter Property="IsVisible" Value="False" />
                            </DataTrigger>
                        </Label.Triggers>
                    </Label>

                    <!-- Multi-select title -->
                    <Label FontSize="20"
                           FontAttributes="Bold"
                           HorizontalTextAlignment="Center"
                           VerticalTextAlignment="Center"
                           TextColor="{AppThemeBinding Light={StaticResource PrimaryDarkText}, Dark={StaticResource White}}"
                           IsVisible="False">
                        <Label.FormattedText>
                            <FormattedString>
                                <Span Text="{Binding Source={x:Reference BookshelfPageRoot}, Path=Books.Count}" />
                                <Span Text=" books" />
                            </FormattedString>
                        </Label.FormattedText>
                        <Label.Triggers>
                            <DataTrigger TargetType="Label"
                                         Binding="{Binding Source={x:Reference BookshelfPageRoot}, Path=IsMultiSelectMode}"
                                         Value="True">
                                <Setter Property="IsVisible" Value="True" />
                            </DataTrigger>
                            <DataTrigger TargetType="Label"
                                         Binding="{Binding Source={x:Reference BookshelfPageRoot}, Path=IsMultiSelectMode}"
                                         Value="False">
                                <Setter Property="IsVisible" Value="False" />
                            </DataTrigger>
                        </Label.Triggers>
                    </Label>
                </Grid>

                <!-- Right area -->
                <Grid Grid.Column="2"
                      HorizontalOptions="End"
                      VerticalOptions="Center"
                      ColumnDefinitions="Auto,Auto"
                      ColumnSpacing="8">

                    <!-- Cancel (multi-select only) -->
                    <Button Grid.Column="0"
                            Text="Cancel"
                            FontSize="13"
                            FontAttributes="Bold"
                            BackgroundColor="Transparent"
                            TextColor="{AppThemeBinding Light={StaticResource PrimaryDarkText}, Dark={StaticResource White}}"
                            Padding="0"
                            Clicked="OnCancelMultiSelectClicked"
                            IsVisible="{Binding Source={x:Reference BookshelfPageRoot}, Path=IsMultiSelectMode}" />

                    <!-- Trash -->
                    <Frame Grid.Column="1"
                           x:Name="TrashButton"
                           HeightRequest="40"
                           WidthRequest="40"
                           CornerRadius="20"
                           Padding="0"
                           HasShadow="False"
                           BackgroundColor="{AppThemeBinding Light={StaticResource DangerLightRed}, Dark={StaticResource DangerDarkRed}}"
                           IsVisible="True">

                        <Label Text="🗑"
                               FontSize="18"
                               TextColor="White"
                               HorizontalOptions="Center"
                               VerticalOptions="Center">
                            <Label.GestureRecognizers>
                                <TapGestureRecognizer Tapped="OnTrashTapped"/>
                            </Label.GestureRecognizers>
                        </Label>

                        <Frame.Triggers>
                            <DataTrigger TargetType="Frame"
                                         Binding="{Binding Source={x:Reference BookshelfPageRoot}, Path=IsMultiSelectMode}"
                                         Value="True">
                                <Setter Property="IsVisible" Value="False" />
                            </DataTrigger>
                        </Frame.Triggers>
                    </Frame>

                    <!-- Confirm -->
                    <Frame Grid.Column="1"
                           x:Name="ConfirmButton"
                           HeightRequest="40"
                           WidthRequest="40"
                           CornerRadius="20"
                           Padding="0"
                           HasShadow="False"
                           BackgroundColor="#A8E6B3"
                           IsVisible="False"
                           Opacity="1">

                        <Label Text="✓"
                               FontSize="22"
                               FontAttributes="Bold"
                               TextColor="White"
                               HorizontalOptions="Center"
                               VerticalOptions="Center">
                            <Label.GestureRecognizers>
                                <TapGestureRecognizer Tapped="OnConfirmTapped"/>
                            </Label.GestureRecognizers>
                        </Label>

                        <Frame.Triggers>
                            <DataTrigger TargetType="Frame"
                                         Binding="{Binding Source={x:Reference BookshelfPageRoot}, Path=IsMultiSelectMode}"
                                         Value="True">
                                <Setter Property="IsVisible" Value="True" />
                            </DataTrigger>
                        </Frame.Triggers>
                    </Frame>
                </Grid>
            </Grid>

            <!-- Main container -->
            <Frame Grid.Row="1"
                   BackgroundColor="{AppThemeBinding Light={StaticResource CardBackground}, Dark={StaticResource Gray950}}"
                   CornerRadius="28"
                   Padding="18"
                   HasShadow="True"
                   Margin="0,0,0,18">

                <Frame.Shadow>
                    <Shadow Brush="#18000000"
                            Offset="0,8"
                            Radius="22"
                            Opacity="0.18" />
                </Frame.Shadow>

                <Grid RowDefinitions="*,Auto">

                    <CollectionView Grid.Row="0"
                                    ItemsSource="{Binding Books}"
                                    SelectionMode="None">

                        <CollectionView.EmptyView>
                            <Grid VerticalOptions="Center"
                                  HorizontalOptions="Center">
                                <VerticalStackLayout Spacing="10"
                                                     HorizontalOptions="Center"
                                                     VerticalOptions="Center">
                                    <Label Text="No books available"
                                           FontSize="16"
                                           TextColor="{AppThemeBinding Light={StaticResource Gray500}, Dark={StaticResource Gray400}}"
                                           HorizontalTextAlignment="Center"/>
                                </VerticalStackLayout>
                            </Grid>
                        </CollectionView.EmptyView>

                        <CollectionView.ItemTemplate>
                            <DataTemplate>

                                <SwipeView>
                                    <SwipeView.LeftItems>
                                        <SwipeItems Mode="Reveal">
                                            <SwipeItem Text="Delete"
                                                       BackgroundColor="{AppThemeBinding Light={StaticResource DangerLightRed}, Dark={StaticResource DangerDarkRed}}"
                                                       Invoked="OnSwipeDelete"
                                                       CommandParameter="{Binding .}" />
                                        </SwipeItems>
                                    </SwipeView.LeftItems>

                                    <Frame CornerRadius="16"
                                           Padding="10,11"
                                           Margin="0,0,0,12"
                                           HasShadow="True"
                                           BorderColor="{AppThemeBinding Light={StaticResource Gray200}, Dark={StaticResource Gray700}}"
                                           BackgroundColor="{AppThemeBinding Light={StaticResource White}, Dark={StaticResource Gray900}}">

                                        <Frame.Shadow>
                                            <Shadow Brush="#12000000"
                                                    Offset="0,4"
                                                    Radius="14"
                                                    Opacity="0.12" />
                                        </Frame.Shadow>

                                        <Grid ColumnDefinitions="Auto,56,*,48"
                                              ColumnSpacing="8"
                                              VerticalOptions="Center">

                                            <!-- Checkbox -->
                                            <CheckBox Grid.Column="0"
                                                      IsChecked="{Binding IsSelected}"
                                                      VerticalOptions="Center"
                                                      Scale="0.95"
                                                      IsVisible="False">
                                                <CheckBox.Triggers>
                                                    <DataTrigger TargetType="CheckBox"
                                                                 Binding="{Binding Source={x:Reference BookshelfPageRoot}, Path=IsMultiSelectMode}"
                                                                 Value="True">
                                                        <Setter Property="IsVisible" Value="True" />
                                                    </DataTrigger>
                                                </CheckBox.Triggers>
                                            </CheckBox>

                                            <!-- Cover -->
                                            <Frame Grid.Column="1"
                                                   HeightRequest="56"
                                                   WidthRequest="56"
                                                   Padding="0"
                                                   CornerRadius="12"
                                                   HasShadow="False"
                                                   BackgroundColor="{Binding CoverColor}"
                                                   VerticalOptions="Center">

                                                <Grid>
                                                    <Label Text="{Binding CoverText}"
                                                           FontSize="12"
                                                           FontAttributes="Bold"
                                                           TextColor="White"
                                                           HorizontalOptions="Center"
                                                           VerticalOptions="Center" />
                                                </Grid>
                                            </Frame>

                                            <!-- Text content -->
                                            <Grid Grid.Column="2"
                                                  VerticalOptions="Center">

                                                <Grid.Behaviors>
                                                    <toolkit:TouchBehavior LongPressCommand="{Binding Source={x:Reference BookshelfPageRoot}, Path=LongPressCommand}"
                                                                           LongPressCommandParameter="{Binding .}"
                                                                           LongPressDuration="450" />
                                                </Grid.Behaviors>

                                                <Grid.GestureRecognizers>
                                                    <TapGestureRecognizer Tapped="OnItemTapped"
                                                                          CommandParameter="{Binding .}" />
                                                </Grid.GestureRecognizers>

                                                <VerticalStackLayout Spacing="2"
                                                                     VerticalOptions="Center">

                                                    <!-- File name -->
                                                    <Label Text="{Binding FileName}"
                                                           FontSize="12.5"
                                                           FontAttributes="Bold"
                                                           LineBreakMode="TailTruncation"
                                                           MaxLines="1"
                                                           TextColor="{AppThemeBinding Light={StaticResource PrimaryDarkText}, Dark={StaticResource White}}" />

                                                    <!-- Format -->
                                                    <Frame Padding="6,2"
                                                           CornerRadius="6"
                                                           HasShadow="False"
                                                           HorizontalOptions="Start"
                                                           BorderColor="{AppThemeBinding Light=#E5E1F3, Dark=#444444}"
                                                           BackgroundColor="{AppThemeBinding Light=#F6F3FF, Dark=#2B2B2F}">
                                                        <Label Text="{Binding Format}"
                                                               FontSize="8.5"
                                                               FontAttributes="Bold"
                                                               TextColor="{AppThemeBinding Light={StaticResource Gray500}, Dark={StaticResource Gray300}}" />
                                                    </Frame>

                                                    <!-- Last opened -->
                                                    <Label Text="{Binding LastOpenedText}"
                                                           FontSize="9.5"
                                                           TextColor="{AppThemeBinding Light={StaticResource Gray500}, Dark={StaticResource Gray400}}"
                                                           LineBreakMode="TailTruncation"
                                                           MaxLines="1" />

                                                    <!-- Continue reading badge -->
                                                    <Frame Padding="5,1"
                                                           CornerRadius="6"
                                                           HasShadow="False"
                                                           HorizontalOptions="Start"
                                                           BackgroundColor="{AppThemeBinding Light=#EFE9FF, Dark=#2A2340}"
                                                           IsVisible="{Binding HasProgress}">
                                                        <HorizontalStackLayout Spacing="4">
                                                            <Label Text="●"
                                                                   FontSize="8"
                                                                   TextColor="{AppThemeBinding Light={StaticResource ReadLightPurple}, Dark={StaticResource ReadDarkPurple}}"
                                                                   VerticalOptions="Center" />
                                                            <Label Text="Continue reading"
                                                                   FontSize="8.5"
                                                                   FontAttributes="Bold"
                                                                   TextColor="{AppThemeBinding Light={StaticResource ReadLightPurple}, Dark={StaticResource ReadDarkPurple}}"
                                                                   VerticalOptions="Center" />
                                                        </HorizontalStackLayout>
                                                    </Frame>

                                                    <!-- Compact progress -->
                                                    <Grid ColumnDefinitions="*,Auto"
                                                          ColumnSpacing="6"
                                                          VerticalOptions="Center"
                                                          IsVisible="{Binding HasProgress}">

                                                        <ProgressBar Grid.Column="0"
                                                                     Progress="{Binding ReadingProgress}"
                                                                     HeightRequest="4"
                                                                     VerticalOptions="Center"
                                                                     BackgroundColor="{AppThemeBinding Light=#ECEAF5, Dark=#2F2F34}"
                                                                     ProgressColor="{AppThemeBinding Light={StaticResource ReadLightPurple}, Dark={StaticResource ReadDarkPurple}}" />

                                                        <Label Grid.Column="1"
                                                               Text="{Binding ProgressPercentText}"
                                                               FontSize="9"
                                                               FontAttributes="Bold"
                                                               VerticalOptions="Center"
                                                               TextColor="{AppThemeBinding Light={StaticResource PrimaryDarkText}, Dark={StaticResource White}}" />
                                                    </Grid>

                                                </VerticalStackLayout>
                                            </Grid>

                                            <!-- Read -->
                                            <Button Grid.Column="3"
                                                    Text="Read"
                                                    FontSize="11"
                                                    Padding="0"
                                                    HeightRequest="36"
                                                    WidthRequest="44"
                                                    MinimumWidthRequest="44"
                                                    CornerRadius="10"
                                                    TextColor="White"
                                                    BackgroundColor="{AppThemeBinding Light={StaticResource ReadLightPurple}, Dark={StaticResource ReadDarkPurple}}"
                                                    Clicked="OnFileClicked"
                                                    CommandParameter="{Binding .}"
                                                    VerticalOptions="Center"
                                                    HorizontalOptions="End"
                                                    IsVisible="True">
                                                <Button.Triggers>
                                                    <DataTrigger TargetType="Button"
                                                                 Binding="{Binding Source={x:Reference BookshelfPageRoot}, Path=IsMultiSelectMode}"
                                                                 Value="True">
                                                        <Setter Property="IsVisible" Value="False" />
                                                    </DataTrigger>
                                                </Button.Triggers>
                                            </Button>

                                        </Grid>
                                    </Frame>
                                </SwipeView>

                            </DataTemplate>
                        </CollectionView.ItemTemplate>
                    </CollectionView>

                    <!-- Add Book -->
                    <Button Grid.Row="1"
                            Text="Add Book"
                            FontSize="20"
                            FontAttributes="Bold"
                            HeightRequest="64"
                            CornerRadius="26"
                            BackgroundColor="{AppThemeBinding Light={StaticResource Secondary}, Dark={StaticResource Gray900}}"
                            TextColor="{AppThemeBinding Light={StaticResource PrimaryDarkText}, Dark={StaticResource White}}"
                            Clicked="OnAddFileClicked"
                            Margin="10,16,10,6">

                        <Button.Shadow>
                            <Shadow Brush="#16000000"
                                    Offset="0,6"
                                    Radius="18"
                                    Opacity="0.16" />
                        </Button.Shadow>

                        <Button.Triggers>
                            <DataTrigger TargetType="Button"
                                         Binding="{Binding Source={x:Reference BookshelfPageRoot}, Path=IsMultiSelectMode}"
                                         Value="True">
                                <Setter Property="IsVisible" Value="False" />
                            </DataTrigger>
                        </Button.Triggers>
                    </Button>

                </Grid>
            </Frame>

        </Grid>

        <!-- Toast -->
        <Frame x:Name="ToastFrame"
               ZIndex="900"
               IsVisible="False"
               Opacity="0"
               CornerRadius="14"
               Padding="12,10"
               HasShadow="True"
               BackgroundColor="#1F1F1F"
               HorizontalOptions="Center"
               VerticalOptions="End"
               Margin="0,0,0,28">
            <Label x:Name="ToastLabel"
                   Text=""
                   TextColor="White"
                   FontSize="13"
                   HorizontalTextAlignment="Center" />
        </Frame>

        <!-- Delete Overlay -->
        <Grid x:Name="DeleteOverlay"
              ZIndex="999"
              IsVisible="False"
              HorizontalOptions="Fill"
              VerticalOptions="Fill"
              InputTransparent="False">

            <BoxView BackgroundColor="#80000000"
                     HorizontalOptions="Fill"
                     VerticalOptions="Fill">
                <BoxView.GestureRecognizers>
                    <TapGestureRecognizer Tapped="OnCancelDeleteDialog"/>
                </BoxView.GestureRecognizers>
            </BoxView>

            <Frame x:Name="DeleteDialog"
                   WidthRequest="320"
                   CornerRadius="26"
                   Padding="28"
                   BackgroundColor="{AppThemeBinding Light=White, Dark=#1C1C1E}"
                   HasShadow="True"
                   Opacity="0"
                   Scale="0.85"
                   HorizontalOptions="Center"
                   VerticalOptions="Center"
                   TranslationY="18"
                   TranslationX="12"
                   InputTransparent="False">

                <VerticalStackLayout Spacing="18">

                    <Frame HeightRequest="56"
                           WidthRequest="56"
                           CornerRadius="28"
                           Padding="0"
                           HorizontalOptions="Center"
                           BackgroundColor="{AppThemeBinding Light={StaticResource DangerLightRed}, Dark={StaticResource DangerDarkRed}}"
                           HasShadow="False">
                        <Label Text="🗑"
                               FontSize="24"
                               TextColor="White"
                               HorizontalOptions="Center"
                               VerticalOptions="Center"/>
                    </Frame>

                    <Label x:Name="DeleteTitle"
                           Text="Delete?"
                           FontSize="18"
                           FontAttributes="Bold"
                           HorizontalTextAlignment="Center"
                           TextColor="{AppThemeBinding Light=Black, Dark=White}" />

                    <Label x:Name="DeleteMessage"
                           Text="This action cannot be undone."
                           FontSize="14"
                           HorizontalTextAlignment="Center"
                           TextColor="{AppThemeBinding Light=#666666, Dark=#AAAAAA}" />

                    <Grid ColumnDefinitions="*,*"
                          ColumnSpacing="14">

                        <Button Grid.Column="0"
                                Text="Cancel"
                                CornerRadius="14"
                                BackgroundColor="{AppThemeBinding Light=#F2F2F2, Dark=#2C2C2E}"
                                TextColor="{AppThemeBinding Light=Black, Dark=White}"
                                Clicked="OnCancelDeleteDialog"/>

                        <Button Grid.Column="1"
                                Text="Delete"
                                CornerRadius="14"
                                BackgroundColor="{AppThemeBinding Light={StaticResource DangerLightRed}, Dark={StaticResource DangerDarkRed}}"
                                TextColor="White"
                                Clicked="OnConfirmDeleteDialog"/>

                    </Grid>

                </VerticalStackLayout>
            </Frame>
        </Grid>

    </Grid>
</ContentPage>