<?xml version="1.0" encoding="utf-8" ?>
<ContentPage
    xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
    xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
    xmlns:shell="http://schemas.microsoft.com/dotnet/2021/maui"
    x:Class="E_Book.Pages.ResetPasswordPage"
    shell:Shell.NavBarIsVisible="False"
    BackgroundColor="{AppThemeBinding Light=#F7F6FB, Dark=#121212}">

    <ScrollView x:Name="PageScrollView"
        VerticalScrollBarVisibility="Never">
        <Grid Padding="20,36,20,20"
          RowDefinitions="Auto,*">

            <Grid Grid.Row="0"
              ColumnDefinitions="56,*,56"
              Margin="0,0,0,8">

                <Border WidthRequest="46"
                    HeightRequest="46"
                    BackgroundColor="{AppThemeBinding Light=#FCFAFF, Dark=#1E1E1E}"
                    Stroke="{AppThemeBinding Light=#E8E0F8, Dark=#2D2D35}"
                    StrokeThickness="1"
                    HorizontalOptions="Start"
                    VerticalOptions="Center"
                    StrokeShape="RoundRectangle 23">

                    <Border.GestureRecognizers>
                        <TapGestureRecognizer Tapped="OnBackTapped" />
                    </Border.GestureRecognizers>

                    <Label Text="←"
                       FontSize="20"
                       FontAttributes="Bold"
                       TextColor="{AppThemeBinding Light=#3D36B3, Dark=White}"
                       HorizontalTextAlignment="Center"
                       VerticalTextAlignment="Center" />
                </Border>

                <Border x:Name="ThemeToggleBorder"
                    Grid.Column="2"
                    WidthRequest="46"
                    HeightRequest="46"
                    BackgroundColor="{AppThemeBinding Light=#FCFAFF, Dark=#1E1E1E}"
                    Stroke="{AppThemeBinding Light=#E8E0F8, Dark=#2D2D35}"
                    StrokeThickness="1"
                    HorizontalOptions="End"
                    VerticalOptions="Center"
                    StrokeShape="RoundRectangle 23">

                    <Border.GestureRecognizers>
                        <TapGestureRecognizer Tapped="OnThemeToggleTapped" />
                    </Border.GestureRecognizers>

                    <Label x:Name="ThemeIconLabel"
                       Text="🌙"
                       FontSize="18"
                       TextColor="{AppThemeBinding Light=#3D36B3, Dark=White}"
                       HorizontalTextAlignment="Center"
                       VerticalTextAlignment="Center" />
                </Border>
            </Grid>

            <Grid Grid.Row="1"
              VerticalOptions="Start"
              HorizontalOptions="Center"
              WidthRequest="360"
              Margin="0,24,0,140">

                <Frame x:Name="ResetCard"
                   Padding="24,62,24,24"
                   CornerRadius="28"
                   HasShadow="True"
                   BackgroundColor="{AppThemeBinding Light=#FCFAFF, Dark=#1A1A1E}"
                   Opacity="0"
                   TranslationY="40">

                    <Frame.Shadow>
                        <Shadow Brush="#22000000"
                            Offset="0,10"
                            Radius="24"
                            Opacity="0.16" />
                    </Frame.Shadow>

                    <VerticalStackLayout Spacing="16">

                        <VerticalStackLayout Spacing="6">
                            <Label Text="Reset Password"
                               HorizontalTextAlignment="Center"
                               FontSize="32"
                               FontAttributes="Bold"
                               TextColor="{AppThemeBinding Light=#3D36B3, Dark=White}" />

                            <Label Text="Create a new password for your account."
                               HorizontalTextAlignment="Center"
                               FontSize="16"
                               TextColor="{AppThemeBinding Light=#2F2B85, Dark=#C9C6D8}" />
                        </VerticalStackLayout>

                        <Border x:Name="PasswordBorder"
                            Stroke="{AppThemeBinding Light=#E8E0F8, Dark=#2D2D35}"
                            StrokeThickness="1"
                            StrokeShape="RoundRectangle 18"
                            BackgroundColor="{AppThemeBinding Light=#FCFAFF, Dark=#23232A}"
                            HeightRequest="58"
                            Padding="0">

                            <Grid ColumnDefinitions="*,Auto"
                              ColumnSpacing="8"
                              Padding="18,0">

                                <Entry x:Name="PasswordEntry"
                                   Placeholder="New Password"
                                   IsPassword="True"
                                   ReturnType="Next"
                                   Completed="OnPasswordCompleted"
                                   Focused="OnInputFocused"
                                   FontSize="16"
                                   BackgroundColor="Transparent"
                                   TextColor="{AppThemeBinding Light=#2E2A3B, Dark=White}"
                                   PlaceholderColor="{AppThemeBinding Light=#A09AB2, Dark=#8F8AA0}"
                                   VerticalOptions="Center" />

                                <Button x:Name="TogglePasswordButton"
                                    Grid.Column="1"
                                    Text="👁"
                                    BackgroundColor="Transparent"
                                    TextColor="#B496F4"
                                    FontSize="16"
                                    WidthRequest="24"
                                    HeightRequest="24"
                                    CornerRadius="0"
                                    BorderWidth="0"
                                    Padding="0"
                                    Margin="4,0,0,0"
                                    Clicked="OnTogglePasswordClicked"
                                    VerticalOptions="Center" />
                            </Grid>
                        </Border>

                        <Border x:Name="ConfirmBorder"
                            Stroke="{AppThemeBinding Light=#E8E0F8, Dark=#2D2D35}"
                            StrokeThickness="1"
                            StrokeShape="RoundRectangle 18"
                            BackgroundColor="{AppThemeBinding Light=#FCFAFF, Dark=#23232A}"
                            HeightRequest="58"
                            Padding="0">

                            <Grid ColumnDefinitions="*,Auto"
                              ColumnSpacing="8"
                              Padding="18,0">

                                <Entry x:Name="ConfirmEntry"
                                   Placeholder="Confirm Password"
                                   IsPassword="True"
                                   ReturnType="Go"
                                   Completed="OnConfirmCompleted"
                                   Focused="OnInputFocused"
                                   FontSize="16"
                                   BackgroundColor="Transparent"
                                   TextColor="{AppThemeBinding Light=#2E2A3B, Dark=White}"
                                   PlaceholderColor="{AppThemeBinding Light=#A09AB2, Dark=#8F8AA0}"
                                   VerticalOptions="Center" />

                                <Button x:Name="ToggleConfirmButton"
                                    Grid.Column="1"
                                    Text="👁"
                                    BackgroundColor="Transparent"
                                    TextColor="#B496F4"
                                    FontSize="16"
                                    WidthRequest="24"
                                    HeightRequest="24"
                                    CornerRadius="0"
                                    BorderWidth="0"
                                    Padding="0"
                                    Margin="4,0,0,0"
                                    Clicked="OnToggleConfirmClicked"
                                    VerticalOptions="Center" />
                            </Grid>
                        </Border>

                        <Grid HeightRequest="58">
                            <Button x:Name="ResetButton"
                                Text="Update Password"
                                HeightRequest="58"
                                CornerRadius="22"
                                FontSize="17"
                                FontAttributes="Bold"
                                TextColor="White"
                                Clicked="OnResetClicked">

                                <Button.Background>
                                    <LinearGradientBrush StartPoint="0,0" EndPoint="1,0">
                                        <GradientStop Color="#D9C5FF" Offset="0" />
                                        <GradientStop Color="#B496F4" Offset="1" />
                                    </LinearGradientBrush>
                                </Button.Background>
                            </Button>

                            <ActivityIndicator x:Name="ResetLoading"
                                IsVisible="False"
                                IsRunning="False"
                                Color="White"
                                HorizontalOptions="Center"
                                VerticalOptions="Center" />
                        </Grid>

                    </VerticalStackLayout>
                </Frame>

                <Grid x:Name="LogoFrame"
                  HorizontalOptions="Center"
                  VerticalOptions="Start"
                  TranslationY="-22"
                  Opacity="0"
                  WidthRequest="96"
                  HeightRequest="96">

                    <Border Stroke="{AppThemeBinding Light=#D8CCF6, Dark=#2F2A46}"
                        StrokeThickness="2"
                        StrokeShape="RoundRectangle 48"
                        BackgroundColor="{AppThemeBinding Light=#FCFAFF, Dark=#1A1A1E}">

                        <Border.Shadow>
                            <Shadow Brush="#22000000"
                                Offset="0,7"
                                Radius="16"
                                Opacity="0.10" />
                        </Border.Shadow>
                    </Border>

                    <Image Source="app_logo.png"
                       WidthRequest="380"
                       HeightRequest="350"
                       HorizontalOptions="Center"
                       VerticalOptions="Center" />
                </Grid>

            </Grid>
        </Grid>
    </ScrollView>
</ContentPage>