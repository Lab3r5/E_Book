<?xml version="1.0" encoding="utf-8" ?>
<ContentPage
    xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
    xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
    xmlns:shell="http://schemas.microsoft.com/dotnet/2021/maui"
    x:Class="E_Book.Pages.SettingsHomePage"
    shell:Shell.NavBarIsVisible="False"
    Padding="20,16"
    BackgroundColor="{AppThemeBinding Light=#F7F6FB, Dark=#0F0F12}">

    <Grid RowDefinitions="Auto,14,Auto,20,Auto,14,Auto,*">

        <!-- Title -->
        <Label x:Name="TitleLabel"
               Grid.Row="0"
               Text="Settings"
               FontSize="22"
               FontAttributes="Bold"
               HorizontalTextAlignment="Center"
               TextColor="{AppThemeBinding Light=#221551, Dark=White}"
               Margin="0,8,0,0"
               Opacity="0"
               TranslationY="8" />

        <!-- Profile Card -->
        <Border x:Name="ProfileCard"
                Grid.Row="2"
                StrokeThickness="0"
                StrokeShape="RoundRectangle 28"
                BackgroundColor="{AppThemeBinding Light=White, Dark=#1A1A1E}"
                Padding="18"
                Opacity="0"
                TranslationY="14">

            <Border.Shadow>
                <Shadow Opacity="0.08"
                        Radius="16"
                        Offset="0,6"/>
            </Border.Shadow>

            <Grid RowDefinitions="Auto,Auto"
                  ColumnDefinitions="52,*,Auto"
                  ColumnSpacing="14"
                  RowSpacing="2">

                <!-- Avatar -->
                <Border x:Name="ProfileBubble"
                        Grid.RowSpan="2"
                        StrokeThickness="0"
                        StrokeShape="RoundRectangle 18"
                        BackgroundColor="{AppThemeBinding Light=#EFEAFF, Dark=#2A214F}"
                        WidthRequest="48"
                        HeightRequest="48"
                        VerticalOptions="Start">

                    <Label x:Name="AvatarLetterLabel"
                           FontSize="20"
                           FontAttributes="Bold"
                           HorizontalTextAlignment="Center"
                           VerticalTextAlignment="Center"
                           TextColor="{AppThemeBinding Light=#7A63FF, Dark=White}" />
                </Border>

                <!-- Name -->
                <Label x:Name="NameLabel"
                       Grid.Column="1"
                       Text="Guest"
                       FontSize="18"
                       FontAttributes="Bold"
                       VerticalTextAlignment="Center"
                       LineBreakMode="TailTruncation"
                       TextColor="{AppThemeBinding Light=#221551, Dark=White}" />

                <!-- Edit Profile Button -->
                <Button x:Name="EditProfileButton"
                        Grid.Column="2"
                        Text="Edit Profile"
                        Clicked="OnEditProfileClicked"
                        Padding="16,8"
                        HeightRequest="40"
                        MinimumWidthRequest="132"
                        CornerRadius="20"
                        BackgroundColor="{AppThemeBinding Light=#F3EEFF, Dark=#2A214F}"
                        TextColor="{AppThemeBinding Light=#221551, Dark=White}"
                        FontAttributes="Bold"
                        FontSize="14"
                        VerticalOptions="Center" />

                <!-- Subtitle -->
                <Label x:Name="EmailLabel"
                       Grid.Row="1"
                       Grid.Column="1"
                       Grid.ColumnSpan="2"
                       Text="Guest account"
                       FontSize="13"
                       Margin="0,-2,0,0"
                       LineBreakMode="TailTruncation"
                       TextColor="{AppThemeBinding Light=#8A869E, Dark=#B7B3C6}" />

            </Grid>
        </Border>

        <!-- Section -->
        <Label x:Name="SectionLabel"
               Grid.Row="4"
               Text="Preferences"
               FontSize="13"
               FontAttributes="Bold"
               Margin="2,0,0,0"
               TextColor="{AppThemeBinding Light=#8A869E, Dark=#A9A4BB}"
               Opacity="0"
               TranslationY="20"/>

        <!-- Menu Card -->
        <Border x:Name="MenuCard"
                Grid.Row="6"
                StrokeThickness="0"
                StrokeShape="RoundRectangle 28"
                BackgroundColor="{AppThemeBinding Light=White, Dark=#1A1A1E}"
                Padding="0"
                Opacity="0"
                TranslationY="14">

            <Border.Shadow>
                <Shadow Opacity="0.07"
                        Radius="16"
                        Offset="0,6"/>
            </Border.Shadow>

            <VerticalStackLayout Spacing="0">

                <!-- Appearance -->
                <Grid x:Name="AppearanceRow"
                      Padding="0"
                      BackgroundColor="Transparent"
                      Opacity="0"
                      TranslationY="10">

                    <Border x:Name="AppearanceRipple"
                            StrokeThickness="0"
                            StrokeShape="RoundRectangle 24"
                            BackgroundColor="{AppThemeBinding Light=#EEE9FF, Dark=#2F255F}"
                            Opacity="0"
                            Margin="6"
                            Scale="0.94"/>

                    <Grid Padding="18,16"
                          ColumnDefinitions="44,*,24"
                          ColumnSpacing="14"
                          MinimumHeightRequest="88"
                          BackgroundColor="Transparent">

                        <Border x:Name="AppearanceBubble"
                                StrokeThickness="0"
                                StrokeShape="RoundRectangle 16"
                                BackgroundColor="{AppThemeBinding Light=#EFEAFF, Dark=#2A214F}"
                                WidthRequest="40"
                                HeightRequest="40"
                                VerticalOptions="Start">

                            <Image x:Name="AppearanceIcon"
                                   WidthRequest="22"
                                   HeightRequest="22"
                                   HorizontalOptions="Center"
                                   VerticalOptions="Center">
                                <Image.Source>
                                    <FontImageSource FontFamily="MaterialIcons"
                                                     Glyph="&#xE40A;"
                                                     Size="22"
                                                     Color="{AppThemeBinding Light=#7A63FF, Dark=White}" />
                                </Image.Source>
                            </Image>
                        </Border>

                        <VerticalStackLayout Grid.Column="1"
                                             Spacing="3"
                                             VerticalOptions="Center">

                            <Label Text="Appearance"
                                   FontSize="16"
                                   FontAttributes="Bold"
                                   TextColor="{AppThemeBinding Light=#221551, Dark=White}" />

                            <Label Text="Theme, display, and reading preferences"
                                   FontSize="12"
                                   MaxLines="2"
                                   LineBreakMode="WordWrap"
                                   TextColor="{AppThemeBinding Light=#8A869E, Dark=#B7B3C6}" />

                        </VerticalStackLayout>

                        <Image x:Name="AppearanceChevron"
                               Grid.Column="2"
                               WidthRequest="18"
                               HeightRequest="18"
                               HorizontalOptions="End"
                               VerticalOptions="Center"
                               Opacity="0.65">

                            <Image.Source>
                                <FontImageSource FontFamily="MaterialIcons"
                                                 Glyph="&#xE5CC;"
                                                 Size="18"
                                                 Color="{AppThemeBinding Light=#C7C3D6, Dark=#8A869E}" />
                            </Image.Source>
                        </Image>

                    </Grid>

                    <Grid.GestureRecognizers>
                        <TapGestureRecognizer Tapped="OnAppearanceTapped"/>
                    </Grid.GestureRecognizers>

                </Grid>

                <BoxView HeightRequest="1"
                         Opacity="0.06"
                         BackgroundColor="{AppThemeBinding Light=#6E6688, Dark=#FFFFFF}"/>

                <!-- Help -->
                <Grid x:Name="HelpRow"
                      Padding="0"
                      BackgroundColor="Transparent"
                      Opacity="0"
                      TranslationY="10">

                    <Border x:Name="HelpRipple"
                            StrokeThickness="0"
                            StrokeShape="RoundRectangle 24"
                            BackgroundColor="{AppThemeBinding Light=#EEE9FF, Dark=#2F255F}"
                            Opacity="0"
                            Margin="6"
                            Scale="0.94"/>

                    <Grid Padding="18,16"
                          ColumnDefinitions="44,*,24"
                          ColumnSpacing="14"
                          MinimumHeightRequest="88"
                          BackgroundColor="Transparent">

                        <Border x:Name="HelpBubble"
                                StrokeThickness="0"
                                StrokeShape="RoundRectangle 16"
                                BackgroundColor="{AppThemeBinding Light=#EFEAFF, Dark=#2A214F}"
                                WidthRequest="40"
                                HeightRequest="40"
                                VerticalOptions="Start">

                            <Image x:Name="HelpIcon"
                                   WidthRequest="22"
                                   HeightRequest="22"
                                   HorizontalOptions="Center"
                                   VerticalOptions="Center">
                                <Image.Source>
                                    <FontImageSource FontFamily="MaterialIcons"
                                                     Glyph="&#xE8FD;"
                                                     Size="22"
                                                     Color="{AppThemeBinding Light=#7A63FF, Dark=White}" />
                                </Image.Source>
                            </Image>
                        </Border>

                        <VerticalStackLayout Grid.Column="1"
                                             Spacing="3"
                                             VerticalOptions="Center">

                            <Label Text="Help &amp; Support"
                                   FontSize="16"
                                   FontAttributes="Bold"
                                   TextColor="{AppThemeBinding Light=#221551, Dark=White}" />

                            <Label Text="Help center, contact support, and policies"
                                   FontSize="12"
                                   MaxLines="2"
                                   LineBreakMode="WordWrap"
                                   TextColor="{AppThemeBinding Light=#8A869E, Dark=#B7B3C6}" />

                        </VerticalStackLayout>

                        <Image x:Name="HelpChevron"
                               Grid.Column="2"
                               WidthRequest="18"
                               HeightRequest="18"
                               HorizontalOptions="End"
                               VerticalOptions="Center"
                               Opacity="0.65">

                            <Image.Source>
                                <FontImageSource FontFamily="MaterialIcons"
                                                 Glyph="&#xE5CC;"
                                                 Size="18"
                                                 Color="{AppThemeBinding Light=#C7C3D6, Dark=#8A869E}" />
                            </Image.Source>
                        </Image>

                    </Grid>

                    <Grid.GestureRecognizers>
                        <TapGestureRecognizer Tapped="OnHelpTapped"/>
                    </Grid.GestureRecognizers>

                </Grid>

            </VerticalStackLayout>

        </Border>

        <!-- Footer -->
        <Label x:Name="FooterLabel"
               Grid.Row="7"
               Text="Version 1.04"
               FontSize="12"
               HorizontalTextAlignment="Center"
               VerticalOptions="End"
               Margin="0,18,0,8"
               TextColor="{AppThemeBinding Light=#AAA6B9, Dark=#7F7A90}"
               Opacity="0"/>

    </Grid>
</ContentPage>