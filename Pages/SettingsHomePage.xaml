<?xml version="1.0" encoding="utf-8" ?>
<ContentPage
    xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
    xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
    xmlns:shell="http://schemas.microsoft.com/dotnet/2021/maui"
    x:Class="E_Book.Pages.SettingsHomePage"
    shell:Shell.NavBarIsVisible="False"
    BackgroundColor="{AppThemeBinding Light={StaticResource PageBackground}, Dark={StaticResource OffBlack}}">

    <Grid Padding="24,18"
          RowDefinitions="Auto,*,Auto">

        <!-- Header -->
        <VerticalStackLayout Grid.Row="0"
                             Spacing="4"
                             Margin="0,4,0,8">

            <Label x:Name="TitleLabel"
                   Text="Settings"
                   FontFamily="Pacifico"
                   FontSize="34"
                   HorizontalTextAlignment="Center"
                   TextColor="{AppThemeBinding Light={StaticResource PrimaryDarkText}, Dark={StaticResource White}}"
                   Opacity="0"
                   TranslationY="8" />

            <Label x:Name="HeaderSubTitle"
                   Text="Manage your account and app preferences"
                   FontSize="13"
                   HorizontalTextAlignment="Center"
                   TextColor="{AppThemeBinding Light=#8F8AA5, Dark=#A6A1B9}"
                   Opacity="0"
                   TranslationY="8" />
        </VerticalStackLayout>

        <!-- Scrollable content -->
        <ScrollView Grid.Row="1"
                    Margin="0,4,0,0"
                    Orientation="Vertical">

            <VerticalStackLayout Spacing="16"
                                 Padding="0,0,0,16">

                <!-- Profile Card -->
                <Frame x:Name="ProfileCard"
                       BackgroundColor="{AppThemeBinding Light={StaticResource CardBackground}, Dark={StaticResource Gray950}}"
                       CornerRadius="30"
                       Padding="20"
                       HasShadow="True"
                       Margin="0,0,0,0"
                       Opacity="0"
                       TranslationY="14"
                       Scale="0.995">

                    <Frame.Shadow>
                        <Shadow Brush="#18000000"
                                Offset="0,10"
                                Radius="24"
                                Opacity="0.18" />
                    </Frame.Shadow>

                    <VerticalStackLayout Spacing="16">

                        <Grid ColumnDefinitions="64,*,Auto"
                              ColumnSpacing="14">

                            <Frame x:Name="ProfileBubble"
                                   Grid.Column="0"
                                   HeightRequest="64"
                                   WidthRequest="64"
                                   Padding="0"
                                   CornerRadius="22"
                                   HasShadow="False"
                                   BackgroundColor="{AppThemeBinding Light=#EFEAFF, Dark=#2A214F}"
                                   VerticalOptions="Start">
                                <Grid>
                                    <Label x:Name="AvatarLetterLabel"
                                           FontSize="28"
                                           FontAttributes="Bold"
                                           HorizontalTextAlignment="Center"
                                           VerticalTextAlignment="Center"
                                           TextColor="{AppThemeBinding Light=#7A63FF, Dark=White}" />
                                </Grid>
                            </Frame>

                            <VerticalStackLayout Grid.Column="1"
                                                 Spacing="3"
                                                 VerticalOptions="Center">

                                <Label x:Name="NameLabel"
                                       Text="Guest"
                                       FontSize="20"
                                       FontAttributes="Bold"
                                       LineBreakMode="TailTruncation"
                                       MaxLines="1"
                                       TextColor="{AppThemeBinding Light={StaticResource PrimaryDarkText}, Dark={StaticResource White}}" />

                                <Label x:Name="EmailLabel"
                                       Text="Guest account"
                                       FontSize="13"
                                       LineBreakMode="TailTruncation"
                                       MaxLines="1"
                                       TextColor="{AppThemeBinding Light=#8A869E, Dark=#B7B3C6}" />

                                <Frame Padding="8,3"
                                       CornerRadius="8"
                                       HasShadow="False"
                                       HorizontalOptions="Start"
                                       BackgroundColor="{AppThemeBinding Light=#F4F1FF, Dark=#2A2340}">
                                    <HorizontalStackLayout Spacing="5">
                                        <Label Text="●"
                                               FontSize="8"
                                               VerticalOptions="Center"
                                               TextColor="{AppThemeBinding Light=#7A63FF, Dark=White}" />
                                        <Label Text="Account profile"
                                               FontSize="11"
                                               FontAttributes="Bold"
                                               VerticalOptions="Center"
                                               TextColor="{AppThemeBinding Light=#6F5CE7, Dark=White}" />
                                    </HorizontalStackLayout>
                                </Frame>
                            </VerticalStackLayout>

                            <Frame Grid.Column="2"
                                   HeightRequest="34"
                                   WidthRequest="34"
                                   Padding="0"
                                   CornerRadius="17"
                                   HasShadow="False"
                                   BackgroundColor="{AppThemeBinding Light=#F7F4FF, Dark=#262632}"
                                   VerticalOptions="Start"
                                   HorizontalOptions="End">
                                <Image WidthRequest="16"
                                       HeightRequest="16"
                                       HorizontalOptions="Center"
                                       VerticalOptions="Center"
                                       Opacity="0.75">
                                    <Image.Source>
                                        <FontImageSource FontFamily="MaterialIcons"
                                                         Glyph="&#xE5CC;"
                                                         Size="16"
                                                         Color="{AppThemeBinding Light=#8E88A6, Dark=#C8C1E3}" />
                                    </Image.Source>
                                </Image>
                            </Frame>
                        </Grid>

                        <BoxView HeightRequest="1"
                                 Opacity="0.05"
                                 BackgroundColor="{AppThemeBinding Light=#6E6688, Dark=#FFFFFF}" />

                        <Grid ColumnDefinitions="*,Auto"
                              VerticalOptions="Center">

                            <VerticalStackLayout Spacing="1"
                                                 VerticalOptions="Center">
                                <Label Text="Profile settings"
                                       FontSize="13"
                                       FontAttributes="Bold"
                                       TextColor="{AppThemeBinding Light=#6D69A5, Dark=#D7D2EA}" />
                                <Label Text="Update your name and account details"
                                       FontSize="11.5"
                                       TextColor="{AppThemeBinding Light=#9A96AC, Dark=#A8A3BA}" />
                            </VerticalStackLayout>

                            <Button x:Name="EditProfileButton"
                                    Grid.Column="1"
                                    Text="Edit Profile"
                                    Clicked="OnEditProfileClicked"
                                    Padding="18,8"
                                    HeightRequest="42"
                                    MinimumWidthRequest="136"
                                    CornerRadius="18"
                                    BackgroundColor="{AppThemeBinding Light=#F1EBFF, Dark=#2A214F}"
                                    TextColor="{AppThemeBinding Light={StaticResource PrimaryDarkText}, Dark={StaticResource White}}"
                                    FontAttributes="Bold"
                                    FontSize="13"
                                    HorizontalOptions="End" />
                        </Grid>

                    </VerticalStackLayout>
                </Frame>

                <!-- Menu Card -->
                <Frame x:Name="MenuCard"
                       BackgroundColor="{AppThemeBinding Light={StaticResource CardBackground}, Dark={StaticResource Gray950}}"
                       CornerRadius="30"
                       Padding="0"
                       HasShadow="True"
                       Opacity="0"
                       TranslationY="14"
                       Scale="0.995">

                    <Frame.Shadow>
                        <Shadow Brush="#18000000"
                                Offset="0,10"
                                Radius="24"
                                Opacity="0.18" />
                    </Frame.Shadow>

                    <VerticalStackLayout Spacing="0">

                        <Grid Padding="18,14,18,10">
                            <Label x:Name="SectionLabel"
                                   Text="Preferences"
                                   FontSize="13"
                                   FontAttributes="Bold"
                                   TextColor="{AppThemeBinding Light=#8A869E, Dark=#A9A4BB}"
                                   Opacity="0"
                                   TranslationY="8" />
                        </Grid>

                        <!-- Appearance -->
                        <Grid x:Name="AppearanceRow"
                              Padding="0"
                              BackgroundColor="Transparent"
                              Opacity="0"
                              TranslationY="8">

                            <Border x:Name="AppearanceRipple"
                                    StrokeThickness="0"
                                    StrokeShape="RoundRectangle 22"
                                    BackgroundColor="{AppThemeBinding Light=#EEE9FF, Dark=#2F255F}"
                                    Opacity="0"
                                    Margin="6"
                                    Scale="0.94" />

                            <Grid Padding="18,16"
                                  ColumnDefinitions="48,*,20"
                                  ColumnSpacing="14"
                                  MinimumHeightRequest="88">

                                <Frame x:Name="AppearanceBubble"
                                       Grid.Column="0"
                                       HeightRequest="44"
                                       WidthRequest="44"
                                       Padding="0"
                                       CornerRadius="15"
                                       HasShadow="False"
                                       BackgroundColor="{AppThemeBinding Light=#EFEAFF, Dark=#2A214F}"
                                       VerticalOptions="Center">
                                    <Image WidthRequest="22"
                                           HeightRequest="22"
                                           HorizontalOptions="Center"
                                           VerticalOptions="Center">
                                        <Image.Source>
                                            <FontImageSource FontFamily="MaterialIcons"
                                                             Glyph="&#xE40A;"
                                                             Size="22"
                                                             Color="{AppThemeBinding Light=#7A63FF, Dark=White}" />
                                        </Image.Source>
                                    </Image>
                                </Frame>

                                <VerticalStackLayout Grid.Column="1"
                                                     Spacing="3"
                                                     VerticalOptions="Center">
                                    <Label Text="Appearance"
                                           FontSize="17"
                                           FontAttributes="Bold"
                                           TextColor="{AppThemeBinding Light={StaticResource PrimaryDarkText}, Dark={StaticResource White}}" />
                                    <Label Text="Theme, display, and reading preferences"
                                           FontSize="12.5"
                                           MaxLines="2"
                                           LineBreakMode="WordWrap"
                                           TextColor="{AppThemeBinding Light=#8A869E, Dark=#B7B3C6}" />
                                </VerticalStackLayout>

                                <Image x:Name="AppearanceChevron"
                                       Grid.Column="2"
                                       WidthRequest="18"
                                       HeightRequest="18"
                                       HorizontalOptions="End"
                                       VerticalOptions="Center"
                                       Opacity="0.55">
                                    <Image.Source>
                                        <FontImageSource FontFamily="MaterialIcons"
                                                         Glyph="&#xE5CC;"
                                                         Size="18"
                                                         Color="{AppThemeBinding Light=#C7C3D6, Dark=#8A869E}" />
                                    </Image.Source>
                                </Image>
                            </Grid>

                            <Grid.GestureRecognizers>
                                <TapGestureRecognizer Tapped="OnAppearanceTapped" />
                            </Grid.GestureRecognizers>
                        </Grid>

                        <BoxView HeightRequest="1"
                                 Margin="18,0"
                                 Opacity="0.06"
                                 BackgroundColor="{AppThemeBinding Light=#6E6688, Dark=#FFFFFF}" />

                        <!-- Help -->
                        <Grid x:Name="HelpRow"
                              Padding="0"
                              BackgroundColor="Transparent"
                              Opacity="0"
                              TranslationY="8">

                            <Border x:Name="HelpRipple"
                                    StrokeThickness="0"
                                    StrokeShape="RoundRectangle 22"
                                    BackgroundColor="{AppThemeBinding Light=#EEE9FF, Dark=#2F255F}"
                                    Opacity="0"
                                    Margin="6"
                                    Scale="0.94" />

                            <Grid Padding="18,16"
                                  ColumnDefinitions="48,*,20"
                                  ColumnSpacing="14"
                                  MinimumHeightRequest="88">

                                <Frame x:Name="HelpBubble"
                                       Grid.Column="0"
                                       HeightRequest="44"
                                       WidthRequest="44"
                                       Padding="0"
                                       CornerRadius="15"
                                       HasShadow="False"
                                       BackgroundColor="{AppThemeBinding Light=#EFEAFF, Dark=#2A214F}"
                                       VerticalOptions="Center">
                                    <Image WidthRequest="22"
                                           HeightRequest="22"
                                           HorizontalOptions="Center"
                                           VerticalOptions="Center">
                                        <Image.Source>
                                            <FontImageSource FontFamily="MaterialIcons"
                                                             Glyph="&#xE8FD;"
                                                             Size="22"
                                                             Color="{AppThemeBinding Light=#7A63FF, Dark=White}" />
                                        </Image.Source>
                                    </Image>
                                </Frame>

                                <VerticalStackLayout Grid.Column="1"
                                                     Spacing="3"
                                                     VerticalOptions="Center">
                                    <Label Text="Help &amp; Support"
                                           FontSize="17"
                                           FontAttributes="Bold"
                                           TextColor="{AppThemeBinding Light={StaticResource PrimaryDarkText}, Dark={StaticResource White}}" />
                                    <Label Text="Help center, contact support, and policies"
                                           FontSize="12.5"
                                           MaxLines="2"
                                           LineBreakMode="WordWrap"
                                           TextColor="{AppThemeBinding Light=#8A869E, Dark=#B7B3C6}" />
                                </VerticalStackLayout>

                                <Image x:Name="HelpChevron"
                                       Grid.Column="2"
                                       WidthRequest="18"
                                       HeightRequest="18"
                                       HorizontalOptions="End"
                                       VerticalOptions="Center"
                                       Opacity="0.55">
                                    <Image.Source>
                                        <FontImageSource FontFamily="MaterialIcons"
                                                         Glyph="&#xE5CC;"
                                                         Size="18"
                                                         Color="{AppThemeBinding Light=#C7C3D6, Dark=#8A869E}" />
                                    </Image.Source>
                                </Image>
                            </Grid>

                            <Grid.GestureRecognizers>
                                <TapGestureRecognizer Tapped="OnHelpTapped" />
                            </Grid.GestureRecognizers>
                        </Grid>

                        <BoxView HeightRequest="1"
                                 Margin="18,0"
                                 Opacity="0.06"
                                 BackgroundColor="{AppThemeBinding Light=#6E6688, Dark=#FFFFFF}" />

                        <!-- Notifications -->
                        <Grid x:Name="NotificationsRow"
                              Padding="0"
                              BackgroundColor="Transparent"
                              Opacity="0"
                              TranslationY="8">

                            <Border x:Name="NotificationsRipple"
                                    StrokeThickness="0"
                                    StrokeShape="RoundRectangle 22"
                                    BackgroundColor="{AppThemeBinding Light=#EEE9FF, Dark=#2F255F}"
                                    Opacity="0"
                                    Margin="6"
                                    Scale="0.94" />

                            <Grid Padding="18,16"
                                  ColumnDefinitions="48,*,20"
                                  ColumnSpacing="14"
                                  MinimumHeightRequest="88">

                                <Frame x:Name="NotificationsBubble"
                                       Grid.Column="0"
                                       HeightRequest="44"
                                       WidthRequest="44"
                                       Padding="0"
                                       CornerRadius="15"
                                       HasShadow="False"
                                       BackgroundColor="{AppThemeBinding Light=#EFEAFF, Dark=#2A214F}"
                                       VerticalOptions="Center">
                                    <Image WidthRequest="22"
                                           HeightRequest="22"
                                           HorizontalOptions="Center"
                                           VerticalOptions="Center">
                                        <Image.Source>
                                            <FontImageSource FontFamily="MaterialIcons"
                                                             Glyph="&#xE7F4;"
                                                             Size="22"
                                                             Color="{AppThemeBinding Light=#7A63FF, Dark=White}" />
                                        </Image.Source>
                                    </Image>
                                </Frame>

                                <VerticalStackLayout Grid.Column="1"
                                                     Spacing="3"
                                                     VerticalOptions="Center">
                                    <Label Text="Notifications"
                                           FontSize="17"
                                           FontAttributes="Bold"
                                           TextColor="{AppThemeBinding Light={StaticResource PrimaryDarkText}, Dark={StaticResource White}}" />
                                    <Label Text="Reading reminders and import alerts"
                                           FontSize="12.5"
                                           MaxLines="2"
                                           LineBreakMode="WordWrap"
                                           TextColor="{AppThemeBinding Light=#8A869E, Dark=#B7B3C6}" />
                                </VerticalStackLayout>

                                <Image x:Name="NotificationsChevron"
                                       Grid.Column="2"
                                       WidthRequest="18"
                                       HeightRequest="18"
                                       HorizontalOptions="End"
                                       VerticalOptions="Center"
                                       Opacity="0.55">
                                    <Image.Source>
                                        <FontImageSource FontFamily="MaterialIcons"
                                                         Glyph="&#xE5CC;"
                                                         Size="18"
                                                         Color="{AppThemeBinding Light=#C7C3D6, Dark=#8A869E}" />
                                    </Image.Source>
                                </Image>
                            </Grid>

                            <Grid.GestureRecognizers>
                                <TapGestureRecognizer Tapped="OnNotificationsTapped" />
                            </Grid.GestureRecognizers>
                        </Grid>

                    </VerticalStackLayout>
                </Frame>

            </VerticalStackLayout>
        </ScrollView>

        <!-- Fixed footer -->
        <Label x:Name="FooterLabel"
               Grid.Row="2"
               Text="Version 1.10"
               FontSize="12"
               HorizontalTextAlignment="Center"
               VerticalOptions="End"
               Margin="0,8,0,4"
               TextColor="{AppThemeBinding Light=#AAA6B9, Dark=#7F7A90}"
               Opacity="0" />

    </Grid>
</ContentPage>