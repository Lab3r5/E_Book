<?xml version="1.0" encoding="utf-8" ?>
<ContentView
    xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
    xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
    x:Class="E_Book.Controls.AppHeader"
    Padding="0">

    <Grid RowDefinitions="10,56">

        <!-- Brand gradient strip -->
        <Grid Grid.Row="0">
            <Grid.Background>
                <LinearGradientBrush StartPoint="0,0" EndPoint="1,0">
                    <GradientStop Color="#7A63FF" Offset="0" />
                    <GradientStop Color="#221551" Offset="1" />
                </LinearGradientBrush>
            </Grid.Background>
        </Grid>

        <!-- Top Bar -->
        <Grid Grid.Row="1"
              ColumnDefinitions="56,*,56"
              Padding="12,8"
              BackgroundColor="Transparent">

            <!-- Back button -->
            <Border x:Name="BackContainer"
                    Grid.Column="0"
                    WidthRequest="44"
                    HeightRequest="44"
                    StrokeThickness="0"
                    BackgroundColor="{AppThemeBinding Light=#EDE7FF, Dark=#2A214F}"
                    StrokeShape="RoundRectangle 22"
                    HorizontalOptions="Start"
                    VerticalOptions="Center">

                <Label x:Name="BackTapTarget"
                       Text="‹"
                       FontSize="28"
                       FontAttributes="Bold"
                       TextColor="{AppThemeBinding Light=#221551, Dark=White}"
                       HorizontalTextAlignment="Center"
                       VerticalTextAlignment="Center">
                    <Label.GestureRecognizers>
                        <TapGestureRecognizer Tapped="OnBackTapped" />
                    </Label.GestureRecognizers>
                </Label>
            </Border>

            <!-- Center title -->
            <Label x:Name="TitleLabel"
                   Grid.Column="1"
                   Text="Title"
                   FontSize="20"
                   FontAttributes="Bold"
                   HorizontalOptions="Center"
                   HorizontalTextAlignment="Center"
                   VerticalOptions="Center"
                   TextColor="{AppThemeBinding Light=#221551, Dark=White}" />

            <!-- Right slot (optional) -->
            <ContentView x:Name="RightSlot"
                         Grid.Column="2"
                         WidthRequest="44"
                         HeightRequest="44"
                         HorizontalOptions="End"
                         VerticalOptions="Center" />
        </Grid>

    </Grid>
</ContentView>